#version 330

layout(std140) uniform SamplerInfo {
    vec2 OutSize;
    vec2 InSize;
};
layout(std140) uniform ZenithPost {
    float NearPlane;
    float FarPlane;
    float WetAmount;
    float DarkAmount;
    vec4 WetTint4;
    float ReflectAmount;
    float PuddleAmount;
    float GlintAmount;
    float Frost;
    float TerrainValid;
    float SnowGeometry;
    float FadeEnd;
    float CoverRadius;
    float time;
    vec4 CameraPosition4;
    float SkyPitch;
    float SkyYaw;
    float TanHalfFov;
    float Aspect;
    vec4 SkyZenith4;
    vec4 SkyHorizon4;
    vec4 SkyNadir4;
    vec4 SunDir4;
    vec4 SunColor4;
    float SunSize;
    float SunGlare;
    float CloudCover;
    float CloudDark;
    float CloudSpeed;
    float CloudScale;
    vec4 CloudLit4;
    vec4 CloudShadow4;
    float StarAmount;
    float BandAmount;
    float AuroraAmount;
    float MeteorAmount;
    float HazeAmount;
    float FrostAmount;
    vec4 HazeColor4;
    vec4 GlowDir4;
    float GlowFocus;
    float Flash;
    vec4 FlashColor4;
};
// vec3 в std140 трактуется драйверами по-разному: тут он хранится как vec4,
// а имя остаётся прежним, чтобы не трогать тела шейдеров.
#define WetTint WetTint4.xyz
#define CameraPosition CameraPosition4.xyz
#define SkyZenith SkyZenith4.xyz
#define SkyHorizon SkyHorizon4.xyz
#define SkyNadir SkyNadir4.xyz
#define SunDir SunDir4.xyz
#define SunColor SunColor4.xyz
#define CloudLit CloudLit4.xyz
#define CloudShadow CloudShadow4.xyz
#define HazeColor HazeColor4.xyz
#define GlowDir GlowDir4.xyz
#define FlashColor FlashColor4.xyz


// Извлечение глянца погоды. Первый из трёх проходов: этот считает, где и сколько мокрого,
// два следующих размывают результат и накладывают его на кадр.
//
// Разбито так из-за пикселей. Нормаль и Френель восстанавливаются из буфера глубины, а глубина
// вдали квантована: соседние пиксели одной грани получают чуть разные нормали, и попиксельный
// блеск на дальних склонах рассыпается в мерцающую крупу. Лечится это не порогами (они сами
// зернят по своей границе), а природой мокрого блеска: у воды на шершавом камне отражение
// мягкое, размытое микрорельефом. Поэтому свет считается в свой буфер и дальше честно
// размывается гауссом — крупа усредняется в ровное сияние, каким мокрый блеск и выглядит.
//
// Выход premultiplied: rgb — добавленный свет, a — сколько исходного цвета погасить.
// Комбинирующий проход делает color * (1 - a) + rgb: одной формулой и потемнение мокрого, и
// блеск, и снежный покров.

// Небо погоды: блеск на мокром — это отражённое небо, и цвет у него небесный. Держать вместо
// него постоянную нельзя: тогда мокрая земля светится одинаково в полдень и в полночь, а
// ночью это единственное светлое пятно в кадре — блики читаются налипшим на блоки мусором.
#moj_import <zenith:weather_sky_color.glsl>

// В этот проход глубина кадра приходит первым сэмплером — цвет кадра ему не нужен вовсе.
uniform sampler2D InSampler;
// Снимок глубины до сущностей: по нему снег отличает землю от живого.
uniform sampler2D TerrainDepthSampler;

// Сила эффекта 0..1, уже перемноженная на силу погоды.
// Сколько гасить исходный цвет: мокрое темнее сухого.
// Отражение неба (по Френелю) и блик светила.
// Сколько влаги собрано в лужи: 1 — отдельные лужи, 0 — сплошная плёнка на всех верхних
// гранях. Отражение есть и там, и там — меняется только площадь воды и её шершавость.
// 1 — снег: вместо потемнения и зеркала — белый покров по верхним граням.

// Глубина кадра без существ. По ней экранный снег отличает местность от всего живого: если
// пиксель ближе, чем был ландшафт, значит перед ландшафтом кто-то стоит, и снегом его не красят.
// Дальше этого глянец сходит на нет: там всё равно туман, а глубина дрожит квантованием.

in vec2 texCoord;
in vec2 oneTexel;

out vec4 fragColor;

// Синусы углов камеры — один раз на пиксель в начале main. toWorld зовётся до одиннадцати раз
// (точка, два соседа, восемь проб заслона), и четыре тригонометрии на каждый вызов ничего не
// давали: углы одни на весь кадр.
float camPitchCos;
float camPitchSin;
float camYawCos;
float camYawSin;

vec3 toWorld(vec3 viewVector) {
    vec3 pitched = vec3(
            viewVector.x,
            viewVector.y * camPitchCos + viewVector.z * camPitchSin,
            viewVector.z * camPitchCos - viewVector.y * camPitchSin
    );
    return vec3(
            pitched.x * camYawCos + pitched.z * camYawSin,
            pitched.y,
            pitched.z * camYawCos - pitched.x * camYawSin
    );
}

// Расстояние вдоль взгляда из значения буфера глубины (обычная, не reversed-z).
float linearDepth(float depth) {
    float ndc = depth * 2.0 - 1.0;
    return 2.0 * NearPlane * FarPlane / (FarPlane + NearPlane - ndc * (FarPlane - NearPlane));
}

// Приближение Шлика для воды: под прямым взглядом отражения почти нет, к скользящему углу —
// зеркало. Этот перепад глаз и читает как влагу.
/** Точка кадра в системе мира относительно камеры по экранной координате. */
vec3 viewOffsetAt(vec2 uv, float depth) {
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 ray = vec3(ndc.x * Aspect * TanHalfFov, ndc.y * TanHalfFov, -1.0);
    return toWorld(ray * linearDepth(depth));
}

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

/**
 * Поле толщины снега в блоках. Один в один с {@code SnowFx}: те же две частоты и те же веса —
 * тогда дюны экранного прохода продолжают дюны геометрии, а не спорят с ними.
 */
const float SNOW_DUNE_DEPTH = 0.11;
/** Во сколько раз преувеличен наклон дюны при освещении; смещения геометрии это не касается. */
const float SNOW_BUMP = 3.4;

float snowDune(vec2 world) {
    // Почти вся амплитуда — в длинной волне. Настоящее поле гладкое: рельеф на нём — это
    // редкие пологие перемёты в несколько метров, а не ковёр из бугров. Вторая октава дана
    // еле-еле, только чтобы длинная волна не читалась синусоидой.
    return (valueNoise2(world * 0.09) * 0.85 + valueNoise2(world * 0.31) * 0.15) * SNOW_DUNE_DEPTH;
}

/**
 * Микрорельеф: рябь в четверть блока, которую на снег наносит ветер. Отдельным полем, а не
 * третьей октавой дюн: ей нужен свой, куда более крутой наклон, и она гаснет с расстоянием —
 * дюны остаются до края тумана, рябь живёт только там, где её видно.
 */
float snowMicro(vec2 world) {
    return valueNoise2(world * 2.9 + 47.3) * 0.55 + valueNoise2(world * 6.1 + 11.9) * 0.45;
}

float fresnel(float cosTheta) {
    float base = 1.0 - clamp(cosTheta, 0.0, 1.0);
    float square = base * base;
    return 0.02 + 0.98 * square * square * base;
}

void main() {
    float depth = texture(InSampler, texCoord).r;

    // Небо: глубина не записана, мочить нечего.
    if (depth >= 0.999999 || WetAmount <= 0.001) {
        fragColor = vec4(0.0);
        return;
    }

    camPitchCos = cos(SkyPitch);
    camPitchSin = sin(SkyPitch);
    camYawCos = cos(SkyYaw);
    camYawSin = sin(SkyYaw);

    vec2 ndc = texCoord * 2.0 - 1.0;
    vec3 ray = vec3(ndc.x * Aspect * TanHalfFov, ndc.y * TanHalfFov, -1.0);
    float viewZ = linearDepth(depth);

    // Точка в мире относительно камеры и направление взгляда на неё.
    vec3 offset = toWorld(ray * viewZ);
    vec3 viewDir = normalize(offset);
    vec3 worldPos = CameraPosition + offset;

    // Нормаль строится по четырём соседям, а не производными. dFdx и dFdy считаются один раз
    // на квадрат два на два пикселя: нормаль в таком квадрате одна на всех, и по всей границе
    // грани она скачет ступенькой — отсюда и пунктир из светлых точек по краям блоков, тем
    // заметнее, чем дальше блок. Соседи дают свою нормаль каждому пикселю.
    //
    // Из двух соседей по оси берётся ближний по глубине: у края грани дальний сосед лежит уже
    // на другой поверхности, и нормаль, построенная через него, смотрит вбок.
    float depthLeft = texture(InSampler, texCoord - vec2(oneTexel.x, 0.0)).r;
    float depthRight = texture(InSampler, texCoord + vec2(oneTexel.x, 0.0)).r;
    float depthDown = texture(InSampler, texCoord - vec2(0.0, oneTexel.y)).r;
    float depthUp = texture(InSampler, texCoord + vec2(0.0, oneTexel.y)).r;

    float zLeft = linearDepth(depthLeft);
    float zRight = linearDepth(depthRight);
    float zDown = linearDepth(depthDown);
    float zUp = linearDepth(depthUp);

    vec3 alongX = abs(zRight - viewZ) < abs(viewZ - zLeft)
            ? viewOffsetAt(texCoord + vec2(oneTexel.x, 0.0), depthRight) - offset
            : offset - viewOffsetAt(texCoord - vec2(oneTexel.x, 0.0), depthLeft);
    vec3 alongY = abs(zUp - viewZ) < abs(viewZ - zDown)
            ? viewOffsetAt(texCoord + vec2(0.0, oneTexel.y), depthUp) - offset
            : offset - viewOffsetAt(texCoord - vec2(0.0, oneTexel.y), depthDown);

    vec3 normal = cross(alongX, alongY);
    float normalLength = length(normal);
    if (normalLength < 1.0e-9) {
        fragColor = vec4(0.0);
        return;
    }
    normal /= normalLength;
    normal *= -sign(dot(normal, viewDir));

    // Кромка ищется по второй разности глубины, а не по первой. Первая велика у любой
    // наклонной поверхности — под скользящим взглядом вся дальняя земля считалась кромкой и
    // выпадала из эффекта. Вторая у плоскости равна нулю независимо от наклона и подскакивает
    // только там, где поверхность действительно обрывается: ровно на силуэтах.
    float curvature = abs(zLeft + zRight - 2.0 * viewZ) + abs(zDown + zUp - 2.0 * viewZ);
    float edgeMask = 1.0 - smoothstep(viewZ * 0.006, viewZ * 0.030, curvature);

    // Трава, листва, цепи: поверхность рвётся на каждом шагу, и воде на ней не удержаться.
    float flatness = 1.0 - smoothstep(0.35, 1.10, length(alongX) + length(alongY));

    // Спад к дальней границе. Раньше он начинался с трети дистанции, и мокрое кончалось
    // кольцом вокруг игрока — кольцо ехало следом и было видно как движущаяся граница. Теперь
    // мокро везде, докуда достаёт эффект, а гаснет он у самого края, где и так уже туман.
    float distanceMask = 1.0 - smoothstep(FadeEnd * 0.5, FadeEnd, viewZ);

    // Разряд гасит мокрое на сорок процентов. Небо в этот миг светлее земли на порядок, и
    // отражение вместе с ним подскакивает так, что земля перебивает саму вспышку — смотришь на
    // молнию, а вспыхивает под ногами. Приглушая воду на время разряда, возвращаем главное
    // событие кадра небу.
    float amount = WetAmount * edgeMask * flatness * distanceMask * (1.0 - 0.40 * Flash);
    if (amount <= 0.002) {
        fragColor = vec4(0.0);
        return;
    }

    float upness = clamp(normal.y, 0.0, 1.0);

    if (Frost > 0.5) {
        // ------------------------------------------------------------------------------
        // Снег. Покров вблизи кладёт геометрия (SnowFx), а этот проход — везде, куда
        // достаёт кадр: у него нет ни радиуса, ни счёта колонок, он работает по буферу
        // глубины. Поэтому здесь та же световая модель, что у геометрии, и то же поле
        // дюн — иначе за границей геометрии начинался бы другой снег, а не тот же.
        // ------------------------------------------------------------------------------

        // 1. Куда ложится. Снег держится на том, что смотрит вверх, и сходит на нет к
        //    сорока пяти градусам — дальше он просто съезжает. На отвесной стене остаётся
        //    изморозь, а не покров: это разные вещи и по количеству, и по виду.
        float coverFade = CoverRadius > 0.5
                ? smoothstep(CoverRadius * 0.70, CoverRadius, viewZ)
                : 1.0;
        float onTerrain = 1.0;
        if (TerrainValid > 0.5) {
            float terrainRaw = texture(TerrainDepthSampler, texCoord).r;
            float terrainViewZ = terrainRaw >= 0.999999 ? FarPlane : linearDepth(terrainRaw);
            float gap = terrainViewZ - viewZ;
            onTerrain = 1.0 - smoothstep(0.04 + viewZ * 0.012, 0.12 + viewZ * 0.030, gap);
        }

        // Вдали нормаль и высота восстанавливаются из квантованной глубины и дрожат от
        // пикселя к пикселю. Пороговое решение на таких величинах даёт пунктир по кромкам,
        // поэтому с дистанцией пороги расходятся: решение становится плавным и дрожание
        // растворяется в градиенте вместо того, чтобы щёлкать между да и нет.
        float blur = smoothstep(18.0, 55.0, viewZ);
        float layLow = mix(0.22, -0.35, blur);
        float layHigh = mix(0.72, 1.25, blur);
        float upFactor = smoothstep(layLow, layHigh, upness);

        float lay = upFactor * coverFade * onTerrain;
        // Изморозь на отвесном. Девять процентов — это след, которого на стволе и на кусте
        // не разглядеть; в снегопад же обмерзает всё, что стоит вертикально, и белым в лесу
        // становится не только пол. Полная доля покрова сюда не годится: на стене снег не
        // лежит, он к ней примерзает.
        float rime = 0.34 * (1.0 - upFactor) * coverFade * onTerrain;

        // Снег лежит на верхних гранях БЛОКОВ, а они всегда на целой высоте (полублоки — на
        // половинной). Всё, что смотрит вверх на другой высоте, — не блок: спина овцы, голова
        // игрока, поверхность воды (она на 15/16). Из буфера глубины материал не достать, но
        // высота — достаточный паспорт: по ней снег и не ложится на живое и на воду.
        // Допуск берётся из фактического дрожания восстановленной высоты между соседними
        // пикселями: на ровной верхней грани оно и есть погрешность глубины. Дальше сорока
        // блоков проверка снимается совсем — там живое от местности отличает глубина без
        // существ, а высота уже ничего не значит.
        float yFract = fract(worldPos.y);
        float gridDist = min(min(yFract, 1.0 - yFract), abs(yFract - 0.5));
        float jitter = clamp(fwidth(worldPos.y), 0.0, 0.5);
        float slack = 0.02 + jitter * 2.0;
        float onBlock = 1.0 - smoothstep(slack, slack + 0.05 + jitter, gridDist);
        onBlock = mix(onBlock, 1.0, smoothstep(22.0, 48.0, viewZ));
        lay *= onBlock;
        rime *= onBlock;

        // Покрова здесь нет — выход тот же ноль, что дал бы cover ниже, но без дюн и восьми
        // проб заслона. Это не редкий случай, а основная масса ближних пикселей: внутри
        // радиуса геометрии (CoverRadius) снег кладёт меш, и coverFade там ровно ноль, а
        // ближние пиксели как раз самые дорогие — у них и заслон, и рябь. Так же выпадают живое
        // (onTerrain) и всё, что стоит не на высоте блока (onBlock).
        if (lay + rime <= 0.0) {
            fragColor = vec4(0.0);
            return;
        }

        // 2. Рельеф. Поле дюн — то же, что у геометрии: те же частоты, та же амплитуда.
        //    Наклон снимается конечными разностями и намеренно преувеличен: настоящая дюна
        //    поднимается на десять сантиметров за три метра, и её честный наклон — один
        //    градус. Слой такой толщины и есть, но освещать его надо так, чтобы рельеф было
        //    видно, иначе поле остаётся ровной белой заливкой.
        // Вдали рельеф разглаживается: дюна мельче пикселя превращается не в дюну, а в
        // лепнину из светлых и тёмных пятен — с высоты полёта это выглядело сломанной кашей.
        float snowDetail = 1.0 - smoothstep(26.0, 58.0, viewZ);
        float slopeX = 0.0;
        float slopeZ = 0.0;
        // Дальше пятидесяти восьми блоков наклон умножается на ноль: четыре выборки дюн (восемь
        // шумов) там не меняли ничего, а это большая часть снежного кадра.
        if (snowDetail > 0.0) {
            float d = 0.5;
            float heightLeft = snowDune(worldPos.xz - vec2(d, 0.0));
            float heightRight = snowDune(worldPos.xz + vec2(d, 0.0));
            float heightDown = snowDune(worldPos.xz - vec2(0.0, d));
            float heightUp = snowDune(worldPos.xz + vec2(0.0, d));
            float bump = SNOW_BUMP * snowDetail;
            slopeX = (heightLeft - heightRight) * bump;
            slopeZ = (heightDown - heightUp) * bump;

            // Рябь от ветра. Вблизи дюны сами по себе — гладкий пластик: между гребнями в
            // несколько блоков глазу не за что зацепиться. Рябь в четверть блока и есть та
            // «текстура», по которой снег узнаётся вблизи; за двадцать блоков она мельче пикселя
            // и честно гаснет раньше, чем начнёт рассыпаться в шум.
            float nearby = (1.0 - smoothstep(6.0, 18.0, viewZ)) * snowDetail;
            if (nearby > 0.001) {
                float md = 0.16;
                // Едва заметная: рябь на снегу видна только под скользящим светом, и когда её
                // видно отчётливо повсюду — это уже не снег, а стёганое одеяло.
                float microBump = 0.38 * nearby;
                slopeX += (snowMicro(worldPos.xz - vec2(md, 0.0)) - snowMicro(worldPos.xz + vec2(md, 0.0))) * microBump;
                slopeZ += (snowMicro(worldPos.xz - vec2(0.0, md)) - snowMicro(worldPos.xz + vec2(0.0, md))) * microBump;
            }
        }

        vec3 duneNormal = normalize(vec3(slopeX, 1.0, slopeZ));
        // На наклонной грани дюна ложится по ней, а не по горизонтали.
        duneNormal = normalize(mix(normal, duneNormal, lay));

        // 3. Свет — так, как снег освещают в играх, где он выглядит снегом, и по тем же
        //    причинам, по которым он так выглядит в жизни:
        //
        //    Альбедо высокое и РОВНОЕ. У снега нет текстуры в смысле пятен цвета — свежий
        //    покров отражает под девяносто процентов света одинаково в каждой точке. Все
        //    прошлые попытки раскрасить его шумом (то по гребням, то зерном) давали серые
        //    разводы, по которым картинка и читалась грязной тканью. Весь рисунок снегу
        //    делает свет: рельеф — наклоном нормали, искры и отсвет — в проходе наложения.
        //
        //    Диффуз завёрнутый (wrap): снег полупрозрачен, свет проникает в толщу и
        //    выходит с теневой стороны, поэтому терминатор у него мягкий, без резкой
        //    границы света и тени. Это стандартная аппроксимация подповерхностного
        //    рассеяния — и именно она даёт снегу его «мягкость».
        //
        //    Двухцветность: освещённое — тёплое от светила, затенённое — синее от неба.
        //    Тень на снегу голубая, потому что в неё светит только небо; это самый узнаваемый
        //    признак настоящего снега, и он получается сам, без подкраски.
        vec3 albedo = vec3(0.955, 0.965, 1.00);
        float wrap = clamp((dot(duneNormal, normalize(SunDir)) + 0.35) / 1.35, 0.0, 1.0);
        vec3 skyAmbient = SkyZenith * 0.55 + SkyHorizon * 0.45;
        // Множитель подобран так, чтобы сумма неба и светила НЕ доходила до единицы. Это не
        // осторожность, а суть: всё, что выше единицы, кадр обрезает, и на обрезанном белом
        // не видно ни рельефа, ни тени — получается лист бумаги. Объём существует только в
        // том запасе яркости, который остался до потолка.
        vec3 ambient = skyAmbient * 0.80 + 0.10;
        float skyView = 0.62 + 0.38 * max(0.0, duneNormal.y);

        // 4. Тень. Ровный белый без тени — бумага: в играх объём снегу даёт именно она.
        //    Карт теней у нас нет, но есть буфер глубины, и по нему считается заслон
        //    неба — восемь проб по кругу, у каждой свой радиус, круг повёрнут шумом,
        //    чтобы восемь направлений не читались узором. У подножия стены, вокруг
        //    ствола, у края ямы пробы находят геометрию над поверхностью — туда небо
        //    не светит, и снег там темнеет и синеет. Это тот же ambient occlusion, что
        //    в любом современном рендере, только посчитанный на единственном проходе,
        //    которому он тут нужен.
        float occlusion = 0.0;
        if (snowDetail > 0.002) {
            float aoRadius = 1.4;
            vec2 uvRadius = aoRadius / (max(viewZ, 1.0) * TanHalfFov) * vec2(0.5 / Aspect, 0.5);
            float spin = hash21(worldPos.xz) * 6.2831;
            float cs = cos(spin), sn = sin(spin);
            for (int i = 0; i < 8; i++) {
                float ang = float(i) * 0.7854;
                vec2 dir = vec2(cos(ang), sin(ang));
                dir = vec2(dir.x * cs - dir.y * sn, dir.x * sn + dir.y * cs);
                float reach = 0.35 + 0.65 * fract(float(i) * 0.618 + spin);
                vec2 uv2 = texCoord + dir * uvRadius * reach;
                float d2 = texture(InSampler, uv2).r;
                if (d2 >= 0.999999) continue;
                vec3 dv = viewOffsetAt(uv2, d2) - offset;
                float dist = length(dv);
                // Заслоняет только то, что поднимается над поверхностью в сторону неба,
                // и тем слабее, чем дальше оно стоит.
                float toward = dot(dv / max(dist, 1.0e-4), normal);
                occlusion += clamp(toward - 0.08, 0.0, 1.0)
                        * clamp(1.0 - dist / (aoRadius * 2.0), 0.0, 1.0);
            }
            occlusion = clamp(occlusion * 0.275, 0.0, 1.0);
        }
        float shade = 1.0 - occlusion * 0.72 * snowDetail;

        // Небо тень гасит целиком, светило — наполовину: контактная тень глубже всего
        // там, где не светит ни то, ни другое, но полностью чёрной на снегу не бывает.
        vec3 snow = albedo * (ambient * skyView * shade + SunColor * wrap * 0.34 * (0.45 + 0.55 * shade));

        // Слой непрозрачен: сквозь снег блока не видно. Потолок чуть ниже единицы не ради
        // вида — между этим проходом и наложением лежит размытие, и полностью непрозрачный
        // слой бледнил бы ореолом всё, что торчит из снега.
        float cover = amount * clamp(lay + rime, 0.0, 1.0) * 0.965;
        fragColor = vec4(snow * cover, cover);
        return;
    }

    // Шум влаги и отражённый луч нужны только воде: снег выше возвращается раньше, и
    // считать для него три шума и отражение было пустой тратой на каждый пиксель покрова.
    // Мокрота неровная, но плавная. Первая версия давала каждому блоку свой множитель хешем
    // от его координат — и в ярком пятне блика соседние блоки различались как плитка: сетка
    // мира проступала прямо сквозь отражение. Плавный шум даёт тот же разброс влаги, но его
    // пятна живут своей формой и на границы блоков не ложатся.
    float perBlock = 0.80 + 0.40 * valueNoise2(worldPos.xz * 0.41 + vec2(13.7, 5.3));
    // Лужи — отдельные пятна в два-три блока, а не сплошная плёнка на весь луг. Разница не в
    // красоте: у сплошной плёнки Френель даёт скользящий угол всегда на одной и той же
    // дистанции, и блестящая полоса едет вместе с камерой — идёшь, а она перед тобой; прыгнул,
    // и она прыгнула. У отдельной лужи блеск ограничен её краями, и лужа остаётся там, где
    // лежит. Формула обязана совпадать с той, что в комбинирующем проходе.
    float patchNoise = valueNoise2(worldPos.xz * 0.34) * 0.60 + valueNoise2(worldPos.xz * 0.87) * 0.40;
    vec3 reflected = reflect(viewDir, normal);

    // Вода. Стены тоже блестят, но слабее: вода на них не стоит, а стекает.
    float faceWeight = mix(0.35, 1.0, upness);
    // Площадь воды. В режиме луж — пятна по шуму, в режиме плёнки — всё, что смотрит вверх.
    float coverage = mix(1.0, smoothstep(0.55, 0.72, patchNoise), PuddleAmount);
    float puddle = coverage * upness;
    float wet = amount * faceWeight * perBlock * (1.0 + puddle * 0.9);

    // 1. Потемнение: вода заполняет поры и гасит рассеянный свет.
    float darken = min(0.66, DarkAmount * wet);

    // 2. Отражение неба по Френелю — в обоих режимах. Попытка сделать блеск неподвижным,
    //    считая его от одной нормали, убрала движение вместе с водой: поверхность переставала
    //    читаться мокрой и становилась просто посветлевшей. Вода отражает по Френелю, и без
    //    этого она не вода.
    // Кривая Френеля поджата так же, как в проходе отражений: иначе отсвет неба на мокром
    // продолжал бы вспыхивать от каждого прыжка, даже когда само зеркало этого уже не делает.
    float skyward = smoothstep(-0.05, 0.45, reflected.y);
    // Порог у поджатой кривой был слишком высок: отражение не падало до нуля даже под
    // ногами, и в сумме с усилением давало ровную светлую простыню на всю землю — она же и
    // тянулась за камерой остатком угловой зависимости. Порог опущен вчетверо: под ногами
    // почти ничего, к горизонту растёт, но без скачка при прыжке.
    float spread = mix(0.72, 0.90, PuddleAmount);
    float sheen = ((1.0 - spread) + spread * fresnel(dot(-viewDir, normal)))
            * skyward * ReflectAmount * mix(0.40, 1.0, PuddleAmount);

    // 3. Цвет блеска — само небо в направлении отражения. Раньше здесь стояла постоянная, и
    //    из-за неё мокрая земля светилась одинаково при любой погоде и в любое время суток:
    //    ночью каждая верхняя грань покрывалась светлой коркой, которая ни на что не
    //    отзывалась. Небо же и тускнеет к ночи, и темнеет под тучей, и вспыхивает от молнии —
    //    само, потому что это то же небо, что над головой.
    // Блеск живёт в лужах, а не размазан по всей мокрой поверхности. Френель зависит от угла
    // взгляда, и ровный слой блеска на всём подряд ехал вместе с головой: куда ни повернись,
    // перед тобой светлая полоса — эффект переставал быть свойством земли и становился
    // свойством камеры. Привязанный к пятнам влаги, он остаётся на своих местах: подошёл
    // ближе — та же лужа блестит там же.
    //
    // Вне луж остаётся пятая часть: мокрый камень всё-таки отсвечивает, просто не зеркалит.
    // Небо в отражении берётся не строго вдоль отражённого луча, а между ним и нормалью
    // грани. Это не упрощение, а то, как ведёт себя шершавая вода: она отражает не луч, а
    // целый конус вокруг него, и чем шершавее — тем шире конус. Небо ровное и низкочастотное,
    // поэтому усреднение по широкому конусу почти не отличается от освещения сверху — то есть
    // от направления нормали. Практический выигрыш тот же, что и физический смысл: облака
    // перестают ездить по земле при каждом шаге, потому что нормаль от шагов не зависит.
    //
    // Резкие отражения — соседние блоки, мобы — этим не задеты: их считает отдельный проход по
    // кадру, и там луч остаётся лучом.
    float sheenAmount = sheen * wet * mix(0.12, 1.0, puddle);
    // Небо стоит дороже всего остального прохода вместе взятого, а на большинстве пикселей его
    // вклад тонет в потемнении. Считаем его только там, где блеск вообще будет виден.
    if (sheenAmount <= 0.002) {
        fragColor = vec4(0.0, 0.0, 0.0, darken);
        return;
    }

    float specularity = mix(0.30, 0.85, PuddleAmount);
    vec3 skyDir = normalize(mix(normal, reflected, specularity));
    vec3 skyColor = weatherSkyReflect(skyDir);
    // Потолок обязателен: мокрое отсвечивает, но не светится. Без него яркое небо на
    // скользящем угле выбеливало землю до бумаги.
    vec3 light = min(WetTint * skyColor * sheenAmount * (0.55 + GlintAmount * 0.25), vec3(0.30));

    fragColor = vec4(light, darken);
}
