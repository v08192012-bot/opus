wardrobe.item.pet_ember_fox = Ember Fox
wardrobe.item.pet_ember_fox.desc = An ember-tipped tail, sneezes sparks and naps when you stand still.
wardrobe.item.back_jetpack_comet = Comet Jetpack
wardrobe.item.back_jetpack_comet.desc = Nozzles ignite when airborne, fins spread out in flight.
wardrobe.item.char_samurai_wanderer = Wandering Samurai
wardrobe.item.char_samurai_wanderer.desc = A straw hat, a blade on the back and sakura petals in the calm.
wardrobe.item.weapon_wanderer_katana = Wanderer's Katana
wardrobe.item.weapon_wanderer_katana.desc = A curved blade with a shining edge. Strikes leave a swirl of petals.
wardrobe.item.pet_mini_dragon = Mini Dragon
wardrobe.item.pet_mini_dragon.desc = Hovers by your shoulder and puffs smoke rings.
wardrobe.item.pet_firefly_spirit = Firefly Spirit
wardrobe.item.pet_firefly_spirit.desc = Glows in the dark and dances with little lights.
wardrobe.item.pet_robot_ball = Robo Ball
wardrobe.item.pet_robot_ball.desc = Bounces after you and scans around with a sparking beam.
wardrobe.item.pet_ghost_cat = Ghost Cat
wardrobe.item.pet_ghost_cat.desc = Translucent, purring and sometimes fading away.
wardrobe.item.pet_crystal_turtle = Crystal Turtle
wardrobe.item.pet_crystal_turtle.desc = Hides in its glowing shell when danger is near.
wardrobe.item.pet_cloud_sheep = Cloud Lamb
wardrobe.item.pet_cloud_sheep.desc = Floats along and sometimes makes a tiny rain.
wardrobe.item.pet_mushroom_buddy = Mushroom Buddy
wardrobe.item.pet_mushroom_buddy.desc = Toddles along and bows, scattering spores.
wardrobe.item.pet_mech_owl = Clockwork Owl
wardrobe.item.pet_mech_owl.desc = A brass owl with lens eyes that spins its head.
wardrobe.item.pet_slime = Slimelet
wardrobe.item.pet_slime.desc = A bouncy blob that sometimes leaps really high.
wardrobe.item.pet_shadow_raven = Shadow Raven
wardrobe.item.pet_shadow_raven.desc = Falls behind, then reappears in a puff of shadow.
wardrobe.item.pet_sea_octopus = Sea Octopus
wardrobe.item.pet_sea_octopus.desc = Blows bubbles and squirts ink when you get hurt.
wardrobe.item.pet_star_bunny = Star Bunny
wardrobe.item.pet_star_bunny.desc = Catches falling stars and leaves a shining trail.
wardrobe.item.pet_golem_pup = Golem Pup
wardrobe.item.pet_golem_pup.desc = A little rune golem that sometimes offers you a flower.
wardrobe.item.pet_pumpkin_lantern = Pumpkin Lantern
wardrobe.item.pet_pumpkin_lantern.desc = Hops along, glows inside and grins spookily.
wardrobe.item.pet_teddy_bear = Teddy Bear
wardrobe.item.pet_teddy_bear.desc = Waddles along, waves a paw and sometimes runs over for a hug.
wardrobe.item.head_gentleman_tophat = Top Hat & Monocle
wardrobe.item.head_gentleman_tophat.desc = A velvet band and a gold monocle on a chain.
wardrobe.item.body_gentleman_tailcoat = Gentleman's Tailcoat
wardrobe.item.body_gentleman_tailcoat.desc = Bow tie, cufflinks and tails that sway as you walk.
wardrobe.item.legs_gentleman_trousers = Pinstripe Trousers & Oxfords
wardrobe.item.legs_gentleman_trousers.desc = Wool trousers and brightly polished shoes.
wardrobe.item.back_gentleman_umbrella = Cane Umbrella
wardrobe.item.back_gentleman_umbrella.desc = A folded umbrella with a golden handle on your back.
wardrobe.item.head_cyber_visor = Cyber Visor
wardrobe.item.head_cyber_visor.desc = A neon visor with ear pods and an antenna.
wardrobe.item.body_cyber_jacket = Neon Jacket
wardrobe.item.body_cyber_jacket.desc = Leather, armor plates and glowing seams.
wardrobe.item.legs_cyber_pants = Techwear Pants
wardrobe.item.legs_cyber_pants.desc = Straps, glowing knee pads and neon soles.
wardrobe.item.back_cyber_pack = Holo Pack
wardrobe.item.back_cyber_pack.desc = A hologram spins above the shoulder, the screen flickers.
wardrobe.item.head_knight_helm = Knight's Great Helm
wardrobe.item.head_knight_helm.desc = A great helm with a golden crest and a red plume.
wardrobe.item.body_knight_armor = Crusader Plate
wardrobe.item.body_knight_armor.desc = Cuirass, pauldrons and a surcoat that sways.
wardrobe.item.legs_knight_greaves = Greaves & Sabatons
wardrobe.item.legs_knight_greaves.desc = Chainmail on the thighs and steel greaves.
wardrobe.item.back_knight_shield = Crest Shield
wardrobe.item.back_knight_shield.desc = A heraldic shield strapped to your back.
wardrobe.item.head_pirate_tricorne = Captain's Tricorne
wardrobe.item.head_pirate_tricorne.desc = A skull on the crown and a feather dancing in the wind.
wardrobe.item.body_pirate_coat = Captain's Coat
wardrobe.item.body_pirate_coat.desc = A long crimson coat with gold and wide cuffs.
wardrobe.item.legs_pirate_boots = Sea Boots
wardrobe.item.legs_pirate_boots.desc = Tall cuffed boots with buckles.
wardrobe.item.back_pirate_parrot = Shoulder Parrot
wardrobe.item.back_pirate_parrot.desc = Bobs its head, ruffles feathers and flaps when you jump.
wardrobe.item.head_ninja_hood = Ninja Hood
wardrobe.item.head_ninja_hood.desc = Covers the face but the eyes; band tails flutter.
wardrobe.item.body_ninja_garb = Ninja Garb
wardrobe.item.body_ninja_garb.desc = A dark gi, a sash and a steel shoulder plate.
wardrobe.item.legs_ninja_tabi = Wraps & Tabi
wardrobe.item.legs_ninja_tabi.desc = Bandaged shins and split-toe tabi.
wardrobe.item.back_ninja_blades = Twin Blades
wardrobe.item.back_ninja_blades.desc = Two short swords crossed on your back.
wardrobe.item.head_royal_crown = Royal Crown
wardrobe.item.head_royal_crown.desc = Gold, rubies and ermine. Shimmers with sparkles.
wardrobe.item.head_neon_headphones = Neon Headphones
wardrobe.item.head_neon_headphones.desc = Glowing cups, a mic and notes in the air.
wardrobe.item.head_oni_mask = Oni Mask
wardrobe.item.head_oni_mask.desc = A lacquered demon mask worn to the side.
wardrobe.item.head_wizard_hat = Wizard Hat
wardrobe.item.head_wizard_hat.desc = A starry hat with a bent glowing tip.
wardrobe.item.head_viking_helm = Viking Helm
wardrobe.item.head_viking_helm.desc = An iron helm with a nose guard and curved horns.
wardrobe.item.body_bomber_jacket = Bomber Jacket
wardrobe.item.body_bomber_jacket.desc = A leather jacket with a fur collar and a patch.
wardrobe.item.body_tactical_vest = Tactical Vest
wardrobe.item.body_tactical_vest.desc = A plate carrier with pouches and a signal patch.
wardrobe.item.body_arcane_robe = Archmage Robe
wardrobe.item.body_arcane_robe.desc = A long runed robe whose hem sways as you walk.
wardrobe.item.body_winter_parka = Winter Parka
wardrobe.item.body_winter_parka.desc = A warm fur-trimmed coat with a lowered hood.
wardrobe.item.body_varsity_hoodie = Varsity Hoodie
wardrobe.item.body_varsity_hoodie.desc = A hoodie with drawstrings and a number on the back.
wardrobe.item.legs_cargo_pants = Cargo & Sneakers
wardrobe.item.legs_cargo_pants.desc = Pocketed pants and white sneakers.
wardrobe.item.legs_ripped_jeans = Ripped Jeans
wardrobe.item.legs_ripped_jeans.desc = Jeans with torn knees and high-tops.
wardrobe.item.legs_cowboy_chaps = Chaps & Spurred Boots
wardrobe.item.legs_cowboy_chaps.desc = Leather chaps and cowboy boots with spurs.
wardrobe.item.legs_moon_boots = Moon Boots
wardrobe.item.legs_moon_boots.desc = Spacesuit pants and chunky lit boots.
wardrobe.item.legs_frost_greaves = Frost Greaves
wardrobe.item.legs_frost_greaves.desc = Greaves of eternal ice that shed snow as you walk.
wardrobe.item.back_angel_wings = Angel Wings
wardrobe.item.back_angel_wings.desc = White wings with glowing tips that beat in flight.
wardrobe.item.back_dragon_wings = Dragon Wings
wardrobe.item.back_dragon_wings.desc = Clawed membrane wings that smoulder in the air.
wardrobe.item.back_explorer_pack = Explorer Pack
wardrobe.item.back_explorer_pack.desc = A bedroll, pockets and a lantern that swings.
wardrobe.item.back_hunter_quiver = Hunter's Quiver
wardrobe.item.back_hunter_quiver.desc = A leather quiver full of arrows over the shoulder.
wardrobe.item.char_magical_girl = Magical Girl
wardrobe.item.char_magical_girl.desc = Pink twintails, a frilly skirt and stardust.
wardrobe.item.char_space_hunter = Space Hunter
wardrobe.item.char_space_hunter.desc = Visored armor and an arm cannon that sparks.
wardrobe.item.char_necromancer = Necromancer
wardrobe.item.char_necromancer.desc = A hood, bones and green fire in the eyes.
wardrobe.item.char_cyber_ninja = Cyber Ninja
wardrobe.item.char_cyber_ninja.desc = Neon seams, a light blade on the back, a red scarf.
wardrobe.item.char_pirate_captain = Pirate Captain
wardrobe.item.char_pirate_captain.desc = A beard, an eyepatch and a hook for a hand.
wardrobe.item.char_paladin = Paladin
wardrobe.item.char_paladin.desc = Golden plate, a white cape and a spinning halo.
wardrobe.item.char_vampire_aristocrat = Vampire Aristocrat
wardrobe.item.char_vampire_aristocrat.desc = Pale skin, crimson eyes and a high-collared cape.
wardrobe.item.char_steampunk_mechanic = Steampunk Mechanic
wardrobe.item.char_steampunk_mechanic.desc = Goggles, an apron and a brass arm with a gear.
wardrobe.item.char_forest_elf = Forest Elf
wardrobe.item.char_forest_elf.desc = Pointed ears, long hair and a leafy cloak.
wardrobe.item.char_demon_berserker = Demon Berserker
wardrobe.item.char_demon_berserker.desc = Horns, fur and glowing magma cracks.
wardrobe.item.char_elemental_lord = Elemental Lord
wardrobe.item.char_elemental_lord.desc = Orbs of fire, water, earth and air circle around.
wardrobe.item.char_suit_agent = Suit Agent
wardrobe.item.char_suit_agent.desc = A black suit, shades and an earpiece.
wardrobe.item.char_rock_star = Rock Star
wardrobe.item.char_rock_star.desc = A mohawk, a studded jacket and a guitar on the back.
wardrobe.item.char_mech_pilot = Mech Pilot
wardrobe.item.char_mech_pilot.desc = A flight suit, a visored helmet and a pack.
wardrobe.item.char_ice_witch = Ice Witch
wardrobe.item.char_ice_witch.desc = An ice crown, a long gown and a blizzard around.
wardrobe.item.char_desert_nomad = Desert Nomad
wardrobe.item.char_desert_nomad.desc = A turban, a covered face and a dagger at the belt.
wardrobe.item.char_deep_sea_diver = Deep Sea Diver
wardrobe.item.char_deep_sea_diver.desc = A brass helmet with portholes and air bubbles.
wardrobe.item.char_plague_doctor = Plague Doctor
wardrobe.item.char_plague_doctor.desc = A beaked mask, a hat and ominous spores.
wardrobe.item.char_astronaut = Astronaut
wardrobe.item.char_astronaut.desc = A spacesuit with a gold visor and a blinking panel.
wardrobe.item.char_gladiator = Gladiator
wardrobe.item.char_gladiator.desc = A crested bronze helmet and leather armor.
wardrobe.item.char_druid = Druid
wardrobe.item.char_druid.desc = Antlers, bark and moss with fireflies around.
wardrobe.item.char_clockwork_android = Clockwork Android
wardrobe.item.char_clockwork_android.desc = Steel, brass and a beating glowing heart.
wardrobe.item.char_abyss_knight = Abyss Knight
wardrobe.item.char_abyss_knight.desc = Spiked plate with violet runes and a portal aura.
wardrobe.item.char_shaolin_monk = Shaolin Monk
wardrobe.item.char_shaolin_monk.desc = Orange robes, prayer beads and a meditative stance.
wardrobe.item.weapon_knight_longsword = Crusader Longsword
wardrobe.item.weapon_knight_longsword.desc = A fullered blade with a golden guard. Pairs with the Knight set.
wardrobe.item.weapon_cyber_blade = Plasma Blade
wardrobe.item.weapon_cyber_blade.desc = A flickering plasma beam. Pairs with the Cyberpunk set and Cyber Ninja.
wardrobe.item.weapon_pirate_cutlass = Boarding Cutlass
wardrobe.item.weapon_pirate_cutlass.desc = A broad curved blade with a brass knuckle guard.
wardrobe.item.weapon_frost_brand = Frost Brand
wardrobe.item.weapon_frost_brand.desc = A crystalline sword shedding snowflakes. Pairs with the Ice Witch.
wardrobe.item.weapon_viking_axe = Bearded Axe
wardrobe.item.weapon_viking_axe.desc = A northern axe with a riveted head.
wardrobe.item.weapon_berserker_axe = Berserker Greataxe
wardrobe.item.weapon_berserker_axe.desc = A double head with a molten edge. Pairs with the Demon Berserker.
wardrobe.item.weapon_gear_axe = Gearwork Axe
wardrobe.item.weapon_gear_axe.desc = A brass axe with a glowing core. Pairs with the Mechanic.
wardrobe.item.weapon_elven_hatchet = Elven Hatchet
wardrobe.item.weapon_elven_hatchet.desc = A light hatchet with a leaf-shaped head.
wardrobe.item.weapon_magma_axe = Magma Axe
wardrobe.item.weapon_magma_axe.desc = Cooling lava with a fiery edge that leaves embers.
wardrobe.item.weapon_elven_longbow = Elven Longbow
wardrobe.item.weapon_elven_longbow.desc = Pale wood and a glowing string. Pairs with the Forest Elf.
wardrobe.item.weapon_hunter_recurve = Hunter's Recurve
wardrobe.item.weapon_hunter_recurve.desc = A reliable bow with recurved limbs.
wardrobe.item.weapon_crystal_bow = Crystal Bow
wardrobe.item.weapon_crystal_bow.desc = Clear limbs and a starry arrow trail.
wardrobe.item.weapon_dragon_bow = Dragon Bow
wardrobe.item.weapon_dragon_bow.desc = A spiked dragon bow whose arrows leave flames.
wardrobe.item.weapon_cyber_bow = Neon Bow
wardrobe.item.weapon_cyber_bow.desc = A composite bow with a neon string.
wardrobe.item.weapon_paladin_hammer = Paladin's Hammer
wardrobe.item.weapon_paladin_hammer.desc = A consecrated war hammer. Pairs with the Paladin.
wardrobe.item.weapon_morning_star = Morning Star
wardrobe.item.weapon_morning_star.desc = A spiked head on an oak handle.
wardrobe.item.weapon_crystal_scepter = Crystal Scepter
wardrobe.item.weapon_crystal_scepter.desc = A silver scepter with amethyst facets.
wardrobe.item.weapon_skull_mace = Skull Mace
wardrobe.item.weapon_skull_mace.desc = A skull with green eyes. Pairs with the Necromancer.
wardrobe.item.weapon_storm_maul = Storm Maul
wardrobe.item.weapon_storm_maul.desc = Strikes crackle with lightning.
wardrobe.item.weapon_tidal_trident = Tidal Trident
wardrobe.item.weapon_tidal_trident.desc = A sea trident that scatters spray.
wardrobe.item.weapon_dragon_lance = Dragon Lance
wardrobe.item.weapon_dragon_lance.desc = A dragon bone tip with a fiery vein.
wardrobe.item.weapon_phoenix_spear = Phoenix Spear
wardrobe.item.weapon_phoenix_spear.desc = A blazing feather tip, strikes spit lava.
wardrobe.item.weapon_knight_halberd = Guard Halberd
wardrobe.item.weapon_knight_halberd.desc = An axe, a hook and a spike on one pole.
wardrobe.item.weapon_cyber_pike = Energy Pike
wardrobe.item.weapon_cyber_pike.desc = A carbon shaft and a glowing tip.
wardrobe.item.cape_royal = Royal Mantle
wardrobe.item.cape_royal.desc = Crimson with gold trim and a fur collar.
wardrobe.item.cape_shadow = Shadow Cloak
wardrobe.item.cape_shadow.desc = A ragged hem glows violet as you move.
wardrobe.item.cape_dragon = Dragon Cape
wardrobe.item.cape_dragon.desc = Scaled cloth with a smouldering orange edge.
wardrobe.item.cape_frost = Frost Cloak
wardrobe.item.cape_frost.desc = Translucent ice with crystals along the edge.
wardrobe.item.cape_phoenix = Phoenix Cape
wardrobe.item.cape_phoenix.desc = Flames instead of cloth, smouldering in flight.
wardrobe.item.cape_galaxy = Galaxy Cape
wardrobe.item.cape_galaxy.desc = A starry night woven into cloth.
wardrobe.item.cape_emerald = Emerald Cape
wardrobe.item.cape_emerald.desc = Deep green with a glowing trim.
wardrobe.item.cape_knight = Knight's Cloak
wardrobe.item.cape_knight.desc = Blue cloth with a red lining and a clasp.
wardrobe.item.cape_vampire = Vampire Cape
wardrobe.item.cape_vampire.desc = Black with a scarlet inside and a high collar.
wardrobe.item.cape_angel = Angel Cape
wardrobe.item.cape_angel.desc = Snow-white cloth with a glowing gold trim.
wardrobe.item.cape_toxic = Toxic Cloak
wardrobe.item.cape_toxic.desc = Ragged cloth glowing toxic green.
wardrobe.item.cape_neon = Neon Cape
wardrobe.item.cape_neon.desc = Dark cloth stitched with neon lines.
wardrobe.item.watch_rolex_submariner = Rolex Submariner
wardrobe.item.watch_rolex_submariner.desc = Oyster steel, black ceramic bezel, luminous markers and a cyclops over the date.
wardrobe.item.watch_rolex_hulk = Rolex Submariner Hulk
wardrobe.item.watch_rolex_hulk.desc = A green sunburst dial and a green ceramic bezel.
wardrobe.item.watch_rolex_gmt_pepsi = Rolex GMT-Master II Pepsi
wardrobe.item.watch_rolex_gmt_pepsi.desc = A red and blue 24-hour bezel, a Jubilee bracelet and a red GMT hand.
wardrobe.item.watch_rolex_daytona = Rolex Daytona
wardrobe.item.watch_rolex_daytona.desc = Yellow gold, three golden chronograph counters and a tachymeter bezel.
wardrobe.item.watch_rolex_day_date = Rolex Day-Date President
wardrobe.item.watch_rolex_day_date.desc = A gold President bracelet, a fluted bezel, day and date windows.
wardrobe.item.watch_rolex_datejust = Rolex Datejust 41
wardrobe.item.watch_rolex_datejust.desc = Steel and gold, a blue sunburst and a fluted gold bezel.
wardrobe.item.watch_patek_nautilus = Patek Philippe Nautilus
wardrobe.item.watch_patek_nautilus.desc = A porthole case, a blue horizontally embossed dial and an integrated bracelet.
wardrobe.item.watch_patek_aquanaut = Patek Philippe Aquanaut
wardrobe.item.watch_patek_aquanaut.desc = A soft octagon, an embossed checkered dial and a Tropical rubber strap.
wardrobe.item.watch_patek_calatrava = Patek Philippe Calatrava
wardrobe.item.watch_patek_calatrava.desc = Rose gold classic, white guilloché and an alligator leather strap.
wardrobe.item.watch_ap_royal_oak = Audemars Piguet Royal Oak
wardrobe.item.watch_ap_royal_oak.desc = An octagonal bezel on eight screws and a blue Grande Tapisserie dial.
wardrobe.item.watch_ap_offshore = Audemars Piguet Royal Oak Offshore
wardrobe.item.watch_ap_offshore.desc = Rose gold, a large Méga Tapisserie, a chronograph and rubber-clad pushers.
wardrobe.item.watch_richard_mille = Richard Mille RM 11
wardrobe.item.watch_richard_mille.desc = A screwed carbon tonneau, an open skeleton movement and a red rubber strap.
wardrobe.item.watch_piaget_polo = Piaget Polo
wardrobe.item.watch_piaget_polo.desc = White gold, a cushion case and a bracelet of polished and brushed gadroons.
wardrobe.item.watch_cartier_santos = Cartier Santos
wardrobe.item.watch_cartier_santos.desc = A square screwed case, Roman numerals, blued hands and a sapphire in the crown.
wardrobe.item.watch_hublot_big_bang = Hublot Big Bang
wardrobe.item.watch_hublot_big_bang.desc = Black ceramic, six H-shaped screws on the bezel and a skeleton dial.
wardrobe.item.neck_gold_cuban = Gold Cuban Link
wardrobe.item.neck_gold_cuban.desc = A heavy cuban chain with a gold medallion.
wardrobe.item.neck_diamond_drop = Diamond Drop
wardrobe.item.neck_diamond_drop.desc = A thin chain with a shining diamond drop.
wardrobe.item.neck_ruby_heart = Ruby Heart
wardrobe.item.neck_ruby_heart.desc = A gold chain with a crimson ruby.
wardrobe.item.neck_pearl_choker = Pearl Choker
wardrobe.item.neck_pearl_choker.desc = A row of pearls close at the throat.
wardrobe.item.neck_cross_silver = Silver Cross
wardrobe.item.neck_cross_silver.desc = A silver chain with a smooth cross.
wardrobe.item.neck_emerald_lux = Emerald Necklace
wardrobe.item.neck_emerald_lux.desc = Gold and a large glowing emerald.
wardrobe.item.neck_fang_tribal = Tribal Fang
wardrobe.item.neck_fang_tribal.desc = A leather cord with a bone fang.
wardrobe.item.neck_amethyst = Amethyst
wardrobe.item.neck_amethyst.desc = Silver and a violet stone.
wardrobe.item.neck_dog_tags = Dog Tags
wardrobe.item.neck_dog_tags.desc = A pair of steel tags on a chain.
wardrobe.item.neck_sapphire_double = Sapphire Double
wardrobe.item.neck_sapphire_double.desc = Two silver strands with a blue stone.
wardrobe.item.neck_gold_coin = Gold Doubloon
wardrobe.item.neck_gold_coin.desc = An old coin on a gold chain.
wardrobe.item.neck_neon_pulse = Neon Pulse
wardrobe.item.neck_neon_pulse.desc = A dark chain with a glowing core.
wardrobe.item.neck_obsidian_shard = Obsidian Shard
wardrobe.item.neck_obsidian_shard.desc = A black shard with a violet glow.
wardrobe.item.neck_choker_velvet = Velvet Choker
wardrobe.item.neck_choker_velvet.desc = A velvet band with a scarlet stone.
wardrobe.item.neck_infinity_gold = Infinity
wardrobe.item.neck_infinity_gold.desc = A double gold chain with a glowing sign.
wardrobe.item.pol_putin = Vladimir Putin
wardrobe.item.pol_putin.desc = A dark suit, grey hair and a maroon tie.
wardrobe.item.pol_zelensky = Volodymyr Zelensky
wardrobe.item.pol_zelensky.desc = An olive military tee and stubble.
wardrobe.item.pol_trump = Donald Trump
wardrobe.item.pol_trump.desc = A blue suit, a long red tie and a tan.
wardrobe.item.pol_obama = Barack Obama
wardrobe.item.pol_obama.desc = A navy suit and an easy smile.
wardrobe.item.pol_lukashenko = Alexander Lukashenko
wardrobe.item.pol_lukashenko.desc = A grey suit, a comb-over and a moustache.
wardrobe.item.pol_medvedev = Dmitry Medvedev
wardrobe.item.pol_medvedev.desc = A dark suit and a neat side part.
wardrobe.item.pol_zhirinovsky = Vladimir Zhirinovsky
wardrobe.item.pol_zhirinovsky.desc = A brown pinstripe suit and grey hair.
wardrobe.item.pol_kadyrov = Ramzan Kadyrov
wardrobe.item.pol_kadyrov.desc = A green tunic, a beard and a papakha.
wardrobe.item.pol_nazarbayev = Nursultan Nazarbayev
wardrobe.item.pol_nazarbayev.desc = A dark suit and a high brow.
wardrobe.item.pol_tokayev = Kassym-Jomart Tokayev
wardrobe.item.pol_tokayev.desc = A suit and thin-framed glasses.
wardrobe.item.pol_lavrov = Sergey Lavrov
wardrobe.item.pol_lavrov.desc = A stern suit, a moustache and a weary look.
wardrobe.item.pet_axolotl = Axolotl
wardrobe.item.pet_axolotl.desc = A smiley pink critter with fluffy gills. Puffs its cheeks and blows bubbles.
wardrobe.item.pet_penguin = Penguin Chick
wardrobe.item.pet_penguin.desc = Waddles along in a knitted scarf and sometimes slides on its belly.
wardrobe.item.pet_red_panda = Red Panda
wardrobe.item.pet_red_panda.desc = A fluffy ringed tail. Rears up on its hind legs to look fearsome.
wardrobe.item.pet_corgi = Corgi
wardrobe.item.pet_corgi.desc = Short legs, big ears and sudden fits of running in circles.
wardrobe.item.pet_capybara = Capybara
wardrobe.item.pet_capybara.desc = An unflappable capybara with a yuzu on its head. Happily sits on your head.
wardrobe.item.pet_baby_phoenix = Baby Phoenix
wardrobe.item.pet_baby_phoenix.desc = A blazing crest and a fiery tail. Sneezes out sparks.
wardrobe.item.pet_jellyfish = Jellyfish
wardrobe.item.pet_jellyfish.desc = Drifts through the air, pulsing and flashing with light.
wardrobe.item.pet_bumble_bee = Bumblebee
wardrobe.item.pet_bumble_bee.desc = A fuzzy buzzing bumblebee. Does the waggle dance and brings you pollen.
wardrobe.item.pet_hedgehog = Hedgehog
wardrobe.item.pet_hedgehog.desc = Carries an apple on its spikes and curls into a ball when monsters are near.
wardrobe.item.pet_frog_prince = Frog Prince
wardrobe.item.pet_frog_prince.desc = A little frog in a golden crown. Leaps high and snaps flies with its tongue.
wardrobe.item.pet_koi_spirit = Koi Spirit
wardrobe.item.pet_koi_spirit.desc = Swims through the air like a pond and leaps in a somersault.
wardrobe.item.pet_yeti_cub = Yeti Cub
wardrobe.item.pet_yeti_cub.desc = A shaggy snow cub with icy claws. Loves throwing snowballs.
wardrobe.item.pet_dino_hatchling = Dino Hatchling
wardrobe.item.pet_dino_hatchling.desc = Freshly hatched and wearing its eggshell like a helmet. Roars fiercely. Almost.
wardrobe.item.pet_panda_cub = Panda Cub
wardrobe.item.pet_panda_cub.desc = Always munching bamboo and rolling over on its back.
wardrobe.item.pet_ufo_drone = UFO Drone
wardrobe.item.pet_ufo_drone.desc = A tiny flying saucer with a pilot inside. Scans the area with its beam.
wardrobe.item.head_street_bucket_hat = Corduroy Bucket Hat
wardrobe.item.head_street_bucket_hat.desc = An embroidered smiley, eyelets and a toggled drawcord.
wardrobe.item.head_samurai_kabuto = Shogun Kabuto
wardrobe.item.head_samurai_kabuto.desc = A lacquered helm with golden kuwagata horns and crimson lacing.
wardrobe.item.head_astro_helmet = Astronaut Helmet
wardrobe.item.head_astro_helmet.desc = A gold visor, a lamp, a mission patch and a blinking antenna.
wardrobe.item.head_kitty_headphones = Kitty Headphones
wardrobe.item.head_kitty_headphones.desc = Glowing paw prints on the cups and ears that twitch on their own.
wardrobe.item.body_biker_jacket = Biker Jacket
wardrobe.item.body_biker_jacket.desc = An offset zip, studded shoulders and a buckled belt.
wardrobe.item.body_sakura_kimono = Sakura Kimono
wardrobe.item.body_sakura_kimono.desc = Blossom silk, an obi bow and sleeves that drift behind you. Sheds petals.
wardrobe.item.body_puffer_vest = Puffer Vest
wardrobe.item.body_puffer_vest.desc = A quilted vest over a hoodie with swinging drawstrings.
wardrobe.item.body_detective_trench = Detective Trench
wardrobe.item.body_detective_trench.desc = A belted double-breasted coat with a plaid lining and swaying skirts.
wardrobe.item.legs_track_pants = Track Pants & Runners
wardrobe.item.legs_track_pants.desc = Side stripes, ankle zips and runners with an air heel.
wardrobe.item.legs_samurai_hakama = Hakama & Zori
wardrobe.item.legs_samurai_hakama.desc = Wide pleated hakama, tabi socks and straw zori.
wardrobe.item.legs_skater_shorts = Skater Shorts
wardrobe.item.legs_skater_shorts.desc = Denim shorts, a wallet chain, tube socks and skate shoes.
wardrobe.item.legs_highland_kilt = Highland Kilt
wardrobe.item.legs_highland_kilt.desc = Tartan, a tasselled fur sporran, kilt hose and brogues.
wardrobe.item.back_guitar_gigbag = Guitar Gig Bag
wardrobe.item.back_guitar_gigbag.desc = A sticker-covered gig bag with a swinging pick charm.
wardrobe.item.back_fairy_wings = Fairy Wings
wardrobe.item.back_fairy_wings.desc = Iridescent sheer wings with glowing veins. They flutter and shed sparkles.
wardrobe.item.back_mech_tentacles = Mech Tentacles
wardrobe.item.back_mech_tentacles.desc = Four arms on a spinal reactor writhe and snap their claws.
wardrobe.item.cape_pilgrim = Pilgrim's Mantle
wardrobe.item.cape_pilgrim.desc = A wool cloak with a hood, a shoulder mantle and a pilgrim's shell.
wardrobe.item.cape_raven = Raven Cloak
wardrobe.item.cape_raven.desc = Rows of blue-black feathers with a violet sheen and a plumed collar.
wardrobe.item.cape_swallowtail = Swallowtail
wardrobe.item.cape_swallowtail.desc = A tailcoat cape splitting into two tails with silver piping.
wardrobe.item.cape_parade = Parade Capelet
wardrobe.item.cape_parade.desc = A short capelet with gold fringe, epaulettes and an aiguillette.
wardrobe.item.cape_wayfarer = Wayfarer's Scarf
wardrobe.item.cape_wayfarer.desc = Long scarf tails stream in the wind, golden glyphs shimmer.
wardrobe.item.cape_jinbaori = Samurai Jinbaori
wardrobe.item.cape_jinbaori.desc = A war surcoat with stiff shoulders, a family mon and a split back.
wardrobe.item.cape_war_banner = War Banner
wardrobe.item.cape_war_banner.desc = A torn banner on a pole with a crest, arrow holes and one arrow stuck.
wardrobe.item.cape_cathedral = Stained Glass Cape
wardrobe.item.cape_cathedral.desc = A rose window and lancet arches glowing through coloured glass.
wardrobe.item.cape_aurora = Aurora Cape
wardrobe.item.cape_aurora.desc = A starry sky rippling with living bands of northern lights.
wardrobe.item.cape_lava = Lava Cloak
wardrobe.item.cape_lava.desc = Basalt split by glowing cracks, the hem dripping with magma.
wardrobe.item.cape_sakura = Sakura Cape
wardrobe.item.cape_sakura.desc = Silk with a blossoming branch, an obi bow and drifting petals.
wardrobe.item.cape_hologram = Cyber Hologram
wardrobe.item.cape_hologram.desc = A back-mounted projector casts a see-through cape with a scanning beam.
wardrobe.item.cape_ermine = Ermine Mantle
wardrobe.item.cape_ermine.desc = Velvet with golden lilies, an ermine shoulder cape and a ruby chain.
wardrobe.item.cape_nomad = Desert Nomad Cloak
wardrobe.item.cape_nomad.desc = A sun-bleached patched cloak with a keffiyeh, beads and arm wraps.
wardrobe.item.cape_patchwork = Witch's Patchwork Cloak
wardrobe.item.cape_patchwork.desc = Stitched from scraps with magic thread, a jagged hem and charms.
wardrobe.item.watch_omega_speedmaster = Omega Speedmaster Moonwatch
wardrobe.item.watch_omega_speedmaster.desc = The Moon chronograph: a black tachymeter, three counters and running seconds at nine.
wardrobe.item.watch_casio_gshock = Casio G-Shock
wardrobe.item.watch_casio_gshock.desc = An indestructible resin square, an LCD with a blinking colon and steel buttons.
wardrobe.item.watch_apple_ultra = Apple Watch Ultra
wardrobe.item.watch_apple_ultra.desc = Titanium, an orange Action button and a glowing screen with activity rings.
wardrobe.item.watch_tag_monaco = TAG Heuer Monaco
wardrobe.item.watch_tag_monaco.desc = A square racing chronograph: blue sunburst, a left-hand crown and perforated leather.
wardrobe.item.watch_breitling_navitimer = Breitling Navitimer
wardrobe.item.watch_breitling_navitimer.desc = A pilot chronograph with a slide-rule bezel, beaded ring and silver counters.
wardrobe.item.watch_jacob_astronomia = Jacob & Co. Astronomia
wardrobe.item.watch_jacob_astronomia.desc = Under a sapphire dome a tourbillon, a globe, a diamond and an always-upright dial orbit the sky.
wardrobe.item.watch_jacob_godfather = Jacob & Co. Opera Godfather
wardrobe.item.watch_jacob_godfather.desc = Under a sapphire dome spins a music box drum playing The Godfather theme, beside a tourbillon and a red rose.
wardrobe.item.watch_tennis_bracelet = Diamond Tennis Bracelet
wardrobe.item.watch_tennis_bracelet.desc = An unbroken line of diamonds in white gold, every stone catching the light.
wardrobe.item.watch_tennis_emerald = Emerald Tennis Bracelet
wardrobe.item.watch_tennis_emerald.desc = Square emeralds in yellow gold, every stone flashing with green fire.
wardrobe.item.watch_tennis_sapphire = Sapphire Tennis Bracelet
wardrobe.item.watch_tennis_sapphire.desc = Blue sapphires alternating with diamonds in white gold.
wardrobe.item.watch_tennis_ruby = Ruby Tennis Bracelet
wardrobe.item.watch_tennis_ruby.desc = Oval rubies in rose gold, every third stone a diamond.
wardrobe.item.watch_tennis_rainbow = Rainbow Tennis Bracelet
wardrobe.item.watch_tennis_rainbow.desc = Coloured sapphires in every shade of the rainbow set in yellow gold, shimmering with every move.
wardrobe.item.watch_tennis_double = Double Row Tennis Bracelet
wardrobe.item.watch_tennis_double.desc = Two rows of diamonds in platinum, twice the sparkle.
wardrobe.item.watch_tennis_black = Black Ice Tennis Bracelet
wardrobe.item.watch_tennis_black.desc = Black diamonds on black rhodium, every fourth stone a white one.
wardrobe.item.neck_iced_cuban = Iced Cuban Crown
wardrobe.item.neck_iced_cuban.desc = A diamond-flooded Cuban chain and a crown set with a ruby and sapphires, all sparkling.
wardrobe.item.neck_rosary = Rosary
wardrobe.item.neck_rosary.desc = Rosewood beads on silver links, a medal and a crucifix with a gold figure.
wardrobe.item.neck_name_plate = Name Plate Chain
wardrobe.item.neck_name_plate.desc = A gold rope chain and an italic ZENITH plate with a diamond underline.
wardrobe.item.neck_usekh = Pharaoh's Usekh
wardrobe.item.neck_usekh.desc = A broad collar of lapis, carnelian and turquoise with falcon heads and a winged scarab.
wardrobe.item.neck_magatama = Magatama
wardrobe.item.neck_magatama.desc = Jade commas, tube beads and crystal on a silk cord, a samurai's charm.
wardrobe.item.neck_locket = Portrait Locket
wardrobe.item.neck_locket.desc = An engraved gold locket with a ruby that opens by itself to reveal an old photograph.
wardrobe.item.neck_claw_chain = Claw Necklace
wardrobe.item.neck_claw_chain.desc = A leather cord, bear claws in silver caps and turquoise.
wardrobe.item.neck_pearl_bow = Pearls & Bow
wardrobe.item.neck_pearl_bow.desc = A short and a long pearl strand, a black satin bow and a baroque pearl drop.
wardrobe.item.char_cowboy_gunslinger = Cowboy Gunslinger
wardrobe.item.char_cowboy_gunslinger.desc = A stetson, a duster, a red bandana and a revolver on the hip.
wardrobe.item.char_viking_jarl = Viking Jarl
wardrobe.item.char_viking_jarl.desc = A horned helm, a braided red beard, a shield on the back and an axe.
wardrobe.item.char_egyptian_pharaoh = Pharaoh
wardrobe.item.char_egyptian_pharaoh.desc = A gold-striped nemes, a crook, a flail and a sun disc.
wardrobe.item.char_arctic_explorer = Arctic Explorer
wardrobe.item.char_arctic_explorer.desc = A fur-hooded parka, goggles, a backpack and an ice axe.
wardrobe.item.char_mad_scientist = Mad Scientist
wardrobe.item.char_mad_scientist.desc = Wild white hair, a monocle, a lab coat and a sparking Tesla coil.
wardrobe.item.char_jester_harlequin = Harlequin Jester
wardrobe.item.char_jester_harlequin.desc = A belled cap, diamonds, a ruff and a jester's bauble.
wardrobe.item.char_netrunner = Netrunner
wardrobe.item.char_netrunner.desc = A violet bob, a cyber eye, a neon jacket and a holo screen.
wardrobe.item.char_templar_crusader = Templar Crusader
wardrobe.item.char_templar_crusader.desc = Chainmail, a white surcoat with a red cross, a shield and a great helm at the belt.
wardrobe.item.char_jaguar_warrior = Jaguar Warrior
wardrobe.item.char_jaguar_warrior.desc = A jaguar-maw helm, quetzal plumes, a macuahuitl and a shield.
wardrobe.item.char_ghost_bride = Ghost Bride
wardrobe.item.char_ghost_bride.desc = A sheer veil, a withered bouquet, a broken chain and drifting souls.
wardrobe.item.char_lava_golem = Lava Golem
wardrobe.item.char_lava_golem.desc = A stone hulk with magma cracks and a pulsing molten core.
wardrobe.item.char_beekeeper = Beekeeper
wardrobe.item.char_beekeeper.desc = A veiled hat, a smoker, a jar of honey and buzzing bees.
wardrobe.item.char_fallen_angel = Fallen Angel
wardrobe.item.char_fallen_angel.desc = Black wings, a shattered halo and falling ash.
wardrobe.item.char_idol_singer = Idol Singer
wardrobe.item.char_idol_singer.desc = Mint buns, a headset, a stage uniform and a microphone.
wardrobe.item.char_firefighter = Firefighter
wardrobe.item.char_firefighter.desc = A badged helmet, reflective turnout gear, an air tank and an axe.
wardrobe.item.weapon_crossguard_saber = Crossguard Saber
wardrobe.item.weapon_crossguard_saber.desc = An unstable crimson beam with two plasma quillons and a crackling edge.
wardrobe.item.weapon_obsidian_greatsword = Obsidian Greatsword
wardrobe.item.weapon_obsidian_greatsword.desc = A demonic blade with lava veins, a horned guard and a burning eye.
wardrobe.item.weapon_sakura_wakizashi = Sakura Wakizashi
wardrobe.item.weapon_sakura_wakizashi.desc = A short blade with a blossom tsuba. Petals drift around the steel.
wardrobe.item.weapon_labrys = Labrys
wardrobe.item.weapon_labrys.desc = A bronze double axe with a meander band, lapis gem and crimson ribbons.
wardrobe.item.weapon_glacier_axe = Glacier Axe
wardrobe.item.weapon_glacier_axe.desc = A blade of ice shards with a glowing core, circled by floating crystals.
wardrobe.item.weapon_chainsaw_axe = Chainsaw Axe
wardrobe.item.weapon_chainsaw_axe.desc = The chain runs along the bar, the engine rattles and the exhaust glows.
wardrobe.item.weapon_bone_bow = Bone Bow
wardrobe.item.weapon_bone_bow.desc = Vertebrae limbs, claw tips and skulls with smouldering eyes.
wardrobe.item.weapon_solar_bow = Solar Wing Bow
wardrobe.item.weapon_solar_bow.desc = Golden winged limbs and a spinning crown of sunrays.
wardrobe.item.weapon_compound_bow = Compound Bow
wardrobe.item.weapon_compound_bow.desc = Cams roll over as you draw; the sight has glowing pins.
wardrobe.item.weapon_meteor_flail = Meteor Flail
wardrobe.item.weapon_meteor_flail.desc = A molten meteorite on a chain, circled by embers.
wardrobe.item.weapon_rune_warhammer = Rune Warhammer
wardrobe.item.weapon_rune_warhammer.desc = A northern war hammer whose runes pulse with light.
wardrobe.item.weapon_jester_mace = Jester's Mace
wardrobe.item.weapon_jester_mace.desc = A laughing mask and a weeping mask under a belled cap.
wardrobe.item.weapon_naginata = Naginata
wardrobe.item.weapon_naginata.desc = A curved blade on a lacquered pole with a crimson tassel.
wardrobe.item.weapon_lightning_javelin = Lightning Javelin
wardrobe.item.weapon_lightning_javelin.desc = A lightning-bolt head circled by crackling arcs.
wardrobe.item.weapon_bamboo_spear = Bamboo Spear
wardrobe.item.weapon_bamboo_spear.desc = Living bamboo with leaves, a red ribbon and a jade bead.
wardrobe.item.head_bogatyr_shelom = Bogatyr Shelom
wardrobe.item.head_bogatyr_shelom.desc = A pointed shishak with a gilded brow plate, a mail aventail and a red pennant.
wardrobe.item.body_bogatyr_kolchuga = Mirror Mail Hauberk
wardrobe.item.body_bogatyr_kolchuga.desc = Riveted mail, a gleaming mirror plate on the chest and a red kaftan beneath.
wardrobe.item.legs_bogatyr_sapogi = Sharovary & Sapogi
wardrobe.item.legs_bogatyr_sapogi.desc = Blue sharovary, a red sash and red boots with upturned toes.
wardrobe.item.head_pharaoh_nemes = Pharaoh's Nemes
wardrobe.item.head_pharaoh_nemes.desc = A striped nemes, a golden uraeus with ruby eyes and a braided beard.
wardrobe.item.body_pharaoh_usekh = Usekh Collar
wardrobe.item.body_pharaoh_usekh.desc = A broad beaded collar of gold, lapis and carnelian over sheer linen.
wardrobe.item.legs_pharaoh_shendyt = Shendyt & Sandals
wardrobe.item.legs_pharaoh_shendyt.desc = A pleated shendyt with a hieroglyph gold apron and gold sandals.
wardrobe.item.head_steam_aviator = Aeronaut Flight Cap
wardrobe.item.head_steam_aviator.desc = A fleece-lined leather cap, brass goggles with flip-down lenses and ticking gears.
wardrobe.item.body_steam_greatcoat = Aeronaut Greatcoat
wardrobe.item.body_steam_greatcoat.desc = Oxblood leather, a cross harness with a twitching gauge and a copper shoulder pipe.
wardrobe.item.legs_steam_boots = Jodhpurs & Riveted Boots
wardrobe.item.legs_steam_boots.desc = Khaki jodhpurs, tall riveted boots, gear buckles and copper knee guards.
wardrobe.item.back_steam_boiler = Steam Boiler Pack
wardrobe.item.back_steam_boiler.desc = A copper boiler with a live firebox and smoking stacks. Its propeller spins up in flight.
wardrobe.item.head_plague_beak = Plague Doctor Mask
wardrobe.item.head_plague_beak.desc = A wide-brimmed hat, a stitched leather beak and lenses with a faint green glow.
wardrobe.item.body_plague_coat = Waxed Physician's Coat
wardrobe.item.body_plague_coat.desc = A long waxed coat, a high collar and a bandolier of glowing tincture vials.
wardrobe.item.legs_plague_boots = Physician's Breeches & Boots
wardrobe.item.legs_plague_boots.desc = Dark breeches and tall cuffed boots cinched with a row of buckles.
wardrobe.item.back_plague_satchel = Apothecary Satchel
wardrobe.item.back_plague_satchel.desc = Drying herb bundles, a recipe scroll and a green-lit lantern that swings as you walk.
wardrobe.item.head_hoplite_corinthian = Corinthian Helm
wardrobe.item.head_hoplite_corinthian.desc = Bronze with eye slits and a red horsehair crest that bounces as you move.
wardrobe.item.body_hoplite_cuirass = Muscle Cuirass
wardrobe.item.body_hoplite_cuirass.desc = A bronze torso with a gorgoneion, leather pteruges and a red chlamys on one shoulder.
wardrobe.item.legs_hoplite_greaves = Greaves & Krepides
wardrobe.item.legs_hoplite_greaves.desc = Sculpted bronze greaves, a red chiton with a meander hem and laced sandals.
wardrobe.item.back_hoplite_aspis = Aspis & Dory
wardrobe.item.back_hoplite_aspis.desc = A round shield with a bronze lambda and a spear on your back — the phalanx holds.
wardrobe.item.head_tuareg_tagelmust = Tagelmust
wardrobe.item.head_tuareg_tagelmust.desc = An indigo turban with a veil, a silver amulet and a cloth tail in the wind.
wardrobe.item.body_tuareg_robe = Nomad Robes
wardrobe.item.body_tuareg_robe.desc = Indigo over sand, an Agadez cross, wide sleeves and a dagger at the belt.
wardrobe.item.legs_tuareg_sirwal = Sirwal & Sandals
wardrobe.item.legs_tuareg_sirwal.desc = Baggy sand trousers with woven bands and sandals with red straps.
wardrobe.item.head_racer_helmet = Formula Racing Helmet
wardrobe.item.head_racer_helmet.desc = Red-and-white livery, a tinted visor with tear-offs and a spoiler on top.
wardrobe.item.body_racer_suit = Fireproof Race Suit
wardrobe.item.body_racer_suit.desc = Sponsor patches, a HANS collar, pull-strap epaulettes and grippy gloves.
wardrobe.item.legs_racer_boots = Race Trousers & Boots
wardrobe.item.legs_racer_boots.desc = Stripes down to the ankle and thin velcro boots that feel every pedal.
wardrobe.item.head_mecha_helm = Mecha Pilot Helm
wardrobe.item.head_mecha_helm.desc = Angular armor, a glowing HUD visor slit and swept antenna fins.
wardrobe.item.body_mecha_chest = Reactor Power Armor
wardrobe.item.body_mecha_chest.desc = A pulsing reactor core, massive pauldrons and gauntlets traced with light.
wardrobe.item.legs_mecha_legs = Armored Legs & Mag-Boots
wardrobe.item.legs_mecha_legs.desc = Hydraulic pistons pump with every step and the soles glow blue.
wardrobe.item.back_mecha_thrusters = Twin Thruster Pods
wardrobe.item.back_mecha_thrusters.desc = Twin pods on a spine mount: airborne, they unfold fins and spit fire.
wardrobe.item.head_diver_helmet = Diving Helmet
wardrobe.item.head_diver_helmet.desc = Polished brass, three portholes and a grille over the front glass.
wardrobe.item.body_diver_suit = Diving Suit
wardrobe.item.body_diver_suit.desc = Canvas, a bolted brass corselet and lead weights on chest and back.
wardrobe.item.legs_diver_boots = Lead Diving Boots
wardrobe.item.legs_diver_boots.desc = Huge lead-soled boots with brass toe caps and leather straps.
wardrobe.item.back_diver_tanks = Air Tanks
wardrobe.item.back_diver_tanks.desc = Copper tanks, a pressure gauge and a ribbed hose to the helmet. They gurgle now and then.
wardrobe.item.body_hawaiian_shirt = Hawaiian Shirt
wardrobe.item.body_hawaiian_shirt.desc = Hibiscus and palm leaves worn open over a white tee.
wardrobe.item.body_bard_doublet = Bard's Doublet
wardrobe.item.body_bard_doublet.desc = Puffed sleeves slashed with silk, a laced front and a lute strap.
wardrobe.item.body_yellow_raincoat = Yellow Raincoat
wardrobe.item.body_yellow_raincoat.desc = A glossy toggle coat with a reflective band. It keeps dripping.
wardrobe.item.body_lab_coat = Lab Coat
wardrobe.item.body_lab_coat.desc = An ID badge, pens in the pocket and glowing test tubes at the side.
wardrobe.item.legs_muay_thai = Muay Thai Shorts
wardrobe.item.legs_muay_thai.desc = Satin shorts with Thai script on the waistband, shin wraps and ankle supports.
wardrobe.item.legs_goth_platforms = Bondage & Creepers
wardrobe.item.legs_goth_platforms.desc = Straps, D-rings, a chain and a tartan flap above chunky platform creepers.
wardrobe.item.legs_ballet_tutu = Ballerina Tutu
wardrobe.item.legs_ballet_tutu.desc = Sheer tulle layers, pink tights and pointe shoes with ribbons laced up the ankle.
wardrobe.item.legs_rocket_boots = Rocket Boots
wardrobe.item.legs_rocket_boots.desc = Chrome heel nozzles burst into flame the moment you leave the ground.
wardrobe.item.legs_roller_skates = Roller Disco
wardrobe.item.legs_roller_skates.desc = Frayed denim cut-offs, striped knee socks and quad skates with spinning wheels.
wardrobe.item.back_sashimono_banner = Sashimono Banner
wardrobe.item.back_sashimono_banner.desc = A samurai's crimson flag with a painted mon on a back pole, rippling in the wind.
wardrobe.item.back_lantern_yoke = Lantern Yoke
wardrobe.item.back_lantern_yoke.desc = A bamboo yoke with two red paper lanterns that glow and swing.
wardrobe.item.back_coffin = Chained Coffin
wardrobe.item.back_coffin.desc = A dark coffin with an iron cross and corners, its chains swinging as you walk.
wardrobe.item.back_holo_halo = Holo Halo
wardrobe.item.back_holo_halo.desc = A ring of glyph-covered holograms floats behind you, spinning and sparking.
wardrobe.item.back_sapling_pot = Sapling Pot
wardrobe.item.back_sapling_pot.desc = A clay pot on your back with a living little tree and a bird in its nest.
wardrobe.item.back_scroll_case = Scroll Case
wardrobe.item.back_scroll_case.desc = A lacquered tube with seigaiha waves, rolled scrolls and a tied-on brush.
wardrobe.item.back_balloon_bundle = Balloon Bundle
wardrobe.item.back_balloon_bundle.desc = A little backpack clipped to a bunch of balloons bobbing over your head.
wardrobe.item.back_void_tendrils = Void Tendrils
wardrobe.item.back_void_tendrils.desc = Shadow tendrils with glowing tips writhe out of a rift on your back.
wardrobe.item.back_boombox = Boombox
wardrobe.item.back_boombox.desc = A retro boombox on a strap: pumping speakers and a spinning cassette.
wardrobe.item.weapon_gladius = Gladius
wardrobe.item.weapon_gladius.desc = A short Roman leaf-pointed blade with a ribbed bone grip and brass guard.
wardrobe.item.weapon_zweihander = Zweihander
wardrobe.item.weapon_zweihander.desc = A huge two-hander with a leather-wrapped ricasso, parrying hooks and a wide guard.
wardrobe.item.weapon_sultan_scimitar = Sultan's Scimitar
wardrobe.item.weapon_sultan_scimitar.desc = A curved blade with gold scrollwork, a ruby pommel and a flared tip.
wardrobe.item.weapon_musketeer_rapier = Musketeer's Rapier
wardrobe.item.weapon_musketeer_rapier.desc = A slender blade, a swept hilt of curling bars, a shell guard and a blue ribbon.
wardrobe.item.weapon_highland_claymore = Highland Claymore
wardrobe.item.weapon_highland_claymore.desc = Forward-sloping quillons ending in quatrefoils, a wheel pommel and a tartan sash.
wardrobe.item.weapon_khopesh = Khopesh
wardrobe.item.weapon_khopesh.desc = An Egyptian sickle-sword of bronze with gold inlay and a lapis grip.
wardrobe.item.weapon_flamberge = Flamberge
wardrobe.item.weapon_flamberge.desc = A wavy flame blade with a red-hot edge that sheds sparks.
wardrobe.item.weapon_void_runeblade = Void Runeblade
wardrobe.item.weapon_void_runeblade.desc = A black blade with blazing purple runes, circled by orbiting rune shards.
wardrobe.item.weapon_buster_sword = Buster Sword
wardrobe.item.weapon_buster_sword.desc = A massive steel slab with two holes near the guard and a bandaged grip.
wardrobe.item.weapon_leaf_blade = Elven Leaf Blade
wardrobe.item.weapon_leaf_blade.desc = A leaf-shaped blade with a vine-wrapped hilt and a glowing emerald.
wardrobe.item.weapon_bone_sword = Bone Sword
wardrobe.item.weapon_bone_sword.desc = Crudely carved from a huge bone, with teeth along the edge and a leather grip.
wardrobe.item.weapon_jade_dao = Jade Dao
wardrobe.item.weapon_jade_dao.desc = A Chinese sabre with brass fittings, a jade pommel and a swaying red tassel.
wardrobe.item.weapon_holy_avenger = Holy Avenger
wardrobe.item.weapon_holy_avenger.desc = A radiant paladin sword with golden wings, a glowing inscription and a halo.
wardrobe.item.weapon_prism_sword = Prism Sword
wardrobe.item.weapon_prism_sword.desc = A crystal prism blade that splits light into a rainbow along its edge.
wardrobe.item.weapon_shotel = Shotel
wardrobe.item.weapon_shotel.desc = An Ethiopian sickle-sword curved almost into a half-moon, with a wooden grip.
wardrobe.item.weapon_gunblade = Gunblade
wardrobe.item.weapon_gunblade.desc = A blade on a revolver frame: trigger, barrel and a cylinder that clicks around.
wardrobe.item.weapon_candy_cane_sword = Candy Cane Sword
wardrobe.item.weapon_candy_cane_sword.desc = A striped candy-cane blade, a gingerbread guard and a green ribbon bow.
wardrobe.item.weapon_coral_blade = Coral Blade
wardrobe.item.weapon_coral_blade.desc = Pink coral crusted with shells and barnacles, a pearl pommel and rising bubbles.
wardrobe.item.weapon_thunder_nodachi = Thunder Nodachi
wardrobe.item.weapon_thunder_nodachi.desc = A huge nodachi with a lightning hamon glowing blue and arcs running along the edge.
wardrobe.item.weapon_bokken = Bokken
wardrobe.item.weapon_bokken.desc = A wooden training sword with visible oak grain and a plastic tsuba.
wardrobe.item.weapon_serpent_kris = Serpent Kris
wardrobe.item.weapon_serpent_kris.desc = A wavy kris with pamor patterning and a naga hilt that flicks its tongue.
wardrobe.item.weapon_moonlight_greatsword = Moonlight Greatsword
wardrobe.item.weapon_moonlight_greatsword.desc = A translucent blade of pale moonlight with a crescent-moon guard.
wardrobe.item.weapon_bloodthirster = Bloodthirster
wardrobe.item.weapon_bloodthirster.desc = A crimson blade with glowing veins, a beating heart in the guard and dripping blood.
wardrobe.item.weapon_pixel_sword = Pixel Sword
wardrobe.item.weapon_pixel_sword.desc = A chunky 8-bit sword of stepped blocks with a pixel glint running up the blade.
wardrobe.item.weapon_clockwork_blade = Clockwork Blade
wardrobe.item.weapon_clockwork_blade.desc = Brass and steel with spinning gears in the guard and a wind-up key pommel.
wardrobe.item.weapon_yumi = Yumi
wardrobe.item.weapon_yumi.desc = A tall asymmetric bow in black lacquer with rattan bindings and a white string.
wardrobe.item.weapon_mongol_bow = Mongol Bow
wardrobe.item.weapon_mongol_bow.desc = A short composite bow: horn siyahs, painted birch bark and a blue khadag ribbon.
wardrobe.item.weapon_yew_longbow = Yew Longbow
wardrobe.item.weapon_yew_longbow.desc = An English yew longbow: pale sapwood, dark heartwood and horn nocks.
wardrobe.item.weapon_vine_bow = Living Vine Bow
wardrobe.item.weapon_vine_bow.desc = Twisted living vine in leaves, with flowers blooming on the limbs.
wardrobe.item.weapon_shadow_bow = Shadow Bow
wardrobe.item.weapon_shadow_bow.desc = Black blade-like limbs with violet edges that bleed smoke.
wardrobe.item.weapon_storm_bow = Storm Bow
wardrobe.item.weapon_storm_bow.desc = The string is a crackling lightning bolt; a storm cloud churns at the grip.
wardrobe.item.weapon_cupid_bow = Cupid's Bow
wardrobe.item.weapon_cupid_bow.desc = A pink-gold bow with a heart grip and tiny fluttering wings.
wardrobe.item.weapon_tidal_bow = Tidal Bow
wardrobe.item.weapon_tidal_bow.desc = A translucent wave with foam crests and a pearl, dripping from the tips.
wardrobe.item.weapon_ember_bow = Ember Bow
wardrobe.item.weapon_ember_bow.desc = Charred wood split by glowing ember cracks, with flames dancing on the tips.
wardrobe.item.weapon_scythian_bow = Scythian Bow
wardrobe.item.weapon_scythian_bow.desc = A double-curved bow with gold animal-style plaques and griffin-head tips.
wardrobe.item.weapon_steampunk_bow = Steampunk Bow
wardrobe.item.weapon_steampunk_bow.desc = Brass and walnut: gears turn at the grip, a scope on top and steam from a valve.
wardrobe.item.weapon_void_bow = Void Bow
wardrobe.item.weapon_void_bow.desc = Void crystal with shards floating around the limbs and a dark orb spinning at the grip.
wardrobe.item.weapon_moon_bow = Moon Bow
wardrobe.item.weapon_moon_bow.desc = A silver crescent moon with star beads twinkling on the string.
wardrobe.item.weapon_bamboo_bow = Bamboo Bow
wardrobe.item.weapon_bamboo_bow.desc = Jointed bamboo bound with twine, a leafy sprig and a straw tassel.
wardrobe.item.weapon_antler_bow = Antler Bow
wardrobe.item.weapon_antler_bow.desc = Two tined deer antlers joined by a laced leather grip.
wardrobe.item.weapon_serpent_bow = Serpent Bow
wardrobe.item.weapon_serpent_bow.desc = Two emerald-eyed serpents form the limbs, their tails coiled on the grip.
wardrobe.item.weapon_rainbow_bow = Rainbow Bow
wardrobe.item.weapon_rainbow_bow.desc = A seven-colour rainbow arc with cloud tips and a prism in the grip.
wardrobe.item.weapon_royal_bow = Royal Bow
wardrobe.item.weapon_royal_bow.desc = A gilded bow with filigree, sapphires and a crown on the velvet grip.
wardrobe.item.weapon_spider_bow = Spider Bow
wardrobe.item.weapon_spider_bow.desc = Black chitin, spider legs for tips and a string of cobweb.
wardrobe.item.weapon_sakura_bow = Sakura Bow
wardrobe.item.weapon_sakura_bow.desc = Cherry wood in bloom: budding branches and drifting petals.
wardrobe.item.weapon_demon_bow = Demon Bow
wardrobe.item.weapon_demon_bow.desc = Horns split by molten cracks and a burning eye blinking on the grip.
wardrobe.item.weapon_constellation_bow = Constellation Bow
wardrobe.item.weapon_constellation_bow.desc = Translucent night sky, twinkling stars and glowing constellation lines.
wardrobe.item.weapon_wind_bow = Wind Bow
wardrobe.item.weapon_wind_bow.desc = Pale wood with long feathers streaming from the tips in the wind.
wardrobe.item.weapon_obsidian_bow = Obsidian Bow
wardrobe.item.weapon_obsidian_bow.desc = Glassy black shards weeping drops of violet tears.
wardrobe.item.weapon_harp_bow = Harp Bow
wardrobe.item.weapon_harp_bow.desc = A golden lyre with a soundbox whose strings hum and tremble.
wardrobe.item.weapon_shestoper = Shestoper
wardrobe.item.weapon_shestoper.desc = A Russian mace with six steel flanges and a round finial.
wardrobe.item.weapon_hetman_bulava = Hetman's Bulava
wardrobe.item.weapon_hetman_bulava.desc = A gilded pear-shaped head set with turquoise, with a crimson tassel.
wardrobe.item.weapon_kanabo = Kanabo
wardrobe.item.weapon_kanabo.desc = A long octagonal club of black lacquer studded with iron.
wardrobe.item.weapon_macuahuitl = Macuahuitl
wardrobe.item.weapon_macuahuitl.desc = An Aztec club edged with obsidian, painted glyphs and quetzal feathers.
wardrobe.item.weapon_caveman_club = Caveman Club
wardrobe.item.weapon_caveman_club.desc = A knobbly log with flint spikes and a hide-wrapped grip.
wardrobe.item.weapon_judge_gavel = Judge's Gavel
wardrobe.item.weapon_judge_gavel.desc = An oversized polished gavel with brass bands. The verdict is final.
wardrobe.item.weapon_sledgehammer = Sledgehammer
wardrobe.item.weapon_sledgehammer.desc = A heavy steel head on a yellow-and-black fiberglass handle.
wardrobe.item.weapon_forge_hammer = Forge Hammer
wardrobe.item.weapon_forge_hammer.desc = The head is red-hot straight from the forge, shedding sparks.
wardrobe.item.weapon_holy_censer = Holy Censer
wardrobe.item.weapon_holy_censer.desc = A golden censer on a chain: coals glow through its piercings, incense drifts.
wardrobe.item.weapon_solar_mace = Solar Mace
wardrobe.item.weapon_solar_mace.desc = A blazing sun on a golden haft, ringed by spinning corona rays.
wardrobe.item.weapon_lollipop_mace = Lollipop Mace
wardrobe.item.weapon_lollipop_mace.desc = A giant swirl lollipop on a stick, tied with a pink bow.
wardrobe.item.weapon_anchor_mace = Anchor Mace
wardrobe.item.weapon_anchor_mace.desc = A barnacled ship's anchor wrapped in chain, with seaweed on a fluke.
wardrobe.item.weapon_bell_mace = Bell Mace
wardrobe.item.weapon_bell_mace.desc = A bronze bell for a head: the clapper swings and every hit rings a note.
wardrobe.item.weapon_geode_mace = Geode Mace
wardrobe.item.weapon_geode_mace.desc = A cracked stone shell with a glowing amethyst cluster inside.
wardrobe.item.weapon_gravity_hammer = Gravity Hammer
wardrobe.item.weapon_gravity_hammer.desc = A gravity core floats between the plates, ringed by spinning fields.
wardrobe.item.weapon_triple_flail = Triple Flail
wardrobe.item.weapon_triple_flail.desc = Three spiked balls on chains, each swinging its own way.
wardrobe.item.weapon_tiki_club = Tiki Club
wardrobe.item.weapon_tiki_club.desc = A carved idol with bright eyes, a toothy grin and palm fronds.
wardrobe.item.weapon_void_scepter = Void Scepter
wardrobe.item.weapon_void_scepter.desc = A void orb throbs in a cage, circled by dark shards.
wardrobe.item.weapon_dragon_skull_maul = Dragon Skull Maul
wardrobe.item.weapon_dragon_skull_maul.desc = A horned dragon skull with fire smouldering in its sockets.
wardrobe.item.weapon_bone_club = Bone Club
wardrobe.item.weapon_bone_club.desc = A giant's thighbone with a leather wrap.
wardrobe.item.weapon_royal_scepter = Royal Scepter
wardrobe.item.weapon_royal_scepter.desc = Gold, an orb and cross, pearls, rubies and sapphires.
wardrobe.item.weapon_urchin_mace = Sea Urchin Mace
wardrobe.item.weapon_urchin_mace.desc = A spiny purple urchin on driftwood with swaying seaweed.
wardrobe.item.weapon_clock_hammer = Clock Hammer
wardrobe.item.weapon_clock_hammer.desc = A clock face ticks on the head while a gear turns behind.
wardrobe.item.weapon_mushroom_mace = Mushroom Mace
wardrobe.item.weapon_mushroom_mace.desc = A giant fly agaric on its stalk. It bounces and sheds spores.
wardrobe.item.weapon_brazier_mace = Brazier Mace
wardrobe.item.weapon_brazier_mace.desc = An iron cage with a living fire raging inside.
wardrobe.item.head_artist_beret = Artist's Beret
wardrobe.item.head_artist_beret.desc = A burgundy beret speckled with paint and a brush behind the ear.
wardrobe.item.head_chef_toque = Chef's Toque
wardrobe.item.head_chef_toque.desc = A tall pleated toque with a puffy top and an embroidered badge.
wardrobe.item.head_firefighter_helmet = Firefighter Helmet
wardrobe.item.head_firefighter_helmet.desc = A long rear brim, a brass eagle, a numbered shield and reflective stripes.
wardrobe.item.head_jester_cap = Jester's Cap
wardrobe.item.head_jester_cap.desc = Three floppy diamond-patterned points, each with a jingling bell.
wardrobe.item.head_pumpkin_lantern = Jack-o'-Lantern
wardrobe.item.head_pumpkin_lantern.desc = A carved pumpkin for a head with a flickering candle inside.
wardrobe.item.head_frog_hat = Frog Beanie
wardrobe.item.head_frog_hat.desc = A knitted beanie with bulging eyes, rosy cheeks and pom-pom ties.
wardrobe.item.head_mariachi_sombrero = Mariachi Sombrero
wardrobe.item.head_mariachi_sombrero.desc = A wide black sombrero with silver embroidery and pom-poms around the rim.
wardrobe.item.head_ice_tiara = Ice Tiara
wardrobe.item.head_ice_tiara.desc = A silver circlet of ice spikes with crystals floating above.
wardrobe.item.head_seraph_halo = Seraph Halo
wardrobe.item.head_seraph_halo.desc = Two golden rings counter-rotate while little wings flutter at the temples.
wardrobe.item.head_deerstalker = Deerstalker
wardrobe.item.head_deerstalker.desc = A tweed cap with two peaks, flaps tied in a bow and a pipe in the mouth.
wardrobe.item.head_kitsune_mask = Kitsune Mask
wardrobe.item.head_kitsune_mask.desc = A white fox mask with red markings tilted to the side, tassels swaying.
wardrobe.item.head_maharaja_turban = Maharaja Turban
wardrobe.item.head_maharaja_turban.desc = A saffron turban, an emerald brooch, strings of pearls and a white plume.
wardrobe.item.head_amanita_cap = Fly Agaric Cap
wardrobe.item.head_amanita_cap.desc = A huge red cap with white spots, gills beneath and drifting spores.
wardrobe.item.head_graduation_cap = Graduation Cap
wardrobe.item.head_graduation_cap.desc = A black mortarboard with a golden tassel that swings as you walk.
wardrobe.item.head_propeller_beanie = Propeller Beanie
wardrobe.item.head_propeller_beanie.desc = A rainbow beanie whose propeller spins faster when you run or fly.
wardrobe.item.back_monarch_wings = Monarch Wings
wardrobe.item.back_monarch_wings.desc = Orange butterfly wings with black veins that beat faster in flight.
wardrobe.item.back_teddy_backpack = Teddy Backpack
wardrobe.item.back_teddy_backpack.desc = A plush teddy that hugs you over the shoulders.
wardrobe.item.back_turtle_shell = Turtle Shell
wardrobe.item.back_turtle_shell.desc = A domed shell of scutes on leather straps.
wardrobe.item.back_skateboard = Skateboard
wardrobe.item.back_skateboard.desc = A printed deck slung diagonally, wheels spinning as you walk.
wardrobe.item.back_surfboard = Surfboard
wardrobe.item.back_surfboard.desc = A long board with a stripe, fins and a dangling leash.
wardrobe.item.back_greatsword_sheath = Greatsword Sheath
wardrobe.item.back_greatsword_sheath.desc = A huge sword in a bound scabbard, the hilt jutting over the shoulder.
wardrobe.item.back_clockwork_key = Clockwork Key
wardrobe.item.back_clockwork_key.desc = A big brass key in your back keeps turning as if you were wound up.
wardrobe.item.back_phoenix_wings = Phoenix Wings
wardrobe.item.back_phoenix_wings.desc = Blazing feathers from gold to crimson, raining fire in flight.
wardrobe.item.back_ice_crystal_wings = Ice Crystal Wings
wardrobe.item.back_ice_crystal_wings.desc = Wings of clear ice shards with snow swirling around.
wardrobe.item.back_flower_basket = Flower Basket
wardrobe.item.back_flower_basket.desc = A wicker basket with a bouquet and a little bee circling it.
wardrobe.item.cape_capelet = Victorian Capelet
wardrobe.item.cape_capelet.desc = A short capelet with tiers of ruffles and a cameo clasp.
wardrobe.item.cape_journey_scarf = Journey Scarf
wardrobe.item.cape_journey_scarf.desc = An endlessly long scarf with golden glyphs trailing behind.
wardrobe.item.cape_ranger_hood = Ranger's Cloak
wardrobe.item.cape_ranger_hood.desc = A forest cloak with a lowered hood, a leaf clasp and a frayed hem.
wardrobe.item.cape_tattered_wraith = Tattered Wraith
wardrobe.item.cape_tattered_wraith.desc = A cloak torn into strips, each moving on its own and trailing smoke.
wardrobe.item.cape_quetzal = Quetzal Mantle
wardrobe.item.cape_quetzal.desc = Rows of iridescent feathers, long tail plumes and a jade collar.
wardrobe.item.cape_wolf_pelt = Wolf Pelt
wardrobe.item.cape_wolf_pelt.desc = A grey pelt with the wolf's head on one shoulder and paws on the chest.
wardrobe.item.cape_hero = Hero's Cape
wardrobe.item.cape_hero.desc = A crimson cape with a high collar and a golden star. Go save the world.
wardrobe.item.cape_matador = Matador's Capote
wardrobe.item.cape_matador.desc = A magenta cape with a yellow lining, thrown over one shoulder.
wardrobe.item.cape_opera = Opera Cloak
wardrobe.item.cape_opera.desc = Black over crimson satin, a standing collar and a silver chain.
wardrobe.item.cape_mino = Straw Mino
wardrobe.item.cape_mino.desc = A Japanese raincoat of layered straw with a shoulder cape.
wardrobe.item.cape_pelisse = Hussar Pelisse
wardrobe.item.cape_pelisse.desc = Slung over one shoulder: fur, gold cords and a dangling sleeve.
wardrobe.item.cape_stained_glass = Stained Glass Cloak
wardrobe.item.cape_stained_glass.desc = A mosaic of coloured glass in lead came, glowing from within.
wardrobe.item.cape_waterfall = Waterfall Cloak
wardrobe.item.cape_waterfall.desc = Streams of clear water run down the cloak and drip from the hem.
wardrobe.item.cape_ghillie = Ghillie Cloak
wardrobe.item.cape_ghillie.desc = Shaggy camouflage strands with leafy tufts on the shoulders.
wardrobe.item.cape_lamellar = Lamellar Cloak
wardrobe.item.cape_lamellar.desc = Hundreds of steel plates laced with red cord, swinging heavily.
wardrobe.item.cape_bat = Bat Cloak
wardrobe.item.cape_bat.desc = Membranes on finger ribs. It spreads like wings when you jump.
wardrobe.item.cape_kasaya = Kasaya
wardrobe.item.cape_kasaya.desc = A saffron patchwork monk's robe draped across one shoulder.
wardrobe.item.cape_origami = Origami Cloak
wardrobe.item.cape_origami.desc = Crisp paper facets and little cranes flapping their wings.
wardrobe.item.cape_jellyfish = Jellyfish
wardrobe.item.cape_jellyfish.desc = A glowing translucent bell and long tentacles drifting behind.
wardrobe.item.cape_sail = Sail Cloak
wardrobe.item.cape_sail.desc = Seamed canvas with grommets and rigging on a wooden yard.
wardrobe.item.cape_jarl_fur = Jarl's Furs
wardrobe.item.cape_jarl_fur.desc = Heavy fur on the shoulders, a woven border and bronze brooches with beads.
wardrobe.item.cape_highwayman = Highwayman's Coat
wardrobe.item.cape_highwayman.desc = A long coachman's cape with three capelets and brass buttons.
wardrobe.item.cape_crystal_shards = Crystal Shards
wardrobe.item.cape_crystal_shards.desc = Floating crystal plates form a cape and bob gently.
wardrobe.item.cape_horo = Horo
wardrobe.item.cape_horo.desc = A samurai's wind-filled silk bubble bearing the clan crest.
wardrobe.item.cape_cloud = Cloud Cloak
wardrobe.item.cape_cloud.desc = Puffy clouds with a sunrise edge drift slowly behind you.
wardrobe.item.weapon_tomahawk = Tomahawk
wardrobe.item.weapon_tomahawk.desc = A painted haft with beads and feathers swaying with every swing.
wardrobe.item.weapon_executioner_axe = Executioner's Axe
wardrobe.item.weapon_executioner_axe.desc = A huge crescent of black iron with a notched edge.
wardrobe.item.weapon_fire_axe = Fire Axe
wardrobe.item.weapon_fire_axe.desc = A red axe with a pick spike and a yellow rubber grip.
wardrobe.item.weapon_dwarven_axe = Dwarven Battleaxe
wardrobe.item.weapon_dwarven_axe.desc = A double bit with golden runes, a stone pommel and braided leather.
wardrobe.item.weapon_crescent_axe = Crescent Moon Axe
wardrobe.item.weapon_crescent_axe.desc = A silver crescent with a star gem and a glowing edge.
wardrobe.item.weapon_bardiche = Bardiche
wardrobe.item.weapon_bardiche.desc = A long cleaver blade lashed to the haft at two rings.
wardrobe.item.weapon_butcher_cleaver = Butcher's Cleaver
wardrobe.item.weapon_butcher_cleaver.desc = A giant rectangular cleaver with a hole, rivets and a worn handle.
wardrobe.item.weapon_shark_tooth_axe = Shark Tooth Axe
wardrobe.item.weapon_shark_tooth_axe.desc = A Polynesian club-axe edged with shark teeth and carved tiki faces.
wardrobe.item.weapon_stone_axe = Stone Axe
wardrobe.item.weapon_stone_axe.desc = Knapped flint lashed with rawhide to a crooked branch.
wardrobe.item.weapon_stormbreaker = Stormbreaker
wardrobe.item.weapon_stormbreaker.desc = A sky-metal axe-hammer with lightning running along its rune.
wardrobe.item.weapon_lumberjack_axe = Lumberjack Axe
wardrobe.item.weapon_lumberjack_axe.desc = A double bit and a red plaid-wrapped grip.
wardrobe.item.weapon_jade_dragon_axe = Jade Dragon Axe
wardrobe.item.weapon_jade_dragon_axe.desc = A jade blade with a golden dragon coiling up the haft.
wardrobe.item.weapon_amethyst_axe = Amethyst Axe
wardrobe.item.weapon_amethyst_axe.desc = A blade of growing amethyst crystals on a silver haft.
wardrobe.item.weapon_soul_reaver = Soul Reaver
wardrobe.item.weapon_soul_reaver.desc = A bone haft and a spectral blade where souls moan.
wardrobe.item.weapon_epsilon_axe = Epsilon Axe
wardrobe.item.weapon_epsilon_axe.desc = A bronze Egyptian crescent on three tangs with a painted haft.
wardrobe.item.weapon_plasma_axe = Plasma Axe
wardrobe.item.weapon_plasma_axe.desc = An emitter projects a pulsing blade of blue plasma.
wardrobe.item.weapon_guitar_axe = Guitar Axe
wardrobe.item.weapon_guitar_axe.desc = A flame-painted electric guitar. Every hit is a chord.
wardrobe.item.weapon_sunforge_axe = Sunforge Axe
wardrobe.item.weapon_sunforge_axe.desc = A golden blade with a sun disc and a white-hot edge.
wardrobe.item.weapon_bat_wing_axe = Bat Wing Axe
wardrobe.item.weapon_bat_wing_axe.desc = Twin wing blades with purple membranes and crimson eyes.
wardrobe.item.weapon_celtic_axe = Celtic Axe
wardrobe.item.weapon_celtic_axe.desc = A bearded blade with a celtic knot and silver bands.
wardrobe.item.weapon_root_axe = Root Axe
wardrobe.item.weapon_root_axe.desc = A haft of twisted roots with moss, flowers and a stone blade.
wardrobe.item.weapon_pumpkin_axe = Pumpkin Axe
wardrobe.item.weapon_pumpkin_axe.desc = A carved pumpkin for a blade with a flickering candle inside.
wardrobe.item.weapon_masakari = Masakari
wardrobe.item.weapon_masakari.desc = A Japanese broad axe: black lacquer, white ito and a hamon wave.
wardrobe.item.weapon_rift_axe = Rift Axe
wardrobe.item.weapon_rift_axe.desc = The blade is a torn rift into the void, circled by shards.
wardrobe.item.weapon_ice_axe = Ice Axe
wardrobe.item.weapon_ice_axe.desc = A pick, an adze, a wrist leash and a blue climber's grip.
wardrobe.item.weapon_dory = Dory
wardrobe.item.weapon_dory.desc = A leaf-shaped head, an ash shaft and a bronze butt spike.
wardrobe.item.weapon_assegai = Assegai
wardrobe.item.weapon_assegai.desc = A short spear with a long broad blade and a cowhide binding.
wardrobe.item.weapon_guandao = Guandao
wardrobe.item.weapon_guandao.desc = A heavy curved blade from a golden dragon's jaws and a red tassel.
wardrobe.item.weapon_glaive = Glaive
wardrobe.item.weapon_glaive.desc = A single-edged curved blade on a pole with a back hook.
wardrobe.item.weapon_partisan = Partisan
wardrobe.item.weapon_partisan.desc = A broad triangular head with flukes and a blue tassel.
wardrobe.item.weapon_hades_bident = Hades' Bident
wardrobe.item.weapon_hades_bident.desc = Black prongs wreathed in the blue fire of the underworld.
wardrobe.item.weapon_war_scythe = War Scythe
wardrobe.item.weapon_war_scythe.desc = A straightened scythe blade with a skull and a wrapped shaft.
wardrobe.item.weapon_jumonji_yari = Jumonji Yari
wardrobe.item.weapon_jumonji_yari.desc = A cross-bladed Japanese spear on a lacquered shaft with white ito.
wardrobe.item.weapon_harpoon = Harpoon
wardrobe.item.weapon_harpoon.desc = A barbed whaling head and a dangling coil of rope.
wardrobe.item.weapon_pitchfork = Pitchfork
wardrobe.item.weapon_pitchfork.desc = Three tines, a wooden handle and straw stuck in them.
wardrobe.item.weapon_gungnir = Gungnir
wardrobe.item.weapon_gungnir.desc = Odin's spear with glowing runes and a raven-feather charm.
wardrobe.item.weapon_holy_lance = Holy Lance
wardrobe.item.weapon_holy_lance.desc = A white-gold lance with a winged guard and a spinning halo.
wardrobe.item.weapon_glacier_spike = Glacier Spike
wardrobe.item.weapon_glacier_spike.desc = A jagged ice spike and a frost-covered shaft.
wardrobe.item.weapon_plasma_lance = Plasma Lance
wardrobe.item.weapon_plasma_lance.desc = A pulsing plasma tip held in a magnetic emitter ring.
wardrobe.item.weapon_bone_spear = Bone Spear
wardrobe.item.weapon_bone_spear.desc = A sharpened bone head bound with sinew and a pair of feathers.
wardrobe.item.weapon_serpent_spear = Serpent Spear
wardrobe.item.weapon_serpent_spear.desc = A wavy serpentine blade and a thick crimson mane.
wardrobe.item.weapon_lotus_spear = Lotus Spear
wardrobe.item.weapon_lotus_spear.desc = A jade shaft and a guard of blooming lotus petals.
wardrobe.item.weapon_feather_spear = Feather Spear
wardrobe.item.weapon_feather_spear.desc = A flint head with beads and feathers dancing in the wind.
wardrobe.item.weapon_void_spear = Void Spear
wardrobe.item.weapon_void_spear.desc = A dark crystal tip circled by orbiting shards.
wardrobe.item.weapon_banner_spear = Banner Spear
wardrobe.item.weapon_banner_spear.desc = A crimson banner with a golden crest waves below the head.
wardrobe.item.weapon_demon_trident = Demon Trident
wardrobe.item.weapon_demon_trident.desc = Barbed black prongs with lava running through the cracks.
wardrobe.item.weapon_moon_halberd = Moon Halberd
wardrobe.item.weapon_moon_halberd.desc = A crescent blade and a star spike in a cold glow.
wardrobe.item.weapon_lantern_spear = Lantern Spear
wardrobe.item.weapon_lantern_spear.desc = A glowing paper lantern swings below the head.
wardrobe.item.weapon_crystal_spire = Crystal Spire
wardrobe.item.weapon_crystal_spire.desc = A cluster of cyan crystals for a head, glints running over the facets.
wardrobe.item.weapon_drill_lance = Drill Lance
wardrobe.item.weapon_drill_lance.desc = A jousting drill lance with a golden spiral that never stops spinning.
wardrobe.item.weapon_xbow_inferno = Inferno Crossbow
wardrobe.item.weapon_xbow_inferno.desc = Glowing ember cracks and dancing flames. A heavy steel prod with a windlass on the butt.
wardrobe.item.weapon_xbow_frost = Frost Crossbow
wardrobe.item.weapon_xbow_frost.desc = Hoarfrost, ice spikes and a cold glow. A classic stock with a foot stirrup.
wardrobe.item.weapon_xbow_void = Void Crossbow
wardrobe.item.weapon_xbow_void.desc = Black stone with void shards floating around. A curved stock that looks alive.
wardrobe.item.weapon_xbow_crown = Crown Crossbow
wardrobe.item.weapon_xbow_crown.desc = Royal gold, rubies and crown points. A classic stock with a foot stirrup.
wardrobe.item.weapon_xbow_emerald = Emerald Crossbow
wardrobe.item.weapon_xbow_emerald.desc = Faceted emeralds in a silver setting. A short pistol crossbow with a grip.
wardrobe.item.weapon_xbow_amethyst = Amethyst Crossbow
wardrobe.item.weapon_xbow_amethyst.desc = Amethyst clusters with chiming violet facets. Cams on the limb tips and cables.
wardrobe.item.weapon_xbow_storm = Storm Crossbow
wardrobe.item.weapon_xbow_storm.desc = Storm steel with lightning running along the edges. A skeletal stock, a rail and a scope.
wardrobe.item.weapon_xbow_abyss = Abyss Crossbow
wardrobe.item.weapon_xbow_abyss.desc = Deep-sea blue, pearls and rising bubbles. A classic stock with a foot stirrup.
wardrobe.item.weapon_xbow_sakura = Sakura Crossbow
wardrobe.item.weapon_xbow_sakura.desc = Pink lacquer and falling sakura petals. A short pistol crossbow with a grip.
wardrobe.item.weapon_xbow_neon = Neon Crossbow
wardrobe.item.weapon_xbow_neon.desc = Black polymer with acid neon lines. A skeletal stock, a rail and a scope.
wardrobe.item.weapon_xbow_cogwork = Cogwork Crossbow
wardrobe.item.weapon_xbow_cogwork.desc = Brass, rivets and spinning gears. A bolt magazine and a reload lever.
wardrobe.item.weapon_xbow_bone = Bone Crossbow
wardrobe.item.weapon_xbow_bone.desc = Bleached bone, skulls and a green wisp. A curved stock that looks alive.
wardrobe.item.weapon_xbow_blood = Blood Crossbow
wardrobe.item.weapon_xbow_blood.desc = Crimson steel dripping red. A heavy steel prod with a windlass on the butt.
wardrobe.item.weapon_xbow_sun = Sun Crossbow
wardrobe.item.weapon_xbow_sun.desc = White gold and the rays of the noon sun. Cams on the limb tips and cables.
wardrobe.item.weapon_xbow_moon = Moon Crossbow
wardrobe.item.weapon_xbow_moon.desc = Silver, a crescent and twinkling stars. A classic stock with a foot stirrup.
wardrobe.item.weapon_xbow_nether = Nether Crossbow
wardrobe.item.weapon_xbow_nether.desc = Crimson fungi, netherite and smouldering lava. A heavy steel prod with a windlass on the butt.
wardrobe.item.weapon_xbow_ender = Ender Crossbow
wardrobe.item.weapon_xbow_ender.desc = End stone, ender eyes and violet sparks. A bolt magazine and a reload lever.
wardrobe.item.weapon_xbow_candy = Candy Crossbow
wardrobe.item.weapon_xbow_candy.desc = Candy stripes and sugar glaze. A short pistol crossbow with a grip.
wardrobe.item.weapon_xbow_toxin = Toxin Crossbow
wardrobe.item.weapon_xbow_toxin.desc = Poison-green slime, drips and bubbles. A bolt magazine and a reload lever.
wardrobe.item.weapon_xbow_jungle = Jungle Crossbow
wardrobe.item.weapon_xbow_jungle.desc = Living vines, leaves and moss. A classic stock with a foot stirrup.
wardrobe.item.weapon_xbow_pharaoh = Pharaoh Crossbow
wardrobe.item.weapon_xbow_pharaoh.desc = Sandstone, lapis and golden ankhs. A skeletal stock, a rail and a scope.
wardrobe.item.weapon_xbow_rune = Rune Crossbow
wardrobe.item.weapon_xbow_rune.desc = Northern iron and glowing runes. A heavy steel prod with a windlass on the butt.
wardrobe.item.weapon_xbow_galaxy = Galaxy Crossbow
wardrobe.item.weapon_xbow_galaxy.desc = Cosmic blue sprinkled with stardust. Cams on the limb tips and cables.
wardrobe.item.weapon_xbow_obsidian = Obsidian Crossbow
wardrobe.item.weapon_xbow_obsidian.desc = Volcanic glass with razor edges. A curved stock that looks alive.
wardrobe.item.weapon_xbow_prismarine = Prismarine Crossbow
wardrobe.item.weapon_xbow_prismarine.desc = Prismarine, sea lanterns and scales. Two prods stacked one above the other.
wardrobe.item.weapon_xbow_dragon = Dragon Crossbow
wardrobe.item.weapon_xbow_dragon.desc = Dragon scales, horns and a fiery eye. A curved stock that looks alive.
wardrobe.item.weapon_xbow_angel = Angel Crossbow
wardrobe.item.weapon_xbow_angel.desc = White feathers, a halo and soft light. Two prods stacked one above the other.
wardrobe.item.weapon_xbow_demon = Demon Crossbow
wardrobe.item.weapon_xbow_demon.desc = Black horns, membranes and hellish heat. A bolt magazine and a reload lever.
wardrobe.item.weapon_xbow_ruby = Ruby Crossbow
wardrobe.item.weapon_xbow_ruby.desc = Deep ruby in a cabochon cut. A short pistol crossbow with a grip.
wardrobe.item.weapon_xbow_sapphire = Sapphire Crossbow
wardrobe.item.weapon_xbow_sapphire.desc = Sapphire facets and cold platinum shine. Two prods stacked one above the other.
wardrobe.item.weapon_xbow_copper = Copper Crossbow
wardrobe.item.weapon_xbow_copper.desc = Copper in a turquoise patina. A bolt magazine and a reload lever.
wardrobe.item.weapon_xbow_glitch = Glitch Crossbow
wardrobe.item.weapon_xbow_glitch.desc = Pixels slip and jitter like a corrupted file. A skeletal stock, a rail and a scope.
wardrobe.item.weapon_xbow_rainbow = Rainbow Crossbow
wardrobe.item.weapon_xbow_rainbow.desc = Every colour of the rainbow shimmers on the facets. Two prods stacked one above the other.
