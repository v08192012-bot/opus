module.autoDodge.desc = Dodges incoming splash potions by eating dried kelp right before impact
module.potionThrower.description = Throws server potions by keybind or wheel
module.potionThrower.mode = Mode
module.potionThrower.mode.desc = How to pick a potion
module.potionThrower.modeWheel = Wheel
module.potionThrower.modeKeys = Keybinds
module.potionThrower.wheelBind = Open wheel
module.potionThrower.wheelBind.desc = Hold, hover a potion and release
module.potionThrower.drawRadius = Show radius
module.potionThrower.drawRadius.desc = Circle of the distance an enemy must be within
module.potionThrower.title = Potions
module.potionThrower.hint = Hover the potion you need
module.potionThrower.release = Release to throw
module.potionThrower.missing = Not in inventory
module.potionThrower.noTarget = Nobody nearby
module.potionThrower.radiation = Radiation Potion
