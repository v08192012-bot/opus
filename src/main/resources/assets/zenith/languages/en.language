module.crystalaura.description = Places and detonates end crystals and respawn anchors: vanilla-accurate damage with armor, enchantments and difficulty, target movement prediction, timings tuned to the preset's anticheat
module.crystalAura.preset = Preset
module.crystalAura.preset.desc = Ready settings for the server's anticheat, Custom unlocks every parameter
module.crystalAura.presetCustom = Custom
module.crystalAura.presetNone = No anticheat
module.crystalAura.targetRange = Target range
module.crystalAura.targetRange.desc = How far to look for enemies
module.crystalAura.minDamage = Min damage
module.crystalAura.minDamage.desc = Crystals dealing less damage to the target are skipped
module.crystalAura.maxSelfDamage = Max self damage
module.crystalAura.maxSelfDamage.desc = Self damage above this is never allowed unless it kills
module.crystalAura.faceplace = Faceplace
module.crystalAura.faceplace.desc = At this target health the minimum damage drops to 2
module.crystalAura.predictTicks = Predict ticks
module.crystalAura.predictTicks.desc = How many ticks ahead to predict target movement, ping is added automatically
module.crystalAura.features = Features
module.crystalAura.features.desc = What the aura does besides crystals
module.crystalAura.anchors = Anchors
module.crystalAura.autoObsidian = Auto obsidian
module.crystalAura.autoDig = Auto dig
module.crystalAura.fromInventory = From inventory
module.crystalAura.shield = Auto defense
module.crystalAura.antiWeakness = Anti weakness
module.crystalAura.antiSuicide = Anti suicide
module.crystalAura.pauseOnUse = Pause on eat
module.crystalAura.render = Render
module.crystalAura.knockup = Sword knock-up
module.crystalAura.cityMine = Mine surround
module.crystalAura.bomber = Bomber
module.crystalAura.antiTotem = Anti totem
module.crystalAura.fallback = Clear blockers
module.crystalAura.slowPlace = Slow on low damage
module.crystalAura.explosionSync = Explosion sync
module.crystalAura.combatLog = Combat log
module.crystalAura.antiMine = Anti mine
module.crystalAura.crystalDefense = Crystal defense
module.crystalAura.webTrap = Web trap
module.crystalAura.surroundKey = Surround (bind)
module.crystalAura.surroundKey.desc = On press, places obsidian in the 4 cells around your feet (adding support if needed) before any other aura action. Cancels if you leave the block or after 3 s.
module.crystalAura.surroundMode = What to build
module.crystalAura.surroundMode.desc = Surround bind preset: normal — 4 obsidian at the feet; double — plus 4 at head level (vs face crystals); anti-city — plus 4 outer cells (a mined surround block won’t expose a crystal spot); bunker — feet, head, above and below
module.crystalAura.surroundNormal = Normal (4)
module.crystalAura.surroundDouble = Double (8)
module.crystalAura.surroundCity = Anti-city (8)
module.crystalAura.surroundBunker = Bunker (10)
module.crystalAura.mineDamage = Mine damage
module.crystalAura.mineDamage.desc = Long mining (city, bomber, undermining a crystal) only for this much damage
module.crystalAura.mineTime = Max mine time
module.crystalAura.mineTime.desc = Blocks that take longer to mine with the best tool are left alone
module.crystalAura.shieldDamage = Defense threshold
module.crystalAura.shieldDamage.desc = Block spots an enemy could hit us from for more than this
module.crystalAura.mode = Mode
module.crystalAura.mode.desc = Vanilla rotates on one tick and acts on the next; ReallyWorld acts right after the rotation is sent
module.crystalAura.placeRange = Place range
module.crystalAura.placeRange.desc = Maximum placement distance
module.crystalAura.breakRange = Break range
module.crystalAura.breakRange.desc = Maximum crystal hit distance
module.crystalAura.actions = Actions per tick
module.crystalAura.actions.desc = How many placements and hits may be sent in one tick
module.crystalAura.placeDelay = Place delay
module.crystalAura.placeDelay.desc = Pause between placements
module.crystalAura.breakDelay = Break delay
module.crystalAura.breakDelay.desc = Pause between crystal hits
module.crystalAura.rotationSpeed = Rotation speed
module.crystalAura.rotationSpeed.desc = Maximum rotation per tick, 180 is instant
module.crystalAura.swap = Swap
module.crystalAura.swap.desc = How to take items from the hotbar
module.crystalAura.swapKeep = Keep
module.crystalAura.swapSilent = Silent
module.crystalAura.swapOff = Off
module.crystalAura.instantBreak = Instant break
module.crystalAura.instantBreak.desc = Hits a crystal the moment it spawns
module.crystalAura.instantPlace = Instant place
module.crystalAura.instantPlace.desc = Places the next crystal on the same base right after the hit
module.crystalAura.varyRotation = Vary rotation
module.crystalAura.varyRotation.desc = Never places twice with the exact same rotation
module.crystalAura.throughWalls = Through walls
module.crystalAura.throughWalls.desc = Allows hitting crystals without line of sight
module.autotrap.description = Catches the target where it is heading: predicted cobwebs or powder snow, then finishes the stuck target with lava, fire and an anvil. Aims by itself and swaps slots silently.
module.autoTrap.activation = Activation
module.autoTrap.activation.desc = When the module places traps
module.autoTrap.activationAlways = Always
module.autoTrap.activationBind = On bind
