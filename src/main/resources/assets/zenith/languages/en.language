gui.friends.mcName.desc = The Minecraft nickname they were seen under.
gui.friends.uid = Account id
gui.friends.uid.desc = The client fetches the avatar from the site by it.
gui.friends.health = Health
gui.friends.food = Food
gui.friends.distance = Distance
gui.friends.distance.desc = Distance to your friend in your world.
gui.friends.cosmetics = Cosmetics
gui.friends.cosmetics.items = items
gui.friends.cosmetics.desc = How many cosmetic items they are wearing.
gui.friends.write = Message
gui.friends.write.value = in friends chat
gui.friends.write.desc = The node has no private messages: it broadcasts either to everyone or to mutual friends. The button opens the friends feed.
gui.friends.notify = Notifications
gui.friends.notify.desc = Whether you get a message when they come and go.
gui.friends.block = Block
gui.friends.block.on = blocked
gui.friends.block.desc = Hides their messages and their marker in the world. It does not break the friendship and they cannot see it.
gui.friends.remove = Remove
gui.friends.remove.value = from friends
gui.friends.remove.fromList = from the list
gui.friends.remove.desc = Removes the friend from the cloud: the node stops sending their state to either of you.
gui.friends.remove.local.desc = Removes the local record.
gui.friends.cancelRequest = Cancel request
gui.friends.cancelRequest.value = request
gui.friends.cancelRequest.desc = Drops the request so the node stops keeping it.
gui.friends.storedIn = Stored in
gui.friends.storedIn.value = this client only
gui.friends.storedIn.desc = This friend was created by the client itself, like .friend add. The cloud knows nothing about them.
gui.friends.near = Nearby
gui.friends.near.desc = Whether a player with this name is in your current world.
gui.friends.invite = Invite to the cloud
