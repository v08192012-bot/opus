wardrobe.item.item_gapple_sapphire.desc = Szafirowe ścianki i chłodny blask platyny. Oszlifowane jak klejnot.
wardrobe.item.item_gapple_copper = Złote jabłko „Miedź”
wardrobe.item.item_gapple_copper.desc = Miedź w turkusowej patynie. Wydłużone jabłko na długiej szypułce.
wardrobe.item.item_gapple_glitch = Złote jabłko „Glitch”
wardrobe.item.item_gapple_glitch.desc = Piksele rozjeżdżają się i drżą jak uszkodzony plik. Sześcienne jabłko o gładkich ściankach.
wardrobe.item.item_gapple_rainbow = Złote jabłko „Tęcza”
wardrobe.item.item_gapple_rainbow.desc = Wszystkie kolory tęczy mienią się na ściankach. Okrągłe jabłko z listkiem.
wardrobe.item.item_egapple_inferno = Zaklęte jabłko „Inferno”
wardrobe.item.item_egapple_inferno.desc = Rozżarzone pęknięcia i tańczące płomienie. Wokół krąży pierścień zaklęć.
wardrobe.item.item_egapple_frost = Zaklęte jabłko „Szron”
wardrobe.item.item_egapple_frost.desc = Szron, lodowe kolce i chłodny blask. Runy zaklęć powoli wirują wokół.
wardrobe.item.item_egapple_void = Zaklęte jabłko „Pustka”
wardrobe.item.item_egapple_void.desc = Czarny kamień, wokół unoszą się odłamki pustki. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_crown = Zaklęte jabłko „Korona”
wardrobe.item.item_egapple_crown.desc = Królewskie złoto, rubiny i blanki korony. Nad nim unosi się świecąca korona.
wardrobe.item.item_egapple_emerald = Zaklęte jabłko „Szmaragd”
wardrobe.item.item_egapple_emerald.desc = Szlifowane szmaragdy w srebrnej oprawie. Wokół krąży pierścień zaklęć.
wardrobe.item.item_egapple_amethyst = Zaklęte jabłko „Ametyst”
wardrobe.item.item_egapple_amethyst.desc = Druzy ametystu i dźwięczne fioletowe ścianki. Runy zaklęć powoli wirują wokół.
wardrobe.item.item_egapple_storm = Zaklęte jabłko „Burza”
wardrobe.item.item_egapple_storm.desc = Burzowa stal, po krawędziach biegną błyskawice. Wokół krąży pierścień zaklęć.
wardrobe.item.item_egapple_abyss = Zaklęte jabłko „Otchłań”
wardrobe.item.item_egapple_abyss.desc = Głębinowy błękit, perły i bąbelki. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_sakura = Zaklęte jabłko „Sakura”
wardrobe.item.item_egapple_sakura.desc = Różowa laka i opadające płatki sakury. Małe skrzydła utrzymują je w powietrzu.
wardrobe.item.item_egapple_neon = Zaklęte jabłko „Neon”
wardrobe.item.item_egapple_neon.desc = Czarny polimer i kwasowe neonowe linie. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_cogwork = Zaklęte jabłko „Zębatka”
wardrobe.item.item_egapple_cogwork.desc = Mosiądz, nity i obracające się zębatki. Nad nim unosi się świecąca korona.
wardrobe.item.item_egapple_bone = Zaklęte jabłko „Kość”
wardrobe.item.item_egapple_bone.desc = Wybielona kość, czaszki i zielony ognik. Małe skrzydła utrzymują je w powietrzu.
wardrobe.item.item_egapple_blood = Zaklęte jabłko „Krew”
wardrobe.item.item_egapple_blood.desc = Szkarłatna stal ociekająca czerwienią. Runy zaklęć powoli wirują wokół.
wardrobe.item.item_egapple_sun = Zaklęte jabłko „Słońce”
wardrobe.item.item_egapple_sun.desc = Białe złoto i promienie południowego słońca. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_moon = Zaklęte jabłko „Księżyc”
wardrobe.item.item_egapple_moon.desc = Srebro, półksiężyc i migoczące gwiazdy. Nad nim unosi się świecąca korona.
wardrobe.item.item_egapple_nether = Zaklęte jabłko „Nether”
wardrobe.item.item_egapple_nether.desc = Szkarłatne grzyby, netheryt i tląca się lawa. Wokół krąży pierścień zaklęć.
wardrobe.item.item_egapple_ender = Zaklęte jabłko „Ender”
wardrobe.item.item_egapple_ender.desc = Kamień Kresu, oczy Kresu i fioletowe iskry. Runy zaklęć powoli wirują wokół.
wardrobe.item.item_egapple_candy = Zaklęte jabłko „Cukierek”
wardrobe.item.item_egapple_candy.desc = Cukierkowe paski i lukier. Małe skrzydła utrzymują je w powietrzu.
wardrobe.item.item_egapple_toxin = Zaklęte jabłko „Toksyna”
wardrobe.item.item_egapple_toxin.desc = Trująco zielony szlam, krople i bąble. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_jungle = Zaklęte jabłko „Dżungla”
wardrobe.item.item_egapple_jungle.desc = Żywe pnącza, liście i mech. Małe skrzydła utrzymują je w powietrzu.
wardrobe.item.item_egapple_pharaoh = Zaklęte jabłko „Faraon”
wardrobe.item.item_egapple_pharaoh.desc = Piaskowiec, lapis i złote anchy. Nad nim unosi się świecąca korona.
wardrobe.item.item_egapple_rune = Zaklęte jabłko „Runa”
wardrobe.item.item_egapple_rune.desc = Północne żelazo i świecące runy. Runy zaklęć powoli wirują wokół.
wardrobe.item.item_egapple_galaxy = Zaklęte jabłko „Galaktyka”
wardrobe.item.item_egapple_galaxy.desc = Kosmiczny błękit w gwiezdnym pyle. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_obsidian = Zaklęte jabłko „Obsydian”
wardrobe.item.item_egapple_obsidian.desc = Wulkaniczne szkło o ostrych krawędziach. Wokół krąży pierścień zaklęć.
wardrobe.item.item_egapple_prismarine = Zaklęte jabłko „Pryzmaryn”
wardrobe.item.item_egapple_prismarine.desc = Pryzmaryn, latarnie morskie i łuski. Runy zaklęć powoli wirują wokół.
wardrobe.item.item_egapple_dragon = Zaklęte jabłko „Smok”
wardrobe.item.item_egapple_dragon.desc = Smocze łuski, rogi i ogniste oko. Małe skrzydła utrzymują je w powietrzu.
wardrobe.item.item_egapple_angel = Zaklęte jabłko „Anioł”
wardrobe.item.item_egapple_angel.desc = Białe pióra, aureola i miękkie światło. Małe skrzydła utrzymują je w powietrzu.
wardrobe.item.item_egapple_demon = Zaklęte jabłko „Demon”
wardrobe.item.item_egapple_demon.desc = Czarne rogi, błony i piekielny żar. Nad nim unosi się świecąca korona.
wardrobe.item.item_egapple_ruby = Zaklęte jabłko „Rubin”
wardrobe.item.item_egapple_ruby.desc = Głęboki rubin w szlifie kaboszonowym. Nad nim unosi się świecąca korona.
wardrobe.item.item_egapple_sapphire = Zaklęte jabłko „Szafir”
wardrobe.item.item_egapple_sapphire.desc = Szafirowe ścianki i chłodny blask platyny. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_copper = Zaklęte jabłko „Miedź”
wardrobe.item.item_egapple_copper.desc = Miedź w turkusowej patynie. Runy zaklęć powoli wirują wokół.
wardrobe.item.item_egapple_glitch = Zaklęte jabłko „Glitch”
wardrobe.item.item_egapple_glitch.desc = Piksele rozjeżdżają się i drżą jak uszkodzony plik. Podwójna aureola mieni się magią.
wardrobe.item.item_egapple_rainbow = Zaklęte jabłko „Tęcza”
wardrobe.item.item_egapple_rainbow.desc = Wszystkie kolory tęczy mienią się na ściankach. Małe skrzydła utrzymują je w powietrzu.
wardrobe.item.item_totem_inferno = Totem „Inferno”
wardrobe.item.item_totem_inferno.desc = Rozżarzone pęknięcia i tańczące płomienie. Rogi, kły i ogon.
wardrobe.item.item_totem_frost = Totem „Szron”
wardrobe.item.item_totem_frost.desc = Szron, lodowe kolce i chłodny blask. Za plecami rozpostarte skrzydła.
wardrobe.item.item_totem_void = Totem „Pustka”
wardrobe.item.item_totem_void.desc = Czarny kamień, wokół unoszą się odłamki pustki. Kaptur, szata i laska strażnika.
wardrobe.item.item_totem_crown = Totem „Korona”
wardrobe.item.item_totem_crown.desc = Królewskie złoto, rubiny i blanki korony. Korona i ciężki kołnierz.
wardrobe.item.item_totem_emerald = Totem „Szmaragd”
wardrobe.item.item_totem_emerald.desc = Szlifowane szmaragdy w srebrnej oprawie. Rozłożone ręce i świecące oczy.
wardrobe.item.item_totem_amethyst = Totem „Ametyst”
wardrobe.item.item_totem_amethyst.desc = Druzy ametystu i dźwięczne fioletowe ścianki. Kaptur, szata i laska strażnika.
wardrobe.item.item_totem_storm = Totem „Burza”
wardrobe.item.item_totem_storm.desc = Burzowa stal, po krawędziach biegną błyskawice. Za plecami rozpostarte skrzydła.
