module.crystalAura.instantPlace = Natychmiastowe stawianie
module.crystalAura.instantPlace.desc = Zaraz po uderzeniu stawia nowy kryształ na tej samej bazie
module.crystalAura.varyRotation = Zmieniaj obrót
module.crystalAura.varyRotation.desc = Nigdy nie stawia dwa razy z tym samym obrotem
module.crystalAura.throughWalls = Przez ściany
module.crystalAura.throughWalls.desc = Pozwala uderzać kryształy bez widoczności
module.autotrap.description = Łapie cel tam, dokąd zmierza: pajęczyna lub sypki śnieg według predykcji, a uwięziony cel dobija lawą, ogniem i kowadłem. Sam celuje i po cichu zmienia slot.
