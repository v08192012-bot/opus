module.autoMace.holdAura = Wstrzymaj cios
module.autoMace.holdAura.desc = Nie pozwala Aurze bić wcześniej, jeśli cel według predykcji będzie w zasięgu w ostatnim ticku upadku
module.autoMace.fullCooldown = Pełny cooldown
module.autoMace.fullCooldown.desc = W ostatnim ticku upadku lokalnie ustawia pełny cooldown, żeby Aura uderzyła
module.autoMace.swapBack = Wróć do slotu
module.autoMace.swapBack.desc = Po wylądowaniu wraca do slotu sprzed buzdyganu
