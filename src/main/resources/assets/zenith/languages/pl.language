wardrobe.item.pet_ember_fox = Ognisty Lisek
wardrobe.item.pet_ember_fox.desc = Ogon jak żarzący się węgielek, kicha iskrami i drzemie, gdy stoisz.
wardrobe.item.back_jetpack_comet = Plecak odrzutowy „Kometa”
wardrobe.item.back_jetpack_comet.desc = Dysze zapalają się w powietrzu, płetwy rozkładają się w locie.
wardrobe.item.char_samurai_wanderer = Wędrowny Samuraj
wardrobe.item.char_samurai_wanderer.desc = Słomkowy kapelusz, miecz na plecach i płatki sakury w ciszy.
wardrobe.item.weapon_wanderer_katana = Katana Wędrowca
wardrobe.item.weapon_wanderer_katana.desc = Zakrzywione ostrze o lśniącej krawędzi. Cios zostawia wir płatków.
wardrobe.item.pet_mini_dragon = Mini Smok
wardrobe.item.pet_mini_dragon.desc = Unosi się przy ramieniu i puszcza kółka z dymu.
wardrobe.item.pet_firefly_spirit = Duch Świetlika
wardrobe.item.pet_firefly_spirit.desc = Świeci w ciemności i tańczy z iskierkami.
wardrobe.item.pet_robot_ball = Robo-Kulka
wardrobe.item.pet_robot_ball.desc = Skacze za tobą i skanuje okolicę iskrzącą wiązką.
wardrobe.item.pet_ghost_cat = Kot-Widmo
wardrobe.item.pet_ghost_cat.desc = Półprzezroczysty, mruczy i czasem znika w powietrzu.
wardrobe.item.pet_crystal_turtle = Kryształowy Żółw
wardrobe.item.pet_crystal_turtle.desc = Chowa się w lśniącą skorupę, gdy w pobliżu jest zagrożenie.
wardrobe.item.pet_cloud_sheep = Chmurkowa Owieczka
wardrobe.item.pet_cloud_sheep.desc = Płynie w powietrzu i czasem robi mały deszczyk.
wardrobe.item.pet_mushroom_buddy = Grzybek
wardrobe.item.pet_mushroom_buddy.desc = Tupta obok i kłania się, rozsypując zarodniki.
wardrobe.item.pet_mech_owl = Mechaniczna Sowa
wardrobe.item.pet_mech_owl.desc = Mosiężna sowa z oczami-soczewkami, kręci głową dookoła.
wardrobe.item.pet_slime = Szlamik
wardrobe.item.pet_slime.desc = Skoczny glucik, czasem wybija się bardzo wysoko.
wardrobe.item.pet_shadow_raven = Kruk Cienia
wardrobe.item.pet_shadow_raven.desc = Zostaje w tyle, a potem pojawia się w chmurze cienia.
wardrobe.item.pet_sea_octopus = Ośmiorniczka
wardrobe.item.pet_sea_octopus.desc = Puszcza bąbelki i tryska atramentem, gdy oberwiesz.
wardrobe.item.pet_star_bunny = Gwiezdny Króliczek
wardrobe.item.pet_star_bunny.desc = Łapie spadające gwiazdy i zostawia świetlisty ślad.
wardrobe.item.pet_golem_pup = Mały Golem
wardrobe.item.pet_golem_pup.desc = Kamienny maluch z runą, czasem wręcza ci kwiatek.
wardrobe.item.pet_pumpkin_lantern = Dyniowa Latarenka
wardrobe.item.pet_pumpkin_lantern.desc = Skacze za tobą, świeci od środka i upiornie się szczerzy.
wardrobe.item.pet_teddy_bear = Pluszowy Miś
wardrobe.item.pet_teddy_bear.desc = Człapie obok, macha łapką i czasem przybiega się przytulić.
wardrobe.item.head_gentleman_tophat = Cylinder z monoklem
wardrobe.item.head_gentleman_tophat.desc = Aksamitna wstążka i złoty monokl na łańcuszku.
wardrobe.item.body_gentleman_tailcoat = Frak dżentelmena
wardrobe.item.body_gentleman_tailcoat.desc = Muszka, spinki i poły, które kołyszą się przy chodzie.
wardrobe.item.legs_gentleman_trousers = Spodnie w prążki i oksfordy
wardrobe.item.legs_gentleman_trousers.desc = Wełniane spodnie i wypolerowane buty.
wardrobe.item.back_gentleman_umbrella = Parasol-laska
wardrobe.item.back_gentleman_umbrella.desc = Złożony parasol ze złotą rączką na plecach.
wardrobe.item.head_cyber_visor = Cyber-wizjer
wardrobe.item.head_cyber_visor.desc = Neonowy wizjer ze słuchawkami i anteną.
wardrobe.item.body_cyber_jacket = Neonowa kurtka
wardrobe.item.body_cyber_jacket.desc = Skóra, płyty pancerza i świecące szwy.
wardrobe.item.legs_cyber_pants = Spodnie techwear
wardrobe.item.legs_cyber_pants.desc = Paski, świecące nakolanniki i neonowe podeszwy.
wardrobe.item.back_cyber_pack = Holo-plecak
wardrobe.item.back_cyber_pack.desc = Nad ramieniem kręci się hologram, ekran migocze.
wardrobe.item.head_knight_helm = Hełm rycerza
wardrobe.item.head_knight_helm.desc = Hełm garnczkowy ze złotym grzebieniem i pióropuszem.
wardrobe.item.body_knight_armor = Zbroja krzyżowca
wardrobe.item.body_knight_armor.desc = Kirys, naramienniki i wams, który faluje przy chodzie.
wardrobe.item.legs_knight_greaves = Nagolenniki i trzewiki
wardrobe.item.legs_knight_greaves.desc = Kolczuga na udach i stalowe nagolenniki.
wardrobe.item.back_knight_shield = Tarcza herbowa
wardrobe.item.back_knight_shield.desc = Tarcza heraldyczna przypięta do pleców.
wardrobe.item.head_pirate_tricorne = Trójgraniasty kapelusz
wardrobe.item.head_pirate_tricorne.desc = Czaszka na główce i pióro tańczące na wietrze.
wardrobe.item.body_pirate_coat = Kaftan kapitana
wardrobe.item.body_pirate_coat.desc = Długi szkarłatny kaftan ze złotem i szerokimi mankietami.
wardrobe.item.legs_pirate_boots = Buty morskie
wardrobe.item.legs_pirate_boots.desc = Wysokie buty z wywinięciem i klamrami.
wardrobe.item.back_pirate_parrot = Papuga na ramieniu
wardrobe.item.back_pirate_parrot.desc = Kiwa głową, stroszy pióra i macha skrzydłami w skoku.
wardrobe.item.head_ninja_hood = Kaptur ninja
wardrobe.item.head_ninja_hood.desc = Zakrywa twarz poza oczami; końce opaski powiewają.
wardrobe.item.body_ninja_garb = Strój ninja
wardrobe.item.body_ninja_garb.desc = Ciemne gi, szarfa i stalowy naramiennik.
wardrobe.item.legs_ninja_tabi = Owijacze i tabi
wardrobe.item.legs_ninja_tabi.desc = Obandażowane łydki i tabi z rozdzielonym palcem.
wardrobe.item.back_ninja_blades = Bliźniacze ostrza
wardrobe.item.back_ninja_blades.desc = Dwa krótkie miecze skrzyżowane na plecach.
wardrobe.item.head_royal_crown = Korona królewska
wardrobe.item.head_royal_crown.desc = Złoto, rubiny i gronostaje. Migocze iskierkami.
wardrobe.item.head_neon_headphones = Neonowe słuchawki
wardrobe.item.head_neon_headphones.desc = Świecące muszle, mikrofon i nuty w powietrzu.
wardrobe.item.head_oni_mask = Maska oni
wardrobe.item.head_oni_mask.desc = Lakierowana maska demona noszona z boku.
wardrobe.item.head_wizard_hat = Kapelusz czarodzieja
wardrobe.item.head_wizard_hat.desc = Gwiaździsty kapelusz z zagiętym świecącym czubkiem.
wardrobe.item.head_viking_helm = Hełm wikinga
wardrobe.item.head_viking_helm.desc = Żelazny hełm z nosalem i zakrzywionymi rogami.
wardrobe.item.body_bomber_jacket = Kurtka bomberka
wardrobe.item.body_bomber_jacket.desc = Skórzana kurtka z futrzanym kołnierzem i naszywką.
wardrobe.item.body_tactical_vest = Kamizelka taktyczna
wardrobe.item.body_tactical_vest.desc = Nosnik płyt z ładownicami i naszywką.
wardrobe.item.body_arcane_robe = Szata arcymaga
wardrobe.item.body_arcane_robe.desc = Długa szata z runami, której poły falują przy chodzie.
wardrobe.item.body_winter_parka = Parka zimowa
wardrobe.item.body_winter_parka.desc = Ciepła kurtka z futrem i opuszczonym kapturem.
wardrobe.item.body_varsity_hoodie = Bluza z numerem
wardrobe.item.body_varsity_hoodie.desc = Bluza z kapturem, sznurkami i numerem na plecach.
wardrobe.item.legs_cargo_pants = Bojówki i trampki
wardrobe.item.legs_cargo_pants.desc = Spodnie z kieszeniami i białe trampki.
wardrobe.item.legs_ripped_jeans = Podarte dżinsy
wardrobe.item.legs_ripped_jeans.desc = Dżinsy z dziurami na kolanach i wysokie trampki.
wardrobe.item.legs_cowboy_chaps = Czapsy i buty z ostrogami
wardrobe.item.legs_cowboy_chaps.desc = Skórzane czapsy i kowbojki z ostrogami.
wardrobe.item.legs_moon_boots = Księżycowe buty
wardrobe.item.legs_moon_boots.desc = Spodnie skafandra i masywne podświetlane buty.
wardrobe.item.legs_frost_greaves = Lodowe nagolenniki
wardrobe.item.legs_frost_greaves.desc = Nagolenniki z wiecznego lodu sypiące śniegiem.
wardrobe.item.back_angel_wings = Skrzydła anioła
wardrobe.item.back_angel_wings.desc = Białe skrzydła ze świecącymi końcami, machają w locie.
wardrobe.item.back_dragon_wings = Smocze skrzydła
wardrobe.item.back_dragon_wings.desc = Błoniaste skrzydła z pazurami, tlą się w powietrzu.
wardrobe.item.back_explorer_pack = Plecak odkrywcy
wardrobe.item.back_explorer_pack.desc = Śpiwór, kieszenie i latarnia, która się kołysze.
wardrobe.item.back_hunter_quiver = Kołczan łowcy
wardrobe.item.back_hunter_quiver.desc = Skórzany kołczan pełen strzał na ramieniu.
wardrobe.item.char_magical_girl = Czarodziejka
wardrobe.item.char_magical_girl.desc = Różowe kucyki, falbaniasta spódnica i gwiezdny pył.
wardrobe.item.char_space_hunter = Łowca kosmosu
wardrobe.item.char_space_hunter.desc = Pancerz z wizjerem i działo na ramieniu, które iskrzy.
wardrobe.item.char_necromancer = Nekromanta
wardrobe.item.char_necromancer.desc = Kaptur, kości i zielony ogień w oczach.
wardrobe.item.char_cyber_ninja = Cyber-ninja
wardrobe.item.char_cyber_ninja.desc = Neonowe szwy, świetlne ostrze na plecach, czerwony szal.
wardrobe.item.char_pirate_captain = Kapitan piratów
wardrobe.item.char_pirate_captain.desc = Broda, przepaska na oku i hak zamiast dłoni.
wardrobe.item.char_paladin = Paladyn
wardrobe.item.char_paladin.desc = Złota zbroja, biała peleryna i wirująca aureola.
wardrobe.item.char_vampire_aristocrat = Wampir arystokrata
wardrobe.item.char_vampire_aristocrat.desc = Blada skóra, szkarłatne oczy i peleryna z kołnierzem.
wardrobe.item.char_steampunk_mechanic = Mechanik steampunk
wardrobe.item.char_steampunk_mechanic.desc = Gogle, fartuch i mosiężna proteza z zębatką.
wardrobe.item.char_forest_elf = Leśna elfka
wardrobe.item.char_forest_elf.desc = Szpiczaste uszy, długie włosy i płaszcz z liści.
wardrobe.item.char_demon_berserker = Demon berserker
wardrobe.item.char_demon_berserker.desc = Rogi, futro i świecące pęknięcia magmy.
wardrobe.item.char_elemental_lord = Władca żywiołów
wardrobe.item.char_elemental_lord.desc = Wokół krążą kule ognia, wody, ziemi i powietrza.
wardrobe.item.char_suit_agent = Agent w garniturze
wardrobe.item.char_suit_agent.desc = Czarny garnitur, ciemne okulary i słuchawka.
wardrobe.item.char_rock_star = Gwiazda rocka
wardrobe.item.char_rock_star.desc = Irokez, ćwiekowana ramoneska i gitara na plecach.
wardrobe.item.char_mech_pilot = Pilot mecha
wardrobe.item.char_mech_pilot.desc = Kombinezon, hełm z wizjerem i plecak.
wardrobe.item.char_ice_witch = Lodowa wiedźma
wardrobe.item.char_ice_witch.desc = Lodowa korona, długa suknia i zamieć wokół.
wardrobe.item.char_desert_nomad = Koczownik pustyni
wardrobe.item.char_desert_nomad.desc = Turban, zasłonięta twarz i sztylet przy pasie.
wardrobe.item.char_deep_sea_diver = Nurek głębinowy
wardrobe.item.char_deep_sea_diver.desc = Mosiężny hełm z bulajami i bąbelki powietrza.
wardrobe.item.char_plague_doctor = Doktor dżumy
wardrobe.item.char_plague_doctor.desc = Maska z dziobem, kapelusz i złowrogie zarodniki.
wardrobe.item.char_astronaut = Astronauta
wardrobe.item.char_astronaut.desc = Skafander ze złotym wizjerem i migającym panelem.
wardrobe.item.char_gladiator = Gladiator
wardrobe.item.char_gladiator.desc = Brązowy hełm z grzebieniem i skórzana zbroja.
wardrobe.item.char_druid = Druid
wardrobe.item.char_druid.desc = Poroże, kora i mech, wokół latają świetliki.
wardrobe.item.char_clockwork_android = Mechaniczny android
wardrobe.item.char_clockwork_android.desc = Stal, mosiądz i bijące świecące serce.
wardrobe.item.char_abyss_knight = Rycerz Otchłani
wardrobe.item.char_abyss_knight.desc = Kolczasta zbroja z fioletowymi runami i aurą portalu.
wardrobe.item.char_shaolin_monk = Mnich Shaolin
wardrobe.item.char_shaolin_monk.desc = Pomarańczowe szaty, różaniec i medytacyjna postawa.
wardrobe.item.weapon_knight_longsword = Miecz krzyżowca
wardrobe.item.weapon_knight_longsword.desc = Długie ostrze z żłobkiem i złotym jelcem. Pasuje do zestawu Rycerza.
wardrobe.item.weapon_cyber_blade = Ostrze plazmowe
wardrobe.item.weapon_cyber_blade.desc = Migoczący promień plazmy. Pasuje do Cyberpunka i Cyber-ninja.
wardrobe.item.weapon_pirate_cutlass = Kordelas abordażowy
wardrobe.item.weapon_pirate_cutlass.desc = Szerokie zakrzywione ostrze z mosiężnym kabłąkiem.
wardrobe.item.weapon_frost_brand = Ostrze mrozu
wardrobe.item.weapon_frost_brand.desc = Kryształowy miecz sypiący płatkami śniegu. Pasuje do Lodowej wiedźmy.
wardrobe.item.weapon_viking_axe = Topór brodaty
wardrobe.item.weapon_viking_axe.desc = Północny topór z nitowanym ostrzem.
wardrobe.item.weapon_berserker_axe = Topór berserkera
wardrobe.item.weapon_berserker_axe.desc = Podwójne ostrze z rozżarzoną krawędzią. Pasuje do Demona-berserkera.
wardrobe.item.weapon_gear_axe = Topór zębatkowy
wardrobe.item.weapon_gear_axe.desc = Mosiężny topór ze świecącym rdzeniem. Pasuje do Mechanika.
wardrobe.item.weapon_elven_hatchet = Elficki toporek
wardrobe.item.weapon_elven_hatchet.desc = Lekki toporek z ostrzem jak liść.
wardrobe.item.weapon_magma_axe = Topór magmy
wardrobe.item.weapon_magma_axe.desc = Stygnąca lawa z ognistą krawędzią, zostawia żar.
wardrobe.item.weapon_elven_longbow = Elficki łuk długi
wardrobe.item.weapon_elven_longbow.desc = Jasne drewno i świecąca cięciwa. Pasuje do Leśnej elfki.
wardrobe.item.weapon_hunter_recurve = Łuk refleksyjny
wardrobe.item.weapon_hunter_recurve.desc = Niezawodny łuk z wygiętymi ramionami.
wardrobe.item.weapon_crystal_bow = Kryształowy łuk
wardrobe.item.weapon_crystal_bow.desc = Przezroczyste ramiona i gwiezdny ślad strzały.
wardrobe.item.weapon_dragon_bow = Smoczy łuk
wardrobe.item.weapon_dragon_bow.desc = Łuk ze smoczymi kolcami, strzały zostawiają płomień.
wardrobe.item.weapon_cyber_bow = Neonowy łuk
wardrobe.item.weapon_cyber_bow.desc = Łuk kompozytowy z neonową cięciwą.
wardrobe.item.weapon_paladin_hammer = Młot paladyna
wardrobe.item.weapon_paladin_hammer.desc = Poświęcony młot bojowy. Pasuje do Paladyna.
wardrobe.item.weapon_morning_star = Morgensztern
wardrobe.item.weapon_morning_star.desc = Kolczasta głowica na dębowym trzonku.
wardrobe.item.weapon_crystal_scepter = Kryształowe berło
wardrobe.item.weapon_crystal_scepter.desc = Srebrne berło z ametystowymi ścianami.
wardrobe.item.weapon_skull_mace = Buława-czaszka
wardrobe.item.weapon_skull_mace.desc = Czaszka o zielonych oczach. Pasuje do Nekromanty.
wardrobe.item.weapon_storm_maul = Młot burzy
wardrobe.item.weapon_storm_maul.desc = Ciosy krzeszą błyskawice.
wardrobe.item.weapon_tidal_trident = Trójząb przypływów
wardrobe.item.weapon_tidal_trident.desc = Morski trójząb rozsiewający bryzgi.
wardrobe.item.weapon_dragon_lance = Smocza lanca
wardrobe.item.weapon_dragon_lance.desc = Grot ze smoczej kości z ognistą żyłą.
wardrobe.item.weapon_phoenix_spear = Włócznia feniksa
wardrobe.item.weapon_phoenix_spear.desc = Płonący grot-pióro, ciosy pryskają lawą.
wardrobe.item.weapon_knight_halberd = Halabarda strażnika
wardrobe.item.weapon_knight_halberd.desc = Topór, hak i szpic na jednym drzewcu.
wardrobe.item.weapon_cyber_pike = Pika energetyczna
wardrobe.item.weapon_cyber_pike.desc = Karbonowe drzewce i świecący grot.
wardrobe.item.cape_royal = Płaszcz królewski
wardrobe.item.cape_royal.desc = Karmazyn ze złotą lamówką i futrzanym kołnierzem.
wardrobe.item.cape_shadow = Płaszcz cieni
wardrobe.item.cape_shadow.desc = Postrzępiony dół świeci na fioletowo w ruchu.
wardrobe.item.cape_dragon = Smoczy płaszcz
wardrobe.item.cape_dragon.desc = Łuskowa tkanina z tlącą się pomarańczą.
wardrobe.item.cape_frost = Mroźny płaszcz
wardrobe.item.cape_frost.desc = Półprzezroczysty lód z kryształami przy krawędzi.
wardrobe.item.cape_phoenix = Płaszcz feniksa
wardrobe.item.cape_phoenix.desc = Płomienie zamiast tkaniny, tlące się w locie.
wardrobe.item.cape_galaxy = Płaszcz galaktyki
wardrobe.item.cape_galaxy.desc = Gwiaździsta noc wpleciona w tkaninę.
wardrobe.item.cape_emerald = Szmaragdowy płaszcz
wardrobe.item.cape_emerald.desc = Głęboka zieleń ze świecącą lamówką.
wardrobe.item.cape_knight = Płaszcz rycerza
wardrobe.item.cape_knight.desc = Niebieskie sukno z czerwoną podszewką i klamrą.
wardrobe.item.cape_vampire = Płaszcz wampira
wardrobe.item.cape_vampire.desc = Czarny ze szkarłatnym spodem i wysokim kołnierzem.
wardrobe.item.cape_angel = Płaszcz anioła
wardrobe.item.cape_angel.desc = Śnieżnobiała tkanina ze świecącą złotą lamówką.
wardrobe.item.cape_toxic = Toksyczny płaszcz
wardrobe.item.cape_toxic.desc = Postrzępiona tkanina świecąca trującą zielenią.
wardrobe.item.cape_neon = Neonowy płaszcz
wardrobe.item.cape_neon.desc = Ciemna tkanina przeszyta neonowymi liniami.
wardrobe.item.watch_rolex_submariner = Rolex Submariner
wardrobe.item.watch_rolex_submariner.desc = Stal Oyster, czarny ceramiczny bezel, świecące indeksy i lupa nad datą.
wardrobe.item.watch_rolex_hulk = Rolex Submariner Hulk
wardrobe.item.watch_rolex_hulk.desc = Zielona tarcza sunburst i zielony ceramiczny bezel.
wardrobe.item.watch_rolex_gmt_pepsi = Rolex GMT-Master II Pepsi
wardrobe.item.watch_rolex_gmt_pepsi.desc = Czerwono-niebieski bezel 24h, bransoleta Jubilee i czerwona wskazówka GMT.
wardrobe.item.watch_rolex_daytona = Rolex Daytona
wardrobe.item.watch_rolex_daytona.desc = Żółte złoto, trzy złote liczniki chronografu i tachymetr na bezelu.
wardrobe.item.watch_rolex_day_date = Rolex Day-Date President
wardrobe.item.watch_rolex_day_date.desc = Złota bransoleta President, karbowany bezel, okienka dnia i daty.
wardrobe.item.watch_rolex_datejust = Rolex Datejust 41
wardrobe.item.watch_rolex_datejust.desc = Stal ze złotem, niebieski sunburst i karbowany złoty bezel.
wardrobe.item.watch_patek_nautilus = Patek Philippe Nautilus
wardrobe.item.watch_patek_nautilus.desc = Koperta jak iluminator, niebieska tarcza z poziomym reliefem i zintegrowana bransoleta.
wardrobe.item.watch_patek_aquanaut = Patek Philippe Aquanaut
wardrobe.item.watch_patek_aquanaut.desc = Miękki ośmiokąt, tłoczona tarcza w kratę i kauczuk Tropical.
wardrobe.item.watch_patek_calatrava = Patek Philippe Calatrava
wardrobe.item.watch_patek_calatrava.desc = Klasyka w różowym złocie, biały guilloché i pasek z aligatora.
wardrobe.item.watch_ap_royal_oak = Audemars Piguet Royal Oak
wardrobe.item.watch_ap_royal_oak.desc = Ośmiokątny bezel na ośmiu śrubach i niebieska Grande Tapisserie.
wardrobe.item.watch_ap_offshore = Audemars Piguet Royal Oak Offshore
wardrobe.item.watch_ap_offshore.desc = Różowe złoto, duża Méga Tapisserie, chronograf i gumowane przyciski.
wardrobe.item.watch_richard_mille = Richard Mille RM 11
wardrobe.item.watch_richard_mille.desc = Karbonowa beczka na śrubach, szkielet z otwartym mechanizmem i czerwony kauczuk.
wardrobe.item.watch_piaget_polo = Piaget Polo
wardrobe.item.watch_piaget_polo.desc = Białe złoto, koperta poduszkowa i bransoleta z polerowanych i szczotkowanych godronów.
wardrobe.item.watch_cartier_santos = Cartier Santos
wardrobe.item.watch_cartier_santos.desc = Kwadratowa koperta ze śrubami, rzymskie cyfry, niebieskie wskazówki i szafir w koronce.
wardrobe.item.watch_hublot_big_bang = Hublot Big Bang
wardrobe.item.watch_hublot_big_bang.desc = Czarna ceramika, sześć śrub w kształcie H i szkieletowa tarcza.
wardrobe.item.neck_gold_cuban = Złoty łańcuch kubański
wardrobe.item.neck_gold_cuban.desc = Masywny łańcuch kubański ze złotym medalionem.
wardrobe.item.neck_diamond_drop = Diamentowa kropla
wardrobe.item.neck_diamond_drop.desc = Cienki łańcuszek z lśniącą kroplą diamentu.
wardrobe.item.neck_ruby_heart = Rubinowe serce
wardrobe.item.neck_ruby_heart.desc = Złoty łańcuszek z karmazynowym rubinem.
wardrobe.item.neck_pearl_choker = Perłowy naszyjnik
wardrobe.item.neck_pearl_choker.desc = Rząd pereł tuż przy szyi.
wardrobe.item.neck_cross_silver = Srebrny krzyż
wardrobe.item.neck_cross_silver.desc = Srebrny łańcuszek z gładkim krzyżem.
wardrobe.item.neck_emerald_lux = Szmaragdowy naszyjnik
wardrobe.item.neck_emerald_lux.desc = Złoto i duży świecący szmaragd.
wardrobe.item.neck_fang_tribal = Plemienny kieł
wardrobe.item.neck_fang_tribal.desc = Skórzany sznur z kostnym kłem.
wardrobe.item.neck_amethyst = Ametyst
wardrobe.item.neck_amethyst.desc = Srebro i fioletowy kamień.
wardrobe.item.neck_dog_tags = Nieśmiertelniki
wardrobe.item.neck_dog_tags.desc = Para stalowych nieśmiertelników na łańcuszku.
wardrobe.item.neck_sapphire_double = Podwójny szafir
wardrobe.item.neck_sapphire_double.desc = Dwie srebrne nitki z niebieskim kamieniem.
wardrobe.item.neck_gold_coin = Złoty dublon
wardrobe.item.neck_gold_coin.desc = Stara moneta na złotym łańcuchu.
wardrobe.item.neck_neon_pulse = Neonowy puls
wardrobe.item.neck_neon_pulse.desc = Ciemny łańcuch ze świecącym rdzeniem.
wardrobe.item.neck_obsidian_shard = Odłamek obsydianu
wardrobe.item.neck_obsidian_shard.desc = Czarny odłamek z fioletowym blaskiem.
wardrobe.item.neck_choker_velvet = Aksamitny choker
wardrobe.item.neck_choker_velvet.desc = Aksamitna wstążka ze szkarłatnym kamieniem.
wardrobe.item.neck_infinity_gold = Nieskończoność
wardrobe.item.neck_infinity_gold.desc = Podwójny złoty łańcuch ze świecącym znakiem.
wardrobe.item.pol_putin = Władimir Putin
wardrobe.item.pol_putin.desc = Ciemny garnitur, siwe włosy i bordowy krawat.
wardrobe.item.pol_zelensky = Wołodymyr Zełenski
wardrobe.item.pol_zelensky.desc = Oliwkowa wojskowa koszulka i zarost.
wardrobe.item.pol_trump = Donald Trump
wardrobe.item.pol_trump.desc = Niebieski garnitur, długi czerwony krawat i opalenizna.
wardrobe.item.pol_obama = Barack Obama
wardrobe.item.pol_obama.desc = Granatowy garnitur i lekki uśmiech.
wardrobe.item.pol_lukashenko = Alaksandr Łukaszenka
wardrobe.item.pol_lukashenko.desc = Szary garnitur, zaczes i wąsy.
wardrobe.item.pol_medvedev = Dmitrij Miedwiediew
wardrobe.item.pol_medvedev.desc = Ciemny garnitur i schludna fryzura.
wardrobe.item.pol_zhirinovsky = Władimir Żyrinowski
wardrobe.item.pol_zhirinovsky.desc = Brązowy garnitur w prążki i siwe włosy.
wardrobe.item.pol_kadyrov = Ramzan Kadyrow
wardrobe.item.pol_kadyrov.desc = Zielona kurtka, broda i papacha.
wardrobe.item.pol_nazarbayev = Nursułtan Nazarbajew
wardrobe.item.pol_nazarbayev.desc = Ciemny garnitur i wysokie czoło.
wardrobe.item.pol_tokayev = Kasym-Żomart Tokajew
wardrobe.item.pol_tokayev.desc = Garnitur i okulary w cienkiej oprawie.
wardrobe.item.pol_lavrov = Siergiej Ławrow
wardrobe.item.pol_lavrov.desc = Surowy garnitur, wąsy i zmęczone spojrzenie.
wardrobe.item.pet_axolotl = Aksolotl
wardrobe.item.pet_axolotl.desc = Uśmiechnięty różowy stworek z puszystymi skrzelami. Nadyma policzki i puszcza bąbelki.
wardrobe.item.pet_penguin = Pingwinek
wardrobe.item.pet_penguin.desc = Człapie w dzierganym szaliku i czasem ślizga się na brzuszku.
wardrobe.item.pet_red_panda = Pandka Ruda
wardrobe.item.pet_red_panda.desc = Puszysty ogon w paski. Staje na tylnych łapach, żeby wyglądać groźnie.
wardrobe.item.pet_corgi = Corgi
wardrobe.item.pet_corgi.desc = Krótkie łapki, wielkie uszy i nagłe napady biegania w kółko.
wardrobe.item.pet_capybara = Kapibara
wardrobe.item.pet_capybara.desc = Niewzruszona kapibara z yuzu na głowie. Chętnie siada ci na czubku głowy.
wardrobe.item.pet_baby_phoenix = Pisklę Feniksa
wardrobe.item.pet_baby_phoenix.desc = Płonący czubek i ognisty ogon. Kicha iskrami.
wardrobe.item.pet_jellyfish = Meduzka
wardrobe.item.pet_jellyfish.desc = Dryfuje w powietrzu, pulsuje i rozbłyska światłem.
wardrobe.item.pet_bumble_bee = Trzmielek
wardrobe.item.pet_bumble_bee.desc = Puchaty, bzyczący trzmiel. Tańczy pszczeli taniec i przynosi pyłek.
wardrobe.item.pet_hedgehog = Jeżyk
wardrobe.item.pet_hedgehog.desc = Nosi jabłko na kolcach i zwija się w kulkę, gdy w pobliżu są potwory.
wardrobe.item.pet_frog_prince = Żabi Książę
wardrobe.item.pet_frog_prince.desc = Żabka w złotej koronie. Skacze wysoko i łapie muchy językiem.
wardrobe.item.pet_koi_spirit = Duch Karpia Koi
wardrobe.item.pet_koi_spirit.desc = Pływa w powietrzu jak w stawie i wyskakuje z fikołkiem.
wardrobe.item.pet_yeti_cub = Mały Yeti
wardrobe.item.pet_yeti_cub.desc = Kudłaty śnieżny maluch z lodowymi pazurkami. Rzuca śnieżkami.
wardrobe.item.pet_dino_hatchling = Dinozaurek
wardrobe.item.pet_dino_hatchling.desc = Świeżo wykluty, nosi skorupkę jak hełm. Groźnie ryczy. Prawie.
wardrobe.item.pet_panda_cub = Pandziątko
wardrobe.item.pet_panda_cub.desc = Wiecznie żuje bambus i turla się przez plecy.
wardrobe.item.pet_ufo_drone = Dron UFO
wardrobe.item.pet_ufo_drone.desc = Maleńki latający spodek z pilotem. Skanuje okolicę promieniem.
wardrobe.item.head_street_bucket_hat = Sztruksowy kapelusz bucket
wardrobe.item.head_street_bucket_hat.desc = Wyhaftowany uśmiech, oczka i sznurek ze stoperem.
wardrobe.item.head_samurai_kabuto = Kabuto szoguna
wardrobe.item.head_samurai_kabuto.desc = Lakierowany hełm ze złotymi rogami kuwagata i szkarłatnym sznurowaniem.
wardrobe.item.head_astro_helmet = Hełm astronauty
wardrobe.item.head_astro_helmet.desc = Złoty wizjer, lampa, naszywka misji i mrugająca antena.
wardrobe.item.head_kitty_headphones = Słuchawki z uszkami
wardrobe.item.head_kitty_headphones.desc = Świecące łapki na muszlach i uszka, które same drgają.
wardrobe.item.body_biker_jacket = Ramoneska
wardrobe.item.body_biker_jacket.desc = Skośny zamek, ćwieki na ramionach i pasek z klamrą.
wardrobe.item.body_sakura_kimono = Kimono „Sakura”
wardrobe.item.body_sakura_kimono.desc = Jedwab w kwiatach wiśni, kokarda obi i płynące rękawy. Gubi płatki.
wardrobe.item.body_puffer_vest = Kamizelka puchowa
wardrobe.item.body_puffer_vest.desc = Pikowana kamizelka na bluzie z dyndającymi sznurkami.
wardrobe.item.body_detective_trench = Trencz detektywa
wardrobe.item.body_detective_trench.desc = Dwurzędowy płaszcz z paskiem, podszewką w kratę i falującymi połami.
wardrobe.item.legs_track_pants = Dresy i biegówki
wardrobe.item.legs_track_pants.desc = Lampasy, zamki przy kostkach i buty z poduszką powietrzną.
wardrobe.item.legs_samurai_hakama = Hakama i zori
wardrobe.item.legs_samurai_hakama.desc = Szerokie plisowane hakama, skarpety tabi i słomiane zori.
wardrobe.item.legs_skater_shorts = Szorty skejtera
wardrobe.item.legs_skater_shorts.desc = Dżinsowe szorty, łańcuch do portfela, podkolanówki i deskorolkowe buty.
wardrobe.item.legs_highland_kilt = Szkocki kilt
wardrobe.item.legs_highland_kilt.desc = Tartan, futrzany sporran z chwostami, podkolanówki i brogsy.
wardrobe.item.back_guitar_gigbag = Pokrowiec na gitarę
wardrobe.item.back_guitar_gigbag.desc = Miękki pokrowiec w naklejkach z kołyszącą się kostką-brelokiem.
wardrobe.item.back_fairy_wings = Skrzydła wróżki
wardrobe.item.back_fairy_wings.desc = Opalizujące przejrzyste skrzydła o świecących żyłkach. Trzepoczą i sypią iskrami.
wardrobe.item.back_mech_tentacles = Mechaniczne macki
wardrobe.item.back_mech_tentacles.desc = Cztery ramiona na reaktorze grzbietowym wiją się i kłapią szczypcami.
wardrobe.item.cape_pilgrim = Płaszcz pielgrzyma
wardrobe.item.cape_pilgrim.desc = Wełniany płaszcz z kapturem, peleryną i muszlą pielgrzyma.
wardrobe.item.cape_raven = Płaszcz kruka
wardrobe.item.cape_raven.desc = Rzędy granatowoczarnych piór z fioletowym połyskiem i pierzasty kołnierz.
wardrobe.item.cape_swallowtail = Jaskółczy ogon
wardrobe.item.cape_swallowtail.desc = Frakowy płaszcz rozdzielony na dwie poły ze srebrną lamówką.
wardrobe.item.cape_parade = Paradna peleryna
wardrobe.item.cape_parade.desc = Krótka peleryna ze złotą frędzlą, epoletami i akselbantem.
wardrobe.item.cape_wayfarer = Szal wędrowca
wardrobe.item.cape_wayfarer.desc = Długie końce szala powiewają na wietrze, złote glify migoczą.
wardrobe.item.cape_jinbaori = Jinbaori samuraja
wardrobe.item.cape_jinbaori.desc = Wojenne okrycie ze sztywnymi barkami, herbem mon i rozcięciem.
wardrobe.item.cape_war_banner = Sztandar bojowy
wardrobe.item.cape_war_banner.desc = Podarty sztandar na drzewcu z herbem, dziurami po strzałach i jedną wbitą.
wardrobe.item.cape_cathedral = Witrażowy płaszcz
wardrobe.item.cape_cathedral.desc = Rozeta i ostrołukowe okna katedry świecą przez barwne szkło.
wardrobe.item.cape_aurora = Płaszcz zorzy
wardrobe.item.cape_aurora.desc = Gwiaździste niebo, po którym falują żywe pasma zorzy.
wardrobe.item.cape_lava = Lawowy płaszcz
wardrobe.item.cape_lava.desc = Bazalt w rozżarzonych szczelinach, dół ocieka magmą.
wardrobe.item.cape_sakura = Płaszcz sakury
wardrobe.item.cape_sakura.desc = Jedwab z kwitnącą gałązką, kokardą obi i opadającymi płatkami.
wardrobe.item.cape_hologram = Cyberhologram
wardrobe.item.cape_hologram.desc = Projektor na plecach wyświetla przezroczysty płaszcz ze skanującą wiązką.
wardrobe.item.cape_ermine = Gronostajowy płaszcz
wardrobe.item.cape_ermine.desc = Aksamit ze złotymi liliami, gronostajowa pelerynka i łańcuch z rubinem.
wardrobe.item.cape_nomad = Płaszcz pustynnego wędrowca
wardrobe.item.cape_nomad.desc = Spłowiały, łatany płaszcz z kefiją, koralikami i owijkami na rękach.
wardrobe.item.cape_patchwork = Łatany płaszcz wiedźmy
wardrobe.item.cape_patchwork.desc = Uszyty ze skrawków magiczną nicią, z postrzępionym dołem i amuletami.
wardrobe.item.watch_omega_speedmaster = Omega Speedmaster Moonwatch
wardrobe.item.watch_omega_speedmaster.desc = Księżycowy chronograf: czarny tachymetr, trzy liczniki i sekundnik na dziewiątej.
wardrobe.item.watch_casio_gshock = Casio G-Shock
wardrobe.item.watch_casio_gshock.desc = Niezniszczalny kwadrat z żywicy, LCD z migającym dwukropkiem i stalowe przyciski.
wardrobe.item.watch_apple_ultra = Apple Watch Ultra
wardrobe.item.watch_apple_ultra.desc = Tytan, pomarańczowy przycisk czynności i świecący ekran z pierścieniami aktywności.
wardrobe.item.watch_tag_monaco = TAG Heuer Monaco
wardrobe.item.watch_tag_monaco.desc = Kwadratowy chronograf wyścigowy: niebieski sunburst, koronka po lewej i perforowana skóra.
wardrobe.item.watch_breitling_navitimer = Breitling Navitimer
wardrobe.item.watch_breitling_navitimer.desc = Chronograf pilota z suwakiem logarytmicznym, perełkowym bezelem i srebrnymi licznikami.
wardrobe.item.watch_jacob_astronomia = Jacob & Co. Astronomia
wardrobe.item.watch_jacob_astronomia.desc = Pod szafirową kopułą krążą tourbillon, globus, diament i zawsze prosta tarcza.
wardrobe.item.watch_jacob_godfather = Jacob & Co. Opera Godfather
wardrobe.item.watch_jacob_godfather.desc = Pod szafirową kopułą obraca się bęben pozytywki z motywem Ojca chrzestnego, obok tourbillon i czerwona róża.
wardrobe.item.watch_tennis_bracelet = Diamentowa bransoletka tenisowa
wardrobe.item.watch_tennis_bracelet.desc = Nieprzerwany rząd diamentów w białym złocie, każdy kamień łapie światło.
wardrobe.item.watch_tennis_emerald = Szmaragdowa bransoletka tenisowa
wardrobe.item.watch_tennis_emerald.desc = Kwadratowe szmaragdy w żółtym złocie, każdy kamień błyska zielonym ogniem.
wardrobe.item.watch_tennis_sapphire = Szafirowa bransoletka tenisowa
wardrobe.item.watch_tennis_sapphire.desc = Niebieskie szafiry na przemian z diamentami w białym złocie.
wardrobe.item.watch_tennis_ruby = Rubinowa bransoletka tenisowa
wardrobe.item.watch_tennis_ruby.desc = Owalne rubiny w różowym złocie, co trzeci kamień to diament.
wardrobe.item.watch_tennis_rainbow = Tęczowa bransoletka tenisowa
wardrobe.item.watch_tennis_rainbow.desc = Kolorowe szafiry we wszystkich barwach tęczy w żółtym złocie, mienią się przy każdym ruchu.
wardrobe.item.watch_tennis_double = Dwurzędowa bransoletka tenisowa
wardrobe.item.watch_tennis_double.desc = Dwa rzędy diamentów w platynie — dwa razy więcej iskier.
wardrobe.item.watch_tennis_black = Bransoletka tenisowa Black Ice
wardrobe.item.watch_tennis_black.desc = Czarne diamenty na czarnym rodzie, co czwarty kamień jest biały.
wardrobe.item.neck_iced_cuban = Lodowa kubanka z koroną
wardrobe.item.neck_iced_cuban.desc = Łańcuch kubański zalany diamentami i korona z rubinem i szafirami — wszystko iskrzy.
wardrobe.item.neck_rosary = Różaniec
wardrobe.item.neck_rosary.desc = Paciorki z palisandru na srebrnych ogniwach, medalik i krzyż ze złotą figurą.
wardrobe.item.neck_name_plate = Łańcuch z imieniem
wardrobe.item.neck_name_plate.desc = Złoty łańcuch typu lina i kursywny napis ZENITH z diamentowym podkreśleniem.
wardrobe.item.neck_usekh = Usech faraona
wardrobe.item.neck_usekh.desc = Szeroki kołnierz z lapis lazuli, karneolu i turkusu z sokolimi głowami i skrzydlatym skarabeuszem.
wardrobe.item.neck_magatama = Magatama
wardrobe.item.neck_magatama.desc = Jadeitowe przecinki, rurkowe paciorki i kryształ na jedwabnym sznurze — amulet samuraja.
wardrobe.item.neck_locket = Medalion z portretem
wardrobe.item.neck_locket.desc = Grawerowany złoty medalion z rubinem, który sam się otwiera i pokazuje stare zdjęcie.
wardrobe.item.neck_claw_chain = Naszyjnik z pazurów
wardrobe.item.neck_claw_chain.desc = Skórzany sznur, niedźwiedzie pazury w srebrnych okuciach i turkus.
wardrobe.item.neck_pearl_bow = Perły z kokardą
wardrobe.item.neck_pearl_bow.desc = Krótki i długi sznur pereł, czarna satynowa kokarda i barokowa perła.
wardrobe.item.char_cowboy_gunslinger = Kowboj rewolwerowiec
wardrobe.item.char_cowboy_gunslinger.desc = Stetson, prochowiec, czerwona chusta i rewolwer przy biodrze.
wardrobe.item.char_viking_jarl = Wiking jarl
wardrobe.item.char_viking_jarl.desc = Rogaty hełm, ruda broda z warkoczem, tarcza na plecach i topór.
wardrobe.item.char_egyptian_pharaoh = Faraon
wardrobe.item.char_egyptian_pharaoh.desc = Nemes w złote pasy, laska-pastorał, cep i dysk słońca.
wardrobe.item.char_arctic_explorer = Polarniczka
wardrobe.item.char_arctic_explorer.desc = Parka z futrzanym kapturem, gogle, plecak i czekan.
wardrobe.item.char_mad_scientist = Szalony naukowiec
wardrobe.item.char_mad_scientist.desc = Rozczochrane siwe włosy, monokl, fartuch i iskrząca cewka Tesli.
wardrobe.item.char_jester_harlequin = Arlekin
wardrobe.item.char_jester_harlequin.desc = Czapka z dzwoneczkami, romby, kryza i błazeńskie berło.
wardrobe.item.char_netrunner = Netrunnerka
wardrobe.item.char_netrunner.desc = Fioletowy bob, cyberoko, neonowa kurtka i holoekran.
wardrobe.item.char_templar_crusader = Rycerz templariusz
wardrobe.item.char_templar_crusader.desc = Kolczuga, biała tunika z czerwonym krzyżem, tarcza i hełm garnczkowy u pasa.
wardrobe.item.char_jaguar_warrior = Wojownik jaguara
wardrobe.item.char_jaguar_warrior.desc = Hełm z paszczy jaguara, pióra kwezala, macuahuitl i tarcza.
wardrobe.item.char_ghost_bride = Upiorna panna młoda
wardrobe.item.char_ghost_bride.desc = Przejrzysty welon, zwiędły bukiet, zerwany łańcuch i dusze wokół.
wardrobe.item.char_lava_golem = Lawowy golem
wardrobe.item.char_lava_golem.desc = Kamienny kolos z pęknięciami magmy i pulsującym rdzeniem.
wardrobe.item.char_beekeeper = Pszczelarka
wardrobe.item.char_beekeeper.desc = Kapelusz z siatką, podkurzacz, słoik miodu i pszczoły wokół.
wardrobe.item.char_fallen_angel = Upadły anioł
wardrobe.item.char_fallen_angel.desc = Czarne skrzydła, pęknięta aureola i opadający popiół.
wardrobe.item.char_idol_singer = Idolka
wardrobe.item.char_idol_singer.desc = Miętowe koczki, zestaw słuchawkowy, sceniczny mundurek i mikrofon.
wardrobe.item.char_firefighter = Strażak
wardrobe.item.char_firefighter.desc = Hełm z odznaką, odblaskowy strój bojowy, butla i topór.
wardrobe.item.weapon_crossguard_saber = Miecz świetlny z jelcem
wardrobe.item.weapon_crossguard_saber.desc = Niestabilny szkarłatny promień z dwoma plazmowymi jelcami i iskrzącą krawędzią.
wardrobe.item.weapon_obsidian_greatsword = Obsydianowy dwuręczniak
wardrobe.item.weapon_obsidian_greatsword.desc = Demoniczne ostrze z żyłami lawy, rogatym jelcem i płonącym okiem.
wardrobe.item.weapon_sakura_wakizashi = Wakizashi sakury
wardrobe.item.weapon_sakura_wakizashi.desc = Krótkie ostrze z kwiatową tsubą. Wokół stali wirują płatki.
wardrobe.item.weapon_labrys = Labrys
wardrobe.item.weapon_labrys.desc = Brązowy topór dwusieczny z meandrem, lazurytem i szkarłatnymi wstęgami.
wardrobe.item.weapon_glacier_axe = Topór lodowca
wardrobe.item.weapon_glacier_axe.desc = Ostrze z lodowych odłamków ze świecącym rdzeniem, krążą wokół kryształy.
wardrobe.item.weapon_chainsaw_axe = Topór-piła łańcuchowa
wardrobe.item.weapon_chainsaw_axe.desc = Łańcuch biegnie po prowadnicy, silnik drży, a wydech się żarzy.
wardrobe.item.weapon_bone_bow = Kościany łuk
wardrobe.item.weapon_bone_bow.desc = Ramiona z kręgów, pazury na końcach i czaszki o tlących się oczach.
wardrobe.item.weapon_solar_bow = Słoneczny skrzydlaty łuk
wardrobe.item.weapon_solar_bow.desc = Złote skrzydlate ramiona i wirująca korona promieni słońca.
wardrobe.item.weapon_compound_bow = Łuk bloczkowy
wardrobe.item.weapon_compound_bow.desc = Bloczki obracają się przy naciągu, celownik ma świecące piny.
wardrobe.item.weapon_meteor_flail = Cep meteorytowy
wardrobe.item.weapon_meteor_flail.desc = Rozżarzony meteoryt na łańcuchu, wokół krąży żar.
wardrobe.item.weapon_rune_warhammer = Runiczny młot bojowy
wardrobe.item.weapon_rune_warhammer.desc = Północny młot bojowy, runy na obuchu pulsują światłem.
wardrobe.item.weapon_jester_mace = Buława błazna
wardrobe.item.weapon_jester_mace.desc = Maska śmiechu i maska łez pod czapką z dzwoneczkami.
wardrobe.item.weapon_naginata = Naginata
wardrobe.item.weapon_naginata.desc = Zakrzywione ostrze na lakierowanym drzewcu ze szkarłatnym chwostem.
wardrobe.item.weapon_lightning_javelin = Oszczep piorunów
wardrobe.item.weapon_lightning_javelin.desc = Grot-błyskawica otoczony krążącymi wyładowaniami.
wardrobe.item.weapon_bamboo_spear = Bambusowa włócznia
wardrobe.item.weapon_bamboo_spear.desc = Żywy bambus z liśćmi, czerwona wstęga i jadeitowy koralik.
wardrobe.item.head_bogatyr_shelom = Szłom bohatyra
wardrobe.item.head_bogatyr_shelom.desc = Szpiczasty szyszak ze złoconym naczółkiem, kolczym czepcem i czerwoną chorągiewką.
wardrobe.item.body_bogatyr_kolchuga = Kolczuga z zercałem
wardrobe.item.body_bogatyr_kolchuga.desc = Nitowana kolczuga, lśniące zercało na piersi i czerwony kaftan pod spodem.
wardrobe.item.legs_bogatyr_sapogi = Szarawary i sapogi
wardrobe.item.legs_bogatyr_sapogi.desc = Niebieskie szarawary, czerwony pas i czerwone buty z zadartymi noskami.
wardrobe.item.head_pharaoh_nemes = Nemes faraona
wardrobe.item.head_pharaoh_nemes.desc = Pasiasty nemes, złoty ureusz o rubinowych oczach i pleciona broda.
wardrobe.item.body_pharaoh_usekh = Kołnierz usech
wardrobe.item.body_pharaoh_usekh.desc = Szeroki kołnierz z paciorków złota, lapisu i karneolu na lnianej tunice.
wardrobe.item.legs_pharaoh_shendyt = Szendyt i sandały
wardrobe.item.legs_pharaoh_shendyt.desc = Plisowany szendyt ze złotym fartuchem w hieroglify i złote sandały.
wardrobe.item.head_steam_aviator = Czapka aeronauty
wardrobe.item.head_steam_aviator.desc = Skórzana czapka na kożuchu, mosiężne gogle z odchylanymi soczewkami i zębatki.
wardrobe.item.body_steam_greatcoat = Szynel aeronauty
wardrobe.item.body_steam_greatcoat.desc = Skóra w kolorze wołowej krwi, uprząż z drżącym manometrem i miedziana rura na ramieniu.
wardrobe.item.legs_steam_boots = Bryczesy i nitowane buty
wardrobe.item.legs_steam_boots.desc = Bryczesy khaki, wysokie nitowane buty, klamry-zębatki i miedziane nakolanniki.
wardrobe.item.back_steam_boiler = Plecak z kotłem parowym
wardrobe.item.back_steam_boiler.desc = Miedziany kocioł z żywym paleniskiem i dymiącymi kominami. Śmigło rozkręca się w locie.
wardrobe.item.head_plague_beak = Maska doktora dżumy
wardrobe.item.head_plague_beak.desc = Kapelusz z szerokim rondem, szyty skórzany dziób i soczewki o bladozielonym blasku.
wardrobe.item.body_plague_coat = Woskowany płaszcz medyka
wardrobe.item.body_plague_coat.desc = Długi woskowany płaszcz, wysoki kołnierz i bandolier ze świecącymi fiolkami.
wardrobe.item.legs_plague_boots = Bryczesy i buty medyka
wardrobe.item.legs_plague_boots.desc = Ciemne bryczesy i wysokie buty z wywinięciem, spięte rzędem klamer.
wardrobe.item.back_plague_satchel = Torba aptekarza
wardrobe.item.back_plague_satchel.desc = Pęki suszonych ziół, zwój receptur i latarnia z zielonym ogniem, kołysząca się w marszu.
wardrobe.item.head_hoplite_corinthian = Hełm koryncki
wardrobe.item.head_hoplite_corinthian.desc = Brąz z wycięciami na oczy i czerwony grzebień z końskiego włosia, sprężynujący w ruchu.
wardrobe.item.body_hoplite_cuirass = Kirys anatomiczny
wardrobe.item.body_hoplite_cuirass.desc = Brązowy tors z gorgoneionem, skórzane pterugi i czerwona chlamida na ramieniu.
wardrobe.item.legs_hoplite_greaves = Nagolenniki i krepidy
wardrobe.item.legs_hoplite_greaves.desc = Kute brązowe nagolenniki, czerwony chiton z meandrem i sznurowane sandały.
wardrobe.item.back_hoplite_aspis = Aspis i dory
wardrobe.item.back_hoplite_aspis.desc = Okrągła tarcza z brązową lambdą i włócznia na plecach — falanga nie pęknie.
wardrobe.item.head_tuareg_tagelmust = Tagelmust
wardrobe.item.head_tuareg_tagelmust.desc = Indygowy turban z zasłoną, srebrny amulet i koniec tkaniny na wietrze.
wardrobe.item.body_tuareg_robe = Szaty koczownika
wardrobe.item.body_tuareg_robe.desc = Indygo na piasku, krzyż z Agadezu, szerokie rękawy i sztylet u pasa.
wardrobe.item.legs_tuareg_sirwal = Sirwal i sandały
wardrobe.item.legs_tuareg_sirwal.desc = Szerokie piaskowe spodnie z tkanymi taśmami i sandały z czerwonymi paskami.
wardrobe.item.head_racer_helmet = Kask kierowcy bolidu
wardrobe.item.head_racer_helmet.desc = Czerwono-białe malowanie, przyciemniana szyba z zrywkami i spojler na czubku.
wardrobe.item.body_racer_suit = Ognioodporny kombinezon
wardrobe.item.body_racer_suit.desc = Naszywki sponsorów, HANS na barkach, pagony i rękawice z chwytnymi dłońmi.
wardrobe.item.legs_racer_boots = Spodnie i buty wyścigowe
wardrobe.item.legs_racer_boots.desc = Lampasy do kostek i cienkie buty na rzepy, które czują każdy pedał.
wardrobe.item.head_mecha_helm = Hełm pilota mecha
wardrobe.item.head_mecha_helm.desc = Kanciasty pancerz, świecąca szczelina wizjera z HUD i skośne anteny.
wardrobe.item.body_mecha_chest = Pancerz z reaktorem
wardrobe.item.body_mecha_chest.desc = Pulsujący rdzeń reaktora, masywne naramienniki i karwasze ze świetlnymi liniami.
wardrobe.item.legs_mecha_legs = Opancerzone nogi i magnobuty
wardrobe.item.legs_mecha_legs.desc = Hydrauliczne tłoki pracują w rytm kroków, a podeszwy świecą na niebiesko.
wardrobe.item.back_mecha_thrusters = Podwójne dopalacze
wardrobe.item.back_mecha_thrusters.desc = Dwa dopalacze na kręgosłupie: w locie rozkładają płetwy i ziają ogniem.
wardrobe.item.head_diver_helmet = Hełm nurka
wardrobe.item.head_diver_helmet.desc = Wypolerowany mosiądz, trzy iluminatory i krata na przedniej szybie.
wardrobe.item.body_diver_suit = Skafander nurka
wardrobe.item.body_diver_suit.desc = Brezent, przykręcany mosiężny napierśnik i ołowiane ciężarki z przodu i z tyłu.
wardrobe.item.legs_diver_boots = Ołowiane buty nurka
wardrobe.item.legs_diver_boots.desc = Ogromne buty na ołowianej podeszwie z mosiężnymi noskami i paskami.
wardrobe.item.back_diver_tanks = Butle z powietrzem
wardrobe.item.back_diver_tanks.desc = Miedziane butle, manometr i karbowany wąż do hełmu. Czasem bulgoczą.
wardrobe.item.body_hawaiian_shirt = Koszula hawajska
wardrobe.item.body_hawaiian_shirt.desc = Hibiskusy i palmy, rozpięta na białym T-shircie.
wardrobe.item.body_bard_doublet = Kubrak barda
wardrobe.item.body_bard_doublet.desc = Bufiaste rękawy z jedwabnymi rozcięciami, sznurowanie i pas od lutni.
wardrobe.item.body_yellow_raincoat = Żółty płaszcz przeciwdeszczowy
wardrobe.item.body_yellow_raincoat.desc = Błyszczący płaszcz na kołki z taśmą odblaskową. Wciąż z niego kapie.
wardrobe.item.body_lab_coat = Kitel laboratoryjny
wardrobe.item.body_lab_coat.desc = Identyfikator, długopisy w kieszeni i świecące probówki z boku.
wardrobe.item.legs_muay_thai = Spodenki muay thai
wardrobe.item.legs_muay_thai.desc = Satynowe spodenki z tajskim napisem na pasie, owijki na goleniach i stabilizatory kostek.
wardrobe.item.legs_goth_platforms = Bondage i creepersy
wardrobe.item.legs_goth_platforms.desc = Paski, kółka D, łańcuch i szkocka klapa nad creepersami na grubej podeszwie.
wardrobe.item.legs_ballet_tutu = Tutu baletnicy
wardrobe.item.legs_ballet_tutu.desc = Przejrzyste warstwy tiulu, różowe rajstopy i pointy ze wstążkami do kostek.
wardrobe.item.legs_rocket_boots = Rakietowe buty
wardrobe.item.legs_rocket_boots.desc = Chromowane dysze na piętach buchają ogniem, gdy tylko oderwiesz się od ziemi.
wardrobe.item.legs_roller_skates = Roller disco
wardrobe.item.legs_roller_skates.desc = Postrzępione dżinsowe szorty, pasiaste podkolanówki i wrotki z kręcącymi się kółkami.
wardrobe.item.back_sashimono_banner = Sztandar sashimono
wardrobe.item.back_sashimono_banner.desc = Szkarłatna flaga samuraja z herbem mon na drzewcu za plecami, łopocze na wietrze.
wardrobe.item.back_lantern_yoke = Nosidło z lampionami
wardrobe.item.back_lantern_yoke.desc = Bambusowe nosidło z dwoma czerwonymi lampionami, które świecą i się kołyszą.
wardrobe.item.back_coffin = Trumna na łańcuchach
wardrobe.item.back_coffin.desc = Ciemna trumna z żelaznym krzyżem i okuciami, łańcuchy kołyszą się w marszu.
wardrobe.item.back_holo_halo = Holo-aureola
wardrobe.item.back_holo_halo.desc = Pierścień hologramów z glifami unosi się za plecami, wiruje i iskrzy.
wardrobe.item.back_sapling_pot = Drzewko w doniczce
wardrobe.item.back_sapling_pot.desc = Gliniana doniczka na plecach, żywe drzewko i ptaszek w gnieździe.
wardrobe.item.back_scroll_case = Tuba na zwoje
wardrobe.item.back_scroll_case.desc = Lakierowana tuba w fale seigaiha, ze zwojami i przywiązanym pędzlem.
wardrobe.item.back_balloon_bundle = Pęk baloników
wardrobe.item.back_balloon_bundle.desc = Plecaczek z karabińczykiem i pękiem balonów kołyszących się nad głową.
wardrobe.item.back_void_tendrils = Macki Otchłani
wardrobe.item.back_void_tendrils.desc = Z rozdarcia na plecach wiją się cienie o świecących końcach.
wardrobe.item.back_boombox = Boombox
wardrobe.item.back_boombox.desc = Magnetofon retro na pasku: pulsujące głośniki i kręcąca się kaseta.
wardrobe.item.weapon_gladius = Gladius
wardrobe.item.weapon_gladius.desc = Krótkie rzymskie ostrze o liściastym sztychu, żeberkowana kościana rękojeść.
wardrobe.item.weapon_zweihander = Zweihänder
wardrobe.item.weapon_zweihander.desc = Ogromny dwuręczniak z obszytym skórą ricasso, hakami i szerokim jelcem.
wardrobe.item.weapon_sultan_scimitar = Sułtański bułat
wardrobe.item.weapon_sultan_scimitar.desc = Zakrzywiona klinga w złotych ornamentach, rubin w głowicy i poszerzony sztych.
wardrobe.item.weapon_musketeer_rapier = Rapier muszkietera
wardrobe.item.weapon_musketeer_rapier.desc = Smukła klinga, kosz z wijących się prętów, muszlowa osłona i niebieska wstążka.
wardrobe.item.weapon_highland_claymore = Góralski claymore
wardrobe.item.weapon_highland_claymore.desc = Pochylone jelce zakończone czterolistnikami, tarczowa głowica i tartanowa szarfa.
wardrobe.item.weapon_khopesh = Chopesz
wardrobe.item.weapon_khopesh.desc = Egipski miecz-sierp z brązu ze złotą inkrustacją i lazurytową rękojeścią.
wardrobe.item.weapon_flamberge = Flamberg
wardrobe.item.weapon_flamberge.desc = Falista płomienista klinga z rozżarzoną krawędzią, z której sypią się iskry.
wardrobe.item.weapon_void_runeblade = Runiczne ostrze pustki
wardrobe.item.weapon_void_runeblade.desc = Czarne ostrze z płonącymi runami, wokół krążą odłamki zaklęć.
wardrobe.item.weapon_buster_sword = Miecz-pogromca
wardrobe.item.weapon_buster_sword.desc = Ogromna stalowa płyta z dwoma otworami i obandażowaną rękojeścią.
wardrobe.item.weapon_leaf_blade = Elfie ostrze-liść
wardrobe.item.weapon_leaf_blade.desc = Klinga w kształcie liścia, rękojeść oplecona pnączem, w jelcu lśni szmaragd.
wardrobe.item.weapon_bone_sword = Kościany miecz
wardrobe.item.weapon_bone_sword.desc = Toporne ostrze z wielkiej kości, z zębami na krawędzi i skórzaną rękojeścią.
wardrobe.item.weapon_jade_dao = Jadeitowy dao
wardrobe.item.weapon_jade_dao.desc = Chińska szabla z mosiężnymi okuciami, jadeitową głowicą i czerwonym chwostem.
wardrobe.item.weapon_holy_avenger = Święty Mściciel
wardrobe.item.weapon_holy_avenger.desc = Promienny miecz paladyna: złote skrzydła, świecący napis i aureola nad klingą.
wardrobe.item.weapon_prism_sword = Pryzmatyczny miecz
wardrobe.item.weapon_prism_sword.desc = Kryształowe ostrze-pryzmat rozszczepia światło w tęczę wzdłuż krawędzi.
wardrobe.item.weapon_shotel = Szotel
wardrobe.item.weapon_shotel.desc = Etiopski miecz-sierp wygięty niemal w półkole, z drewnianą rękojeścią.
wardrobe.item.weapon_gunblade = Gunblade
wardrobe.item.weapon_gunblade.desc = Ostrze na szkielecie rewolweru: spust, lufa i bęben, który sam przeskakuje.
wardrobe.item.weapon_candy_cane_sword = Miecz z laski cukrowej
wardrobe.item.weapon_candy_cane_sword.desc = Pasiaste ostrze z lizaka, piernikowy jelec i zielona kokarda ze wstążkami.
wardrobe.item.weapon_coral_blade = Koralowe ostrze
wardrobe.item.weapon_coral_blade.desc = Różowy koral w muszlach i pąklach, perłowa głowica i unoszące się bąbelki.
wardrobe.item.weapon_thunder_nodachi = Gromowe nodachi
wardrobe.item.weapon_thunder_nodachi.desc = Ogromne nodachi z hamonem-błyskawicą świecącym na niebiesko i iskrami na ostrzu.
wardrobe.item.weapon_bokken = Bokken
wardrobe.item.weapon_bokken.desc = Drewniany miecz treningowy z widocznym słojem dębu i plastikową tsubą.
wardrobe.item.weapon_serpent_kris = Wężowy kris
wardrobe.item.weapon_serpent_kris.desc = Falisty kris z wzorem pamor i rękojeścią-nagą, która porusza językiem.
wardrobe.item.weapon_moonlight_greatsword = Miecz księżycowego światła
wardrobe.item.weapon_moonlight_greatsword.desc = Półprzezroczyste ostrze bladego księżycowego światła z jelcem-półksiężycem.
wardrobe.item.weapon_bloodthirster = Krwiopijca
wardrobe.item.weapon_bloodthirster.desc = Szkarłatne ostrze z żyłami, w jelcu bije serce, a po klindze spływa krew.
wardrobe.item.weapon_pixel_sword = Pikselowy miecz
wardrobe.item.weapon_pixel_sword.desc = Ośmiobitowy miecz ze schodkowych bloków; po klindze biegnie pikselowy błysk.
wardrobe.item.weapon_clockwork_blade = Nakręcane ostrze
wardrobe.item.weapon_clockwork_blade.desc = Mosiądz i stal: w jelcu kręcą się zębatki, a głowica to kluczyk do nakręcania.
wardrobe.item.weapon_yumi = Yumi
wardrobe.item.weapon_yumi.desc = Wysoki asymetryczny łuk w czarnej lace z rattanowymi oplotami i białą cięciwą.
wardrobe.item.weapon_mongol_bow = Łuk mongolski
wardrobe.item.weapon_mongol_bow.desc = Krótki łuk kompozytowy: rogowe majdany, malowana brzoza i niebieska wstęga chadak.
wardrobe.item.weapon_yew_longbow = Cisowy łuk długi
wardrobe.item.weapon_yew_longbow.desc = Angielski łuk cisowy: jasny biel, ciemna twardziel i rogowe nasadki.
wardrobe.item.weapon_vine_bow = Łuk żywego pnącza
wardrobe.item.weapon_vine_bow.desc = Spleciona żywa winorośl w liściach, na ramionach kwitną kwiaty.
wardrobe.item.weapon_shadow_bow = Łuk cienia
wardrobe.item.weapon_shadow_bow.desc = Czarne ramiona jak ostrza z fioletową krawędzią, spływa z nich dym.
wardrobe.item.weapon_storm_bow = Łuk burzy
wardrobe.item.weapon_storm_bow.desc = Cięciwą jest trzaskająca błyskawica, przy majdanie kłębi się chmura.
wardrobe.item.weapon_cupid_bow = Łuk Kupidyna
wardrobe.item.weapon_cupid_bow.desc = Różowo-złoty łuk z sercem na majdanie i maleńkimi skrzydełkami.
wardrobe.item.weapon_tidal_bow = Łuk przypływu
wardrobe.item.weapon_tidal_bow.desc = Przejrzysta fala z grzywami piany i perłą, z końców kapie woda.
wardrobe.item.weapon_ember_bow = Żarzący się łuk
wardrobe.item.weapon_ember_bow.desc = Zwęglone drewno w żarzących się pęknięciach, na końcach tańczą płomyki.
wardrobe.item.weapon_scythian_bow = Łuk scytyjski
wardrobe.item.weapon_scythian_bow.desc = Podwójnie wygięty łuk ze złotymi okuciami w stylu zwierzęcym i głowami gryfów.
wardrobe.item.weapon_steampunk_bow = Łuk steampunkowy
wardrobe.item.weapon_steampunk_bow.desc = Mosiądz i orzech: przy majdanie kręcą się zębatki, na górze luneta, z zaworu bucha para.
wardrobe.item.weapon_void_bow = Łuk pustki
wardrobe.item.weapon_void_bow.desc = Kryształ pustki: wokół ramion unoszą się odłamki, przy majdanie wiruje mroczna kula.
wardrobe.item.weapon_moon_bow = Łuk księżyca
wardrobe.item.weapon_moon_bow.desc = Srebrny półksiężyc, na cięciwie migoczą gwiezdne koraliki.
wardrobe.item.weapon_bamboo_bow = Bambusowy łuk
wardrobe.item.weapon_bamboo_bow.desc = Kolankowy bambus owinięty sznurkiem, gałązka liści i słomiany chwost.
wardrobe.item.weapon_antler_bow = Łuk z poroża
wardrobe.item.weapon_antler_bow.desc = Dwa jelenie poroża z odnogami złączone skórzanym uchwytem.
wardrobe.item.weapon_serpent_bow = Wężowy łuk
wardrobe.item.weapon_serpent_bow.desc = Ramiona to dwa węże o szmaragdowych oczach, ogony splecione na uchwycie.
wardrobe.item.weapon_rainbow_bow = Tęczowy łuk
wardrobe.item.weapon_rainbow_bow.desc = Łuk w siedmiu kolorach tęczy z chmurkami na końcach i pryzmatem w uchwycie.
wardrobe.item.weapon_royal_bow = Królewski łuk
wardrobe.item.weapon_royal_bow.desc = Złocony łuk z filigranem, szafirami i koroną na aksamitnym uchwycie.
wardrobe.item.weapon_spider_bow = Pajęczy łuk
wardrobe.item.weapon_spider_bow.desc = Czarna chityna, pajęcze nogi na końcach i cięciwa z pajęczyny.
wardrobe.item.weapon_sakura_bow = Łuk sakury
wardrobe.item.weapon_sakura_bow.desc = Kwitnące drewno wiśni: gałązki z pąkami i wirujące płatki.
wardrobe.item.weapon_demon_bow = Demoniczny łuk
wardrobe.item.weapon_demon_bow.desc = Rogi z rozżarzonymi pęknięciami i płonące oko mrugające na uchwycie.
wardrobe.item.weapon_constellation_bow = Łuk konstelacji
wardrobe.item.weapon_constellation_bow.desc = Półprzezroczysta noc, migoczące gwiazdy i świetliste linie konstelacji.
wardrobe.item.weapon_wind_bow = Łuk wiatru
wardrobe.item.weapon_wind_bow.desc = Jasne drewno i długie pióra na końcach, łopoczące na wietrze.
wardrobe.item.weapon_obsidian_bow = Obsydianowy łuk
wardrobe.item.weapon_obsidian_bow.desc = Szkliście czarne odłamki, po których spływają fioletowe łzy.
wardrobe.item.weapon_harp_bow = Łuk-harfa
wardrobe.item.weapon_harp_bow.desc = Złota lira z pudłem rezonansowym, której struny drżą i dźwięczą.
wardrobe.item.weapon_shestoper = Szestopiór
wardrobe.item.weapon_shestoper.desc = Ruska buława z sześcioma stalowymi piórami i okrągłą głowicą.
wardrobe.item.weapon_hetman_bulava = Buława hetmańska
wardrobe.item.weapon_hetman_bulava.desc = Złocona gruszkowata głowica z turkusami i szkarłatnym chwostem.
wardrobe.item.weapon_kanabo = Kanabō
wardrobe.item.weapon_kanabo.desc = Długa ośmiokątna maczuga z czarnej laki nabijana żelaznymi ćwiekami.
wardrobe.item.weapon_macuahuitl = Macuahuitl
wardrobe.item.weapon_macuahuitl.desc = Aztecka maczuga z obsydianowymi ostrzami, malowidłami i piórami kwezala.
wardrobe.item.weapon_caveman_club = Maczuga jaskiniowca
wardrobe.item.weapon_caveman_club.desc = Sękata kłoda z krzemiennymi kolcami i rękojeścią owiniętą skórą.
wardrobe.item.weapon_judge_gavel = Młotek sędziowski
wardrobe.item.weapon_judge_gavel.desc = Ogromny polerowany młotek z mosiężnymi obręczami. Wyrok jest ostateczny.
wardrobe.item.weapon_sledgehammer = Młot dwuręczny
wardrobe.item.weapon_sledgehammer.desc = Ciężki stalowy obuch na żółto-czarnym trzonku z włókna szklanego.
wardrobe.item.weapon_forge_hammer = Młot kowalski
wardrobe.item.weapon_forge_hammer.desc = Obuch rozgrzany do czerwoności prosto z paleniska sypie iskrami.
wardrobe.item.weapon_holy_censer = Święta kadzielnica
wardrobe.item.weapon_holy_censer.desc = Złota kadzielnica na łańcuchu: przez ażury żarzą się węgle, snuje się dym.
wardrobe.item.weapon_solar_mace = Buława słońca
wardrobe.item.weapon_solar_mace.desc = Płonące słońce na złotym trzonku, wokół wirują promienie korony.
wardrobe.item.weapon_lollipop_mace = Lizakowa buława
wardrobe.item.weapon_lollipop_mace.desc = Ogromny spiralny lizak na patyku z różową kokardą.
wardrobe.item.weapon_anchor_mace = Kotwica-buława
wardrobe.item.weapon_anchor_mace.desc = Okrętowa kotwica w pąklach, owinięta łańcuchem, z wodorostami na łapie.
wardrobe.item.weapon_bell_mace = Dzwon-buława
wardrobe.item.weapon_bell_mace.desc = Brązowy dzwon zamiast głowicy: serce się kołysze, cios dzwoni nutą.
wardrobe.item.weapon_geode_mace = Buława geody
wardrobe.item.weapon_geode_mace.desc = Pęknięta skorupa kamienia, a w środku lśni druza ametystów.
wardrobe.item.weapon_gravity_hammer = Młot grawitacyjny
wardrobe.item.weapon_gravity_hammer.desc = Między obuchami unosi się rdzeń grawitacji w wirujących pierścieniach.
wardrobe.item.weapon_triple_flail = Potrójny korbacz
wardrobe.item.weapon_triple_flail.desc = Trzy kolczaste kule na łańcuchach, każda kołysze się inaczej.
wardrobe.item.weapon_tiki_club = Maczuga tiki
wardrobe.item.weapon_tiki_club.desc = Rzeźbiony bożek z jaskrawymi oczami, uśmiechem i liśćmi palmy.
wardrobe.item.weapon_void_scepter = Berło pustki
wardrobe.item.weapon_void_scepter.desc = W klatce pulsuje kula pustki, wokół krążą mroczne odłamki.
wardrobe.item.weapon_dragon_skull_maul = Młot smoczej czaszki
wardrobe.item.weapon_dragon_skull_maul.desc = Rogata czaszka smoka, w oczodołach tli się ogień.
wardrobe.item.weapon_bone_club = Kościana maczuga
wardrobe.item.weapon_bone_club.desc = Kość udowa olbrzyma owinięta skórą.
wardrobe.item.weapon_royal_scepter = Berło królewskie
wardrobe.item.weapon_royal_scepter.desc = Złoto, jabłko z krzyżem, perły, rubiny i szafiry.
wardrobe.item.weapon_urchin_mace = Jeżowiec
wardrobe.item.weapon_urchin_mace.desc = Kolczasty fioletowy jeżowiec na korzeniu z falującymi wodorostami.
wardrobe.item.weapon_clock_hammer = Młot zegarowy
wardrobe.item.weapon_clock_hammer.desc = Na obuchu tyka tarcza zegara, z tyłu kręci się tryb.
wardrobe.item.weapon_mushroom_mace = Grzybowa buława
wardrobe.item.weapon_mushroom_mace.desc = Ogromny muchomor na nóżce. Sprężynuje i sypie zarodnikami.
wardrobe.item.weapon_brazier_mace = Buława-żar
wardrobe.item.weapon_brazier_mace.desc = Żelazna klatka, w której szaleje żywy ogień.
wardrobe.item.head_artist_beret = Beret artysty
wardrobe.item.head_artist_beret.desc = Bordowy beret w plamach farby i pędzel za uchem.
wardrobe.item.head_chef_toque = Czapka kucharska
wardrobe.item.head_chef_toque.desc = Wysoka plisowana czapka z bufiastym czubkiem i wyhaftowaną naszywką.
wardrobe.item.head_firefighter_helmet = Hełm strażacki
wardrobe.item.head_firefighter_helmet.desc = Długie tylne rondo, mosiężny orzeł, tarcza z numerem i odblaski.
wardrobe.item.head_jester_cap = Czapka błazna
wardrobe.item.head_jester_cap.desc = Trzy zwisające rogi w romby, na każdym dzwoni dzwoneczek.
wardrobe.item.head_pumpkin_lantern = Dyniowa latarnia
wardrobe.item.head_pumpkin_lantern.desc = Rzeźbiona dynia zamiast głowy, w środku migocze świeca.
wardrobe.item.head_frog_hat = Czapka-żaba
wardrobe.item.head_frog_hat.desc = Dziergana czapka z wyłupiastymi oczami, rumieńcami i pomponami.
wardrobe.item.head_mariachi_sombrero = Sombrero mariachi
wardrobe.item.head_mariachi_sombrero.desc = Szerokie czarne sombrero ze srebrnym haftem i pomponami na rondzie.
wardrobe.item.head_ice_tiara = Lodowy diadem
wardrobe.item.head_ice_tiara.desc = Srebrna obręcz z lodowymi kolcami, nad nią unoszą się kryształy.
wardrobe.item.head_seraph_halo = Aureola serafina
wardrobe.item.head_seraph_halo.desc = Dwa złote pierścienie wirują przeciwnie, przy skroniach trzepoczą skrzydełka.
wardrobe.item.head_deerstalker = Czapka detektywa
wardrobe.item.head_deerstalker.desc = Tweedowa czapka z dwoma daszkami, klapki na kokardę i fajka w ustach.
wardrobe.item.head_kitsune_mask = Maska kitsune
wardrobe.item.head_kitsune_mask.desc = Biała lisia maska z czerwonymi wzorami przesunięta na bok, chwosty się kołyszą.
wardrobe.item.head_maharaja_turban = Turban maharadży
wardrobe.item.head_maharaja_turban.desc = Szafranowy turban, szmaragdowa brosza, sznury pereł i białe pióro.
wardrobe.item.head_amanita_cap = Kapelusz muchomora
wardrobe.item.head_amanita_cap.desc = Ogromny czerwony kapelusz w białe kropki, blaszki pod spodem i zarodniki.
wardrobe.item.head_graduation_cap = Biret absolwenta
wardrobe.item.head_graduation_cap.desc = Czarny biret ze złotym chwostem, który kołysze się przy chodzeniu.
wardrobe.item.head_propeller_beanie = Czapka ze śmigłem
wardrobe.item.head_propeller_beanie.desc = Tęczowa czapka, śmigło kręci się szybciej, gdy biegniesz lub lecisz.
wardrobe.item.back_monarch_wings = Skrzydła monarchy
wardrobe.item.back_monarch_wings.desc = Pomarańczowe skrzydła motyla z czarnymi żyłkami, w locie trzepoczą szybciej.
wardrobe.item.back_teddy_backpack = Plecak-miś
wardrobe.item.back_teddy_backpack.desc = Pluszowy miś obejmuje cię łapkami przez ramiona.
wardrobe.item.back_turtle_shell = Skorupa żółwia
wardrobe.item.back_turtle_shell.desc = Wypukła skorupa z tarczek na skórzanych pasach.
wardrobe.item.back_skateboard = Deskorolka
wardrobe.item.back_skateboard.desc = Deska z nadrukiem na ukos na plecach, kółka kręcą się w marszu.
wardrobe.item.back_surfboard = Deska surfingowa
wardrobe.item.back_surfboard.desc = Długa deska z paskiem, statecznikami i dyndającą smyczą.
wardrobe.item.back_greatsword_sheath = Miecz na plecach
wardrobe.item.back_greatsword_sheath.desc = Ogromny miecz w okutej pochwie, rękojeść wystaje nad ramieniem.
wardrobe.item.back_clockwork_key = Kluczyk nakręcany
wardrobe.item.back_clockwork_key.desc = Duży mosiężny kluczyk w plecach kręci się, jakbyś był nakręcony.
wardrobe.item.back_phoenix_wings = Skrzydła feniksa
wardrobe.item.back_phoenix_wings.desc = Płonące pióra od złota do szkarłatu, w locie sypią ogniem.
wardrobe.item.back_ice_crystal_wings = Lodowe skrzydła
wardrobe.item.back_ice_crystal_wings.desc = Skrzydła z przejrzystych lodowych odłamków, wokół wiruje śnieg.
wardrobe.item.back_flower_basket = Kosz kwiatów
wardrobe.item.back_flower_basket.desc = Wiklinowy kosz z bukietem, wokół krąży pszczółka.
wardrobe.item.cape_capelet = Wiktoriańska pelerynka
wardrobe.item.cape_capelet.desc = Krótka pelerynka z falbanami i kameą przy zapięciu.
wardrobe.item.cape_journey_scarf = Szal wędrowca
wardrobe.item.cape_journey_scarf.desc = Nieskończenie długi szal ze złotymi glifami ciągnie się za tobą.
wardrobe.item.cape_ranger_hood = Płaszcz tropiciela
wardrobe.item.cape_ranger_hood.desc = Leśny płaszcz z opuszczonym kapturem, zapinką-liściem i postrzępionym dołem.
wardrobe.item.cape_tattered_wraith = Łachmany upiora
wardrobe.item.cape_tattered_wraith.desc = Płaszcz podarty na strzępy, każdy żyje własnym życiem i dymi.
wardrobe.item.cape_quetzal = Płaszcz kwezala
wardrobe.item.cape_quetzal.desc = Rzędy opalizujących piór, długie pióra ogona i nefrytowy kołnierz.
wardrobe.item.cape_wolf_pelt = Wilcza skóra
wardrobe.item.cape_wolf_pelt.desc = Szara skóra z głową wilka na ramieniu i łapami na piersi.
wardrobe.item.cape_hero = Peleryna bohatera
wardrobe.item.cape_hero.desc = Szkarłatna peleryna z wysokim kołnierzem i złotą gwiazdą.
wardrobe.item.cape_matador = Capote matadora
wardrobe.item.cape_matador.desc = Purpurowa peleryna z żółtą podszewką przerzucona przez ramię.
wardrobe.item.cape_opera = Płaszcz operowy
wardrobe.item.cape_opera.desc = Czarny płaszcz na szkarłatnej satynie, stójka i srebrny łańcuszek.
wardrobe.item.cape_mino = Słomiane mino
wardrobe.item.cape_mino.desc = Japoński płaszcz przeciwdeszczowy z warstw słomy z peleryną.
wardrobe.item.cape_pelisse = Pelisa huzarska
wardrobe.item.cape_pelisse.desc = Zarzucona na jedno ramię: futro, złote sznury i zwisający rękaw.
wardrobe.item.cape_stained_glass = Witrażowy płaszcz
wardrobe.item.cape_stained_glass.desc = Mozaika kolorowego szkła w ołowianych ramkach, świeci od środka.
wardrobe.item.cape_waterfall = Płaszcz-wodospad
wardrobe.item.cape_waterfall.desc = Strugi przejrzystej wody spływają po płaszczu i kapią z dołu.
wardrobe.item.cape_ghillie = Peleryna ghillie
wardrobe.item.cape_ghillie.desc = Kudłate pasy kamuflażu i kępy liści na ramionach.
wardrobe.item.cape_lamellar = Płaszcz lamelkowy
wardrobe.item.cape_lamellar.desc = Setki stalowych płytek na czerwonym sznurowaniu, ciężko się kołyszą.
wardrobe.item.cape_bat = Płaszcz nietoperza
wardrobe.item.cape_bat.desc = Błony na żebrach-palcach. W skoku rozkłada się jak skrzydła.
wardrobe.item.cape_kasaya = Kasaja
wardrobe.item.cape_kasaya.desc = Szafranowa patchworkowa szata mnicha przewieszona przez ramię.
wardrobe.item.cape_origami = Płaszcz origami
wardrobe.item.cape_origami.desc = Ostre papierowe fałdy i żurawie machające skrzydłami.
wardrobe.item.cape_jellyfish = Meduza
wardrobe.item.cape_jellyfish.desc = Przejrzysty świecący dzwon i długie macki płynące za tobą.
wardrobe.item.cape_sail = Płaszcz-żagiel
wardrobe.item.cape_sail.desc = Płótno żaglowe ze szwami, oczkami i olinowaniem na drewnianej rei.
wardrobe.item.cape_jarl_fur = Futra jarla
wardrobe.item.cape_jarl_fur.desc = Ciężkie futro na ramionach, tkana lamówka i brązowe zapinki z koralikami.
wardrobe.item.cape_highwayman = Płaszcz rozbójnika
wardrobe.item.cape_highwayman.desc = Długi płaszcz woźnicy z trzema pelerynkami i mosiężnymi guzikami.
wardrobe.item.cape_crystal_shards = Kryształowe odłamki
wardrobe.item.cape_crystal_shards.desc = Unoszące się kryształowe płytki tworzą pelerynę i lekko falują.
wardrobe.item.cape_horo = Horo
wardrobe.item.cape_horo.desc = Wypełniony wiatrem jedwabny balon samuraja z herbem klanu.
wardrobe.item.cape_cloud = Płaszcz z chmur
wardrobe.item.cape_cloud.desc = Puszyste chmury z brzegiem świtu płyną powoli za plecami.
wardrobe.item.weapon_tomahawk = Tomahawk
wardrobe.item.weapon_tomahawk.desc = Malowane stylisko, koraliki i pióra kołyszą się przy każdym zamachu.
wardrobe.item.weapon_executioner_axe = Topór kata
wardrobe.item.weapon_executioner_axe.desc = Ogromny półksiężyc z czarnego żelaza o wyszczerbionym ostrzu.
wardrobe.item.weapon_fire_axe = Topór strażacki
wardrobe.item.weapon_fire_axe.desc = Czerwony topór z kolcem i żółtym gumowym uchwytem.
wardrobe.item.weapon_dwarven_axe = Krasnoludzki topór
wardrobe.item.weapon_dwarven_axe.desc = Podwójne ostrze ze złotymi runami, kamienna głowica i pleciona skóra.
wardrobe.item.weapon_crescent_axe = Topór sierpa księżyca
wardrobe.item.weapon_crescent_axe.desc = Srebrny półksiężyc z gwiezdnym klejnotem i lśniącym ostrzem.
wardrobe.item.weapon_bardiche = Berdysz
wardrobe.item.weapon_bardiche.desc = Długie ostrze-tasak przymocowane do drzewca dwoma pierścieniami.
wardrobe.item.weapon_butcher_cleaver = Tasak rzeźnika
wardrobe.item.weapon_butcher_cleaver.desc = Ogromny prostokątny tasak z otworem, nitami i wytartą rączką.
wardrobe.item.weapon_shark_tooth_axe = Topór z zębów rekina
wardrobe.item.weapon_shark_tooth_axe.desc = Polinezyjska maczuga-topór z rzędem zębów rekina i rzeźbionymi tiki.
wardrobe.item.weapon_stone_axe = Kamienny topór
wardrobe.item.weapon_stone_axe.desc = Łupany krzemień przywiązany surową skórą do krzywej gałęzi.
wardrobe.item.weapon_stormbreaker = Łamacz Burz
wardrobe.item.weapon_stormbreaker.desc = Topór-młot z niebiańskiego metalu, po runie biegną błyskawice.
wardrobe.item.weapon_lumberjack_axe = Siekiera drwala
wardrobe.item.weapon_lumberjack_axe.desc = Obosieczne ostrze i rękojeść w czerwoną kratę.
wardrobe.item.weapon_jade_dragon_axe = Nefrytowy smok
wardrobe.item.weapon_jade_dragon_axe.desc = Nefrytowe ostrze, po drzewcu wije się złoty smok.
wardrobe.item.weapon_amethyst_axe = Ametystowy topór
wardrobe.item.weapon_amethyst_axe.desc = Ostrze z rosnącej druzy ametystu na srebrnym drzewcu.
wardrobe.item.weapon_soul_reaver = Żniwiarz dusz
wardrobe.item.weapon_soul_reaver.desc = Kościane drzewce i widmowe ostrze, w którym jęczą dusze.
wardrobe.item.weapon_epsilon_axe = Topór epsilon
wardrobe.item.weapon_epsilon_axe.desc = Brązowy egipski półksiężyc na trzech języczkach i malowane drzewce.
wardrobe.item.weapon_plasma_axe = Topór plazmowy
wardrobe.item.weapon_plasma_axe.desc = Emiter wytwarza pulsujące ostrze z niebieskiej plazmy.
wardrobe.item.weapon_guitar_axe = Gitaro-topór
wardrobe.item.weapon_guitar_axe.desc = Gitara elektryczna w płomieniach. Każdy cios to akord.
wardrobe.item.weapon_sunforge_axe = Topór słonecznej kuźni
wardrobe.item.weapon_sunforge_axe.desc = Złote ostrze ze słonecznym dyskiem i rozżarzoną krawędzią.
wardrobe.item.weapon_bat_wing_axe = Skrzydła nietoperza
wardrobe.item.weapon_bat_wing_axe.desc = Dwa ostrza-skrzydła z fioletowymi błonami i szkarłatnymi oczami.
wardrobe.item.weapon_celtic_axe = Celtycki topór
wardrobe.item.weapon_celtic_axe.desc = Brodate ostrze z celtyckim węzłem i srebrnymi obręczami.
wardrobe.item.weapon_root_axe = Topór korzeni
wardrobe.item.weapon_root_axe.desc = Drzewce ze splecionych korzeni, mech, kwiaty i kamienne ostrze.
wardrobe.item.weapon_pumpkin_axe = Dyniowy topór
wardrobe.item.weapon_pumpkin_axe.desc = Rzeźbiona dynia zamiast ostrza, w środku migocze świeca.
wardrobe.item.weapon_masakari = Masakari
wardrobe.item.weapon_masakari.desc = Japoński szeroki topór: czarny lakier, biały oplot i fala hamonu.
wardrobe.item.weapon_rift_axe = Topór szczeliny
wardrobe.item.weapon_rift_axe.desc = Ostrze to rozdarta szczelina w pustkę, krążą wokół odłamki.
wardrobe.item.weapon_ice_axe = Czekan
wardrobe.item.weapon_ice_axe.desc = Dziób, łopatka, pętla na nadgarstek i niebieski chwyt.
wardrobe.item.weapon_dory = Dory
wardrobe.item.weapon_dory.desc = Liściasty grot, jesionowe drzewce i brązowy tok.
wardrobe.item.weapon_assegai = Asagaj
wardrobe.item.weapon_assegai.desc = Krótka włócznia z długim szerokim ostrzem i oplotem z krowiej skóry.
wardrobe.item.weapon_guandao = Guandao
wardrobe.item.weapon_guandao.desc = Ciężkie zakrzywione ostrze z paszczy złotego smoka i czerwony chwost.
wardrobe.item.weapon_glaive = Glewia
wardrobe.item.weapon_glaive.desc = Jednosieczne zakrzywione ostrze na drzewcu z tylnym hakiem.
wardrobe.item.weapon_partisan = Partyzana
wardrobe.item.weapon_partisan.desc = Szeroki trójkątny grot ze skrzydełkami i niebieskim chwostem.
wardrobe.item.weapon_hades_bident = Bident Hadesa
wardrobe.item.weapon_hades_bident.desc = Czarne zęby w niebieskim ogniu podziemi.
wardrobe.item.weapon_war_scythe = Kosa bojowa
wardrobe.item.weapon_war_scythe.desc = Wyprostowane ostrze kosy, czaszka i owinięte drzewce.
wardrobe.item.weapon_jumonji_yari = Jumonji yari
wardrobe.item.weapon_jumonji_yari.desc = Krzyżowa japońska włócznia na lakierowanym drzewcu z białym oplotem.
wardrobe.item.weapon_harpoon = Harpun
wardrobe.item.weapon_harpoon.desc = Zadziorowany grot wielorybniczy i zwisający zwój liny.
wardrobe.item.weapon_pitchfork = Widły
wardrobe.item.weapon_pitchfork.desc = Trzy zęby, drewniany trzonek i zaplątana słoma.
wardrobe.item.weapon_gungnir = Gungnir
wardrobe.item.weapon_gungnir.desc = Włócznia Odyna z płonącymi runami i amuletem z pióra kruka.
wardrobe.item.weapon_holy_lance = Święta włócznia
wardrobe.item.weapon_holy_lance.desc = Biało-złota włócznia ze skrzydlatym jelcem i wirującą aureolą.
wardrobe.item.weapon_glacier_spike = Kolec lodowca
wardrobe.item.weapon_glacier_spike.desc = Poszarpany lodowy kolec i oszronione drzewce.
wardrobe.item.weapon_plasma_lance = Lanca plazmowa
wardrobe.item.weapon_plasma_lance.desc = Pulsujący plazmowy grot w pierścieniu emitera.
wardrobe.item.weapon_bone_spear = Kościana włócznia
wardrobe.item.weapon_bone_spear.desc = Zaostrzona kość na ścięgnach i para piór.
wardrobe.item.weapon_serpent_spear = Wężowa włócznia
wardrobe.item.weapon_serpent_spear.desc = Faliste wężowe ostrze i gęsta szkarłatna grzywa.
wardrobe.item.weapon_lotus_spear = Włócznia lotosu
wardrobe.item.weapon_lotus_spear.desc = Nefrytowe drzewce i jelec z rozkwitłych płatków lotosu.
wardrobe.item.weapon_feather_spear = Włócznia z piórami
wardrobe.item.weapon_feather_spear.desc = Krzemienny grot, koraliki i pióra tańczące na wietrze.
wardrobe.item.weapon_void_spear = Włócznia otchłani
wardrobe.item.weapon_void_spear.desc = Mroczny kryształowy grot, wokół krążą odłamki.
wardrobe.item.weapon_banner_spear = Włócznia sztandarowa
wardrobe.item.weapon_banner_spear.desc = Pod grotem powiewa szkarłatny sztandar ze złotym herbem.
wardrobe.item.weapon_demon_trident = Piekielny trójząb
wardrobe.item.weapon_demon_trident.desc = Czarne zadziorowane zęby, szczelinami płynie lawa.
wardrobe.item.weapon_moon_halberd = Księżycowa halabarda
wardrobe.item.weapon_moon_halberd.desc = Ostrze-półksiężyc i gwiezdny kolec w chłodnym blasku.
wardrobe.item.weapon_lantern_spear = Włócznia z latarnią
wardrobe.item.weapon_lantern_spear.desc = Pod grotem kołysze się świecący papierowy lampion.
wardrobe.item.weapon_crystal_spire = Kryształowa iglica
wardrobe.item.weapon_crystal_spire.desc = Druza błękitnych kryształów zamiast grotu, po ściankach biegną błyski.
wardrobe.item.weapon_drill_lance = Lanca-wiertło
wardrobe.item.weapon_drill_lance.desc = Turniejowa lanca-wiertło ze złotą spiralą, kręci się bez przerwy.
wardrobe.item.weapon_xbow_inferno = Kusza „Inferno”
wardrobe.item.weapon_xbow_inferno.desc = Rozżarzone pęknięcia i tańczące płomienie. Ciężkie stalowe łęczysko i kołowrót na kolbie.
wardrobe.item.weapon_xbow_frost = Kusza „Szron”
wardrobe.item.weapon_xbow_frost.desc = Szron, lodowe kolce i chłodny blask. Klasyczne łoże ze strzemieniem.
wardrobe.item.weapon_xbow_void = Kusza „Pustka”
wardrobe.item.weapon_xbow_void.desc = Czarny kamień, wokół unoszą się odłamki pustki. Wygięte łoże, jakby żywe.
wardrobe.item.weapon_xbow_crown = Kusza „Korona”
wardrobe.item.weapon_xbow_crown.desc = Królewskie złoto, rubiny i blanki korony. Klasyczne łoże ze strzemieniem.
wardrobe.item.weapon_xbow_emerald = Kusza „Szmaragd”
wardrobe.item.weapon_xbow_emerald.desc = Szlifowane szmaragdy w srebrnej oprawie. Krótka kusza pistoletowa z rękojeścią.
wardrobe.item.weapon_xbow_amethyst = Kusza „Ametyst”
wardrobe.item.weapon_xbow_amethyst.desc = Druzy ametystu i dźwięczne fioletowe ścianki. Bloczki na końcach ramion i linki.
wardrobe.item.weapon_xbow_storm = Kusza „Burza”
wardrobe.item.weapon_xbow_storm.desc = Burzowa stal, po krawędziach biegną błyskawice. Szkieletowa kolba, szyna i luneta.
wardrobe.item.weapon_xbow_abyss = Kusza „Otchłań”
wardrobe.item.weapon_xbow_abyss.desc = Głębinowy błękit, perły i bąbelki. Klasyczne łoże ze strzemieniem.
wardrobe.item.weapon_xbow_sakura = Kusza „Sakura”
wardrobe.item.weapon_xbow_sakura.desc = Różowa laka i opadające płatki sakury. Krótka kusza pistoletowa z rękojeścią.
wardrobe.item.weapon_xbow_neon = Kusza „Neon”
wardrobe.item.weapon_xbow_neon.desc = Czarny polimer i kwasowe neonowe linie. Szkieletowa kolba, szyna i luneta.
wardrobe.item.weapon_xbow_cogwork = Kusza „Zębatka”
wardrobe.item.weapon_xbow_cogwork.desc = Mosiądz, nity i obracające się zębatki. Magazynek na bełty i dźwignia przeładowania.
wardrobe.item.weapon_xbow_bone = Kusza „Kość”
wardrobe.item.weapon_xbow_bone.desc = Wybielona kość, czaszki i zielony ognik. Wygięte łoże, jakby żywe.
wardrobe.item.weapon_xbow_blood = Kusza „Krew”
wardrobe.item.weapon_xbow_blood.desc = Szkarłatna stal ociekająca czerwienią. Ciężkie stalowe łęczysko i kołowrót na kolbie.
wardrobe.item.weapon_xbow_sun = Kusza „Słońce”
wardrobe.item.weapon_xbow_sun.desc = Białe złoto i promienie południowego słońca. Bloczki na końcach ramion i linki.
wardrobe.item.weapon_xbow_moon = Kusza „Księżyc”
wardrobe.item.weapon_xbow_moon.desc = Srebro, półksiężyc i migoczące gwiazdy. Klasyczne łoże ze strzemieniem.
wardrobe.item.weapon_xbow_nether = Kusza „Nether”
wardrobe.item.weapon_xbow_nether.desc = Szkarłatne grzyby, netheryt i tląca się lawa. Ciężkie stalowe łęczysko i kołowrót na kolbie.
wardrobe.item.weapon_xbow_ender = Kusza „Ender”
wardrobe.item.weapon_xbow_ender.desc = Kamień Kresu, oczy Kresu i fioletowe iskry. Magazynek na bełty i dźwignia przeładowania.
wardrobe.item.weapon_xbow_candy = Kusza „Cukierek”
wardrobe.item.weapon_xbow_candy.desc = Cukierkowe paski i lukier. Krótka kusza pistoletowa z rękojeścią.
wardrobe.item.weapon_xbow_toxin = Kusza „Toksyna”
wardrobe.item.weapon_xbow_toxin.desc = Trująco zielony szlam, krople i bąble. Magazynek na bełty i dźwignia przeładowania.
wardrobe.item.weapon_xbow_jungle = Kusza „Dżungla”
wardrobe.item.weapon_xbow_jungle.desc = Żywe pnącza, liście i mech. Klasyczne łoże ze strzemieniem.
wardrobe.item.weapon_xbow_pharaoh = Kusza „Faraon”
wardrobe.item.weapon_xbow_pharaoh.desc = Piaskowiec, lapis i złote anchy. Szkieletowa kolba, szyna i luneta.
wardrobe.item.weapon_xbow_rune = Kusza „Runa”
wardrobe.item.weapon_xbow_rune.desc = Północne żelazo i świecące runy. Ciężkie stalowe łęczysko i kołowrót na kolbie.
wardrobe.item.weapon_xbow_galaxy = Kusza „Galaktyka”
wardrobe.item.weapon_xbow_galaxy.desc = Kosmiczny błękit w gwiezdnym pyle. Bloczki na końcach ramion i linki.
wardrobe.item.weapon_xbow_obsidian = Kusza „Obsydian”
wardrobe.item.weapon_xbow_obsidian.desc = Wulkaniczne szkło o ostrych krawędziach. Wygięte łoże, jakby żywe.
wardrobe.item.weapon_xbow_prismarine = Kusza „Pryzmaryn”
wardrobe.item.weapon_xbow_prismarine.desc = Pryzmaryn, latarnie morskie i łuski. Dwa łęczyska jedno nad drugim.
wardrobe.item.weapon_xbow_dragon = Kusza „Smok”
wardrobe.item.weapon_xbow_dragon.desc = Smocze łuski, rogi i ogniste oko. Wygięte łoże, jakby żywe.
wardrobe.item.weapon_xbow_angel = Kusza „Anioł”
wardrobe.item.weapon_xbow_angel.desc = Białe pióra, aureola i miękkie światło. Dwa łęczyska jedno nad drugim.
wardrobe.item.weapon_xbow_demon = Kusza „Demon”
wardrobe.item.weapon_xbow_demon.desc = Czarne rogi, błony i piekielny żar. Magazynek na bełty i dźwignia przeładowania.
wardrobe.item.weapon_xbow_ruby = Kusza „Rubin”
wardrobe.item.weapon_xbow_ruby.desc = Głęboki rubin w szlifie kaboszonowym. Krótka kusza pistoletowa z rękojeścią.
wardrobe.item.weapon_xbow_sapphire = Kusza „Szafir”
wardrobe.item.weapon_xbow_sapphire.desc = Szafirowe ścianki i chłodny blask platyny. Dwa łęczyska jedno nad drugim.
wardrobe.item.weapon_xbow_copper = Kusza „Miedź”
wardrobe.item.weapon_xbow_copper.desc = Miedź w turkusowej patynie. Magazynek na bełty i dźwignia przeładowania.
wardrobe.item.weapon_xbow_glitch = Kusza „Glitch”
wardrobe.item.weapon_xbow_glitch.desc = Piksele rozjeżdżają się i drżą jak uszkodzony plik. Szkieletowa kolba, szyna i luneta.
wardrobe.item.weapon_xbow_rainbow = Kusza „Tęcza”
wardrobe.item.weapon_xbow_rainbow.desc = Wszystkie kolory tęczy mienią się na ściankach. Dwa łęczyska jedno nad drugim.
wardrobe.item.item_gapple_inferno = Złote jabłko „Inferno”
wardrobe.item.item_gapple_inferno.desc = Rozżarzone pęknięcia i tańczące płomienie. Okrągłe jabłko z listkiem.
wardrobe.item.item_gapple_frost = Złote jabłko „Szron”
wardrobe.item.item_gapple_frost.desc = Szron, lodowe kolce i chłodny blask. Wydłużone jabłko na długiej szypułce.
wardrobe.item.item_gapple_void = Złote jabłko „Pustka”
wardrobe.item.item_gapple_void.desc = Czarny kamień, wokół unoszą się odłamki pustki. Oszlifowane jak klejnot.
wardrobe.item.item_gapple_crown = Złote jabłko „Korona”
wardrobe.item.item_gapple_crown.desc = Królewskie złoto, rubiny i blanki korony. Okrągłe jabłko z listkiem.
wardrobe.item.item_gapple_emerald = Złote jabłko „Szmaragd”
wardrobe.item.item_gapple_emerald.desc = Szlifowane szmaragdy w srebrnej oprawie. Oszlifowane jak klejnot.
