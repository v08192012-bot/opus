wardrobe.item.item_gapple_nether = Złote jabłko „Nether”
wardrobe.item.item_gapple_nether.desc = Szkarłatne grzyby, netheryt i tląca się lawa. Nadgryzione — widać soczysty miąższ.
wardrobe.item.item_gapple_ender = Złote jabłko „Ender”
wardrobe.item.item_gapple_ender.desc = Kamień Kresu, oczy Kresu i fioletowe iskry. Oszlifowane jak klejnot.
