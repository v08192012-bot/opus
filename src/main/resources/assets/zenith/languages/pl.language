wardrobe.item.item_gapple_obsidian.desc = Wulkaniczne szkło o ostrych krawędziach. Oszlifowane jak klejnot.
wardrobe.item.item_gapple_prismarine = Złote jabłko „Pryzmaryn”
wardrobe.item.item_gapple_prismarine.desc = Pryzmaryn, latarnie morskie i łuski. Sześcienne jabłko o gładkich ściankach.
