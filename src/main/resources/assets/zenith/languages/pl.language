wardrobe.item.item_anchor_inferno = Kotwica „Inferno”
wardrobe.item.item_anchor_inferno.desc = Rozżarzone pęknięcia i tańczące płomienie. Spętany łańcuchami, po ściankach spływają łzy.
wardrobe.item.item_anchor_frost = Kotwica „Szron”
wardrobe.item.item_anchor_frost.desc = Szron, lodowe kolce i chłodny blask. Narożne kolumny i cztery ładunki na górze.
wardrobe.item.item_anchor_void = Kotwica „Pustka”
wardrobe.item.item_anchor_void.desc = Czarny kamień, wokół unoszą się odłamki pustki. Nad pokrywą wiruje pierścień mocy.
wardrobe.item.item_anchor_crown = Kotwica „Korona”
wardrobe.item.item_anchor_crown.desc = Królewskie złoto, rubiny i blanki korony. Narożne kolumny i cztery ładunki na górze.
wardrobe.item.item_anchor_emerald = Kotwica „Szmaragd”
wardrobe.item.item_anchor_emerald.desc = Szlifowane szmaragdy w srebrnej oprawie. Schodkowy monolit z pulsującym rdzeniem.
wardrobe.item.item_anchor_amethyst = Kotwica „Ametyst”
wardrobe.item.item_anchor_amethyst.desc = Druzy ametystu i dźwięczne fioletowe ścianki. Rdzeń zamknięty w klatce z prętów.
