wardrobe.item.item_crystal_emerald = Kryształ „Szmaragd”
wardrobe.item.item_crystal_emerald.desc = Szlifowane szmaragdy w srebrnej oprawie. Druza ostrych kryształów na kamieniu.
wardrobe.item.item_crystal_amethyst = Kryształ „Ametyst”
wardrobe.item.item_crystal_amethyst.desc = Druzy ametystu i dźwięczne fioletowe ścianki. Druza ostrych kryształów na kamieniu.
wardrobe.item.item_crystal_storm = Kryształ „Burza”
wardrobe.item.item_crystal_storm.desc = Burzowa stal, po krawędziach biegną błyskawice. Dwa skrzyżowane kryształy w złotym pierścieniu.
wardrobe.item.item_crystal_abyss = Kryształ „Otchłań”
wardrobe.item.item_crystal_abyss.desc = Głębinowy błękit, perły i bąbelki. Wokół kryształu krążą małe odłamki.
wardrobe.item.item_crystal_sakura = Kryształ „Sakura”
wardrobe.item.item_crystal_sakura.desc = Różowa laka i opadające płatki sakury. Kwarc w dwóch wirujących ramach nad cokołem.
wardrobe.item.item_crystal_neon = Kryształ „Neon”
wardrobe.item.item_crystal_neon.desc = Czarny polimer i kwasowe neonowe linie. Dwa skrzyżowane kryształy w złotym pierścieniu.
wardrobe.item.item_crystal_cogwork = Kryształ „Zębatka”
wardrobe.item.item_crystal_cogwork.desc = Mosiądz, nity i obracające się zębatki. Szlif brylantowy, unosi się i wiruje.
wardrobe.item.item_crystal_bone = Kryształ „Kość”
wardrobe.item.item_crystal_bone.desc = Wybielona kość, czaszki i zielony ognik. Druza ostrych kryształów na kamieniu.
wardrobe.item.item_crystal_blood = Kryształ „Krew”
wardrobe.item.item_crystal_blood.desc = Szkarłatna stal ociekająca czerwienią. Kwarc w dwóch wirujących ramach nad cokołem.
wardrobe.item.item_crystal_sun = Kryształ „Słońce”
wardrobe.item.item_crystal_sun.desc = Białe złoto i promienie południowego słońca. Szlif brylantowy, unosi się i wiruje.
wardrobe.item.item_crystal_moon = Kryształ „Księżyc”
wardrobe.item.item_crystal_moon.desc = Srebro, półksiężyc i migoczące gwiazdy. Wokół kryształu krążą małe odłamki.
wardrobe.item.item_crystal_nether = Kryształ „Nether”
wardrobe.item.item_crystal_nether.desc = Szkarłatne grzyby, netheryt i tląca się lawa. Druza ostrych kryształów na kamieniu.
wardrobe.item.item_crystal_ender = Kryształ „Ender”
wardrobe.item.item_crystal_ender.desc = Kamień Kresu, oczy Kresu i fioletowe iskry. Kwarc w dwóch wirujących ramach nad cokołem.
wardrobe.item.item_crystal_candy = Kryształ „Cukierek”
wardrobe.item.item_crystal_candy.desc = Cukierkowe paski i lukier. Dwa skrzyżowane kryształy w złotym pierścieniu.
wardrobe.item.item_crystal_toxin = Kryształ „Toksyna”
wardrobe.item.item_crystal_toxin.desc = Trująco zielony szlam, krople i bąble. Wokół kryształu krążą małe odłamki.
wardrobe.item.item_crystal_jungle = Kryształ „Dżungla”
wardrobe.item.item_crystal_jungle.desc = Żywe pnącza, liście i mech. Druza ostrych kryształów na kamieniu.
wardrobe.item.item_crystal_pharaoh = Kryształ „Faraon”
wardrobe.item.item_crystal_pharaoh.desc = Piaskowiec, lapis i złote anchy. Szlif brylantowy, unosi się i wiruje.
wardrobe.item.item_crystal_rune = Kryształ „Runa”
wardrobe.item.item_crystal_rune.desc = Północne żelazo i świecące runy. Kwarc w dwóch wirujących ramach nad cokołem.
wardrobe.item.item_crystal_galaxy = Kryształ „Galaktyka”
wardrobe.item.item_crystal_galaxy.desc = Kosmiczny błękit w gwiezdnym pyle. Wokół kryształu krążą małe odłamki.
wardrobe.item.item_crystal_obsidian = Kryształ „Obsydian”
wardrobe.item.item_crystal_obsidian.desc = Wulkaniczne szkło o ostrych krawędziach. Dwa skrzyżowane kryształy w złotym pierścieniu.
wardrobe.item.item_crystal_prismarine = Kryształ „Pryzmaryn”
wardrobe.item.item_crystal_prismarine.desc = Pryzmaryn, latarnie morskie i łuski. Druza ostrych kryształów na kamieniu.
wardrobe.item.item_crystal_dragon = Kryształ „Smok”
wardrobe.item.item_crystal_dragon.desc = Smocze łuski, rogi i ogniste oko. Dwa skrzyżowane kryształy w złotym pierścieniu.
wardrobe.item.item_crystal_angel = Kryształ „Anioł”
wardrobe.item.item_crystal_angel.desc = Białe pióra, aureola i miękkie światło. Szlif brylantowy, unosi się i wiruje.
wardrobe.item.item_crystal_demon = Kryształ „Demon”
wardrobe.item.item_crystal_demon.desc = Czarne rogi, błony i piekielny żar. Kwarc w dwóch wirujących ramach nad cokołem.
wardrobe.item.item_crystal_ruby = Kryształ „Rubin”
wardrobe.item.item_crystal_ruby.desc = Głęboki rubin w szlifie kaboszonowym. Druza ostrych kryształów na kamieniu.
wardrobe.item.item_crystal_sapphire = Kryształ „Szafir”
wardrobe.item.item_crystal_sapphire.desc = Szafirowe ścianki i chłodny blask platyny. Szlif brylantowy, unosi się i wiruje.
wardrobe.item.item_crystal_copper = Kryształ „Miedź”
wardrobe.item.item_crystal_copper.desc = Miedź w turkusowej patynie. Dwa skrzyżowane kryształy w złotym pierścieniu.
wardrobe.item.item_crystal_glitch = Kryształ „Glitch”
wardrobe.item.item_crystal_glitch.desc = Piksele rozjeżdżają się i drżą jak uszkodzony plik. Wokół kryształu krążą małe odłamki.
wardrobe.item.item_crystal_rainbow = Kryształ „Tęcza”
wardrobe.item.item_crystal_rainbow.desc = Wszystkie kolory tęczy mienią się na ściankach. Dwa skrzyżowane kryształy w złotym pierścieniu.
wardrobe.item.item_totem_putin = Totem „Putin”
wardrobe.item.item_totem_putin.desc = Ciemny garnitur, bordowy krawat i rozpostarte ręce totemu nieśmiertelności.
wardrobe.set.gentleman = Dżentelmen
wardrobe.set.gentleman.bonus = Pełny zestaw: wokół wirują złote iskierki.
wardrobe.set.cyber = Cyberpunk
wardrobe.set.cyber.bonus = Pełny zestaw: neonowe wyładowania wokół postaci.
wardrobe.set.knight = Rycerz
wardrobe.set.knight.bonus = Pełny zestaw: blask błogosławionej stali.
wardrobe.set.pirate = Pirat
wardrobe.set.pirate.bonus = Pełny zestaw: bryzgi morskiej fali.
wardrobe.set.ninja = Ninja
wardrobe.set.ninja.bonus = Pełny zestaw: otula cię lekki dym.
wardrobe.set.bogatyr = Bohatyr
wardrobe.set.bogatyr.bonus = Pełny zestaw: złoty pył bohaterskiej chwały.
wardrobe.set.pharaoh = Faraon
wardrobe.set.pharaoh.bonus = Pełny zestaw: wokół migocze piasek pustyni.
wardrobe.set.steampunk = Parowy aeronauta
wardrobe.set.steampunk.bonus = Pełny zestaw: kłęby pary z zaworów.
wardrobe.set.plague = Doktor dżumy
wardrobe.set.plague.bonus = Pełny zestaw: smuga leczniczych ziół.
wardrobe.set.hoplite = Hoplita
wardrobe.set.hoplite.bonus = Pełny zestaw: brązowe iskry przy każdym kroku.
wardrobe.set.tuareg = Tuareg
wardrobe.set.tuareg.bonus = Pełny zestaw: podąża za tobą piaskowy wir.
wardrobe.set.racer = Kierowca
wardrobe.set.racer.bonus = Pełny zestaw: iskry linii mety.
wardrobe.set.mecha = Pilot mecha
wardrobe.set.mecha.bonus = Pełny zestaw: energetyczne iskry reaktora.
wardrobe.set.diver = Nurek
wardrobe.set.diver.bonus = Pełny zestaw: wokół pękają bąbelki.
module.crystalaura.description = Stawia i detonuje kryształy oraz kotwice odrodzenia: obrażenia jak w vanilli ze zbroją, zaklęciami i poziomem trudności, przewidywanie ruchu celu, timingi dopasowane do anticheata z presetu
module.crystalAura.preset = Preset
module.crystalAura.preset.desc = Gotowe ustawienia pod anticheat serwera, Własny odblokowuje wszystkie parametry
module.crystalAura.presetCustom = Własny
module.crystalAura.presetNone = Bez anticheata
