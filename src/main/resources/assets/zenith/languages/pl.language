gui.tools.inv.desc = Fills the inventory on its own: the set from the grid is bought up on the auction.
gui.tools.inv.empty = nothing found
gui.tools.inv.caption.set = Set
gui.tools.inv.caption.run = Run
gui.tools.inv.caption.slot = Slot
gui.tools.inv.list.items = Catalog
gui.tools.inv.list.presets = Presets
gui.tools.inv.list.history = Purchases
gui.tools.inv.catalog.desc = Click puts the item into the set, right click takes every copy of it back out.
gui.tools.inv.catalog.none = nothing found
gui.tools.inv.catalog.none.desc = The search box in the menu header looks through catalog item names.
gui.tools.inv.hint.empty = Click an item in the list below and it lands in the set
gui.tools.inv.hint.idle = Click a slot to select it, right click to clear it
gui.tools.inv.hint.slotEmpty = Slot selected: click an item in the list below
gui.tools.inv.hint.slotFilled = Tune the slot on the right, or clear it with a right click
gui.tools.inv.slot = Slot
gui.tools.inv.slot.empty.desc = Pick a slot, then an item from the list, and it lands here.
gui.tools.inv.slot.filled.desc = Click opens the slot settings, right click removes the item.
gui.tools.inv.search.hint = search the catalog
gui.tools.inv.capture = Preset from inventory
gui.tools.inv.capture.desc = Copies the current inventory into the set and saves it as a preset. The name comes from the field on the right, or is picked automatically when it is empty.
gui.tools.inv.capture.name = Inventory
gui.tools.inv.capture.done = AutoGather: preset {name}, items taken from the inventory: {count}
gui.tools.inv.capture.missed = · not found in the catalog: {count}
gui.tools.inv.capture.none = AutoGather: nothing in the inventory to save
gui.tools.inv.capture.noPlayer = AutoGather: the inventory can only be read in game
gui.tools.inv.clear = Clear
gui.tools.inv.clear.desc = Removes every item from the set.
gui.tools.inv.start = Start
gui.tools.inv.start.desc = Starts buying the set up on the auction.
gui.tools.inv.stop = Stop
gui.tools.inv.stop.desc = Stops the run.
gui.tools.inv.server = Server
gui.tools.inv.status = State
gui.tools.inv.status.desc = What the run is doing right now.
gui.tools.inv.progress = Progress
gui.tools.inv.target = Looking for
gui.tools.inv.target.desc = The item the run is hunting on the auction.
gui.tools.inv.slot.none = no slot selected
gui.tools.inv.slot.none.desc = Click a set slot to configure it.
gui.tools.inv.count = Count
gui.tools.inv.count.desc = How many are needed in this slot. Shift makes the step ten times bigger.
gui.tools.inv.price = Price each
gui.tools.inv.price.any = any
gui.tools.inv.price.desc = A lot above this price is skipped, zero buys at any price. Shift makes the step ten times bigger.
gui.tools.inv.durability = Durability
gui.tools.inv.durability.desc = A lot below this share of durability is skipped.
gui.tools.inv.have = Already have
gui.tools.inv.have.desc = How many of these are already in the inventory.
gui.tools.inv.remove = Remove from set
gui.tools.inv.remove.desc = Frees this slot of the set.
gui.tools.inv.full = AutoGather: no free slots left in the set
gui.tools.inv.presets.none = no presets yet
gui.tools.inv.presets.none.desc = Build a set and save it under a name from the field above, or capture a ready inventory with one button.
gui.tools.inv.presets.desc = Click loads the preset into the set, right click deletes it.
gui.tools.inv.presets.loaded = AutoGather: preset {name} loaded
gui.tools.inv.presets.lost = · entries missing from this server catalog: {count}
gui.tools.inv.presets.needName = AutoGather: enter a preset name
gui.tools.inv.presets.needItems = AutoGather: the set is empty
gui.tools.inv.presets.saved = AutoGather: preset {name} saved
gui.tools.inv.presets.replaced = AutoGather: preset {name} overwritten
gui.tools.inv.presets.hint = preset name
gui.tools.inv.presets.save = Save
gui.tools.inv.presets.save.desc = Saves the current set as a preset. Presets live in the config and travel with it.
gui.tools.inv.history.none = no purchases yet
gui.tools.inv.history.none.desc = Lots bought on recent runs show up here.
gui.tools.inv.history.desc = What the run bought and for how much.

gui.tools.craft.desc = What to craft, what it takes, and why it is not running.
gui.tools.craft.caption.presets = Recipes
gui.tools.craft.caption.around = Around you
gui.tools.craft.caption.sources = Resources
gui.tools.craft.caption.options = Options
gui.tools.craft.pick = Pick a recipe
gui.tools.craft.pick.hint = The list below is your recipe book. Click a row.
gui.tools.craft.recipe.desc = What the recipe takes and what it yields. On the right: how many crafts your inventory covers.
gui.tools.craft.stock.enough = enough for {n}
gui.tools.craft.stock.none = no resources
gui.tools.craft.start = Start crafting
gui.tools.craft.start.desc = Autocraft walks up to the workbench, tops up resources from nearby chests and starts crafting.
