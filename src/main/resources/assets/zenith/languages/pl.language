module.crystalAura.surroundKey = Obudowa z obsydianu (bind)
module.crystalAura.surroundKey.desc = Po naciśnięciu stawia obsydian w 4 polach wokół stóp (w razie potrzeby z podporą), przed innymi akcjami aury. Anuluje się po wyjściu z bloku lub po 3 s.
module.crystalAura.surroundMode = Co budować
module.crystalAura.surroundMode.desc = Preset obudowy: zwykły — 4 obsydiany przy stopach; podwójny — plus 4 na wysokości głowy; anty-city — plus 4 pola na zewnątrz; bunkier — stopy, głowa, góra i dół
module.crystalAura.surroundNormal = Zwykły (4)
module.crystalAura.surroundDouble = Podwójny (8)
module.crystalAura.surroundCity = Anty-city (8)
module.crystalAura.surroundBunker = Bunkier (10)
module.crystalAura.mineDamage = Obrażenia do kopania
module.crystalAura.mineDamage.desc = Długie kopanie (city, bomber, podkop pod kryształ) tylko dla takich obrażeń
module.crystalAura.mineTime = Maks. czas kopania
module.crystalAura.mineTime.desc = Bloki, które najlepszym narzędziem kopią się dłużej, są pomijane
module.crystalAura.shieldDamage = Próg obrony
module.crystalAura.shieldDamage.desc = Zasłaniaj miejsca, z których wróg zada więcej obrażeń
module.crystalAura.mode = Tryb
module.crystalAura.mode.desc = Vanilla obraca się w jednym ticku i działa w następnym; ReallyWorld działa zaraz po wysłaniu obrotu
module.crystalAura.placeRange = Zasięg stawiania
