wardrobe.item.item_totem_storm = Fırtına Totemi
wardrobe.item.item_totem_storm.desc = Fırtına çeliği; kenarlarında şimşekler koşar. Sırtında kanatlar açılmış.
wardrobe.item.item_totem_abyss = Derinlik Totemi
wardrobe.item.item_totem_abyss.desc = Derin deniz mavisi, inciler ve kabarcıklar. Kukuleta, cüppe ve koruyucu asa.
wardrobe.item.item_totem_sakura = Sakura Totemi
wardrobe.item.item_totem_sakura.desc = Pembe lake ve düşen sakura yaprakları. Bir taç ve ağır bir yaka.
wardrobe.item.item_totem_neon = Neon Totemi
wardrobe.item.item_totem_neon.desc = Siyah polimer ve asit neon çizgiler. Açılmış kollar ve parlayan gözler.
wardrobe.item.item_totem_cogwork = Çark Totemi
wardrobe.item.item_totem_cogwork.desc = Pirinç, perçinler ve dönen dişliler. Açılmış kollar ve parlayan gözler.
wardrobe.item.item_totem_bone = Kemik Totemi
wardrobe.item.item_totem_bone.desc = Ağarmış kemik, kafatasları ve yeşil bir ışık. Boynuzlar, dişler ve kuyruk.
wardrobe.item.item_totem_blood = Kan Totemi
wardrobe.item.item_totem_blood.desc = Kızıl damlaları süzülen al çelik. Boynuzlar, dişler ve kuyruk.
wardrobe.item.item_totem_sun = Güneş Totemi
wardrobe.item.item_totem_sun.desc = Beyaz altın ve öğle güneşinin ışınları. Sırtında kanatlar açılmış.
wardrobe.item.item_totem_moon = Ay Totemi
wardrobe.item.item_totem_moon.desc = Gümüş, hilal ve parıldayan yıldızlar. Kukuleta, cüppe ve koruyucu asa.
wardrobe.item.item_totem_nether = Nether Totemi
wardrobe.item.item_totem_nether.desc = Kızıl mantarlar, netherit ve için için yanan lav. Boynuzlar, dişler ve kuyruk.
wardrobe.item.item_totem_ender = Ender Totemi
wardrobe.item.item_totem_ender.desc = End taşı, ender gözleri ve mor kıvılcımlar. Kukuleta, cüppe ve koruyucu asa.
wardrobe.item.item_totem_candy = Şeker Totemi
wardrobe.item.item_totem_candy.desc = Şeker çizgileri ve şeker sırı. Açılmış kollar ve parlayan gözler.
wardrobe.item.item_totem_toxin = Zehir Totemi
wardrobe.item.item_totem_toxin.desc = Zehir yeşili balçık, damlalar ve kabarcıklar. Boynuzlar, dişler ve kuyruk.
wardrobe.item.item_totem_jungle = Orman Totemi
wardrobe.item.item_totem_jungle.desc = Canlı sarmaşıklar, yapraklar ve yosun. Açılmış kollar ve parlayan gözler.
wardrobe.item.item_totem_pharaoh = Firavun Totemi
wardrobe.item.item_totem_pharaoh.desc = Kumtaşı, lacivert taş ve altın ankhlar. Bir taç ve ağır bir yaka.
wardrobe.item.item_totem_rune = Rün Totemi
wardrobe.item.item_totem_rune.desc = Kuzey demiri ve parlayan rünler. Kukuleta, cüppe ve koruyucu asa.
wardrobe.item.item_totem_galaxy = Galaksi Totemi
wardrobe.item.item_totem_galaxy.desc = Yıldız tozuna bulanmış kozmik mavi. Sırtında kanatlar açılmış.
wardrobe.item.item_totem_obsidian = Obsidyen Totemi
wardrobe.item.item_totem_obsidian.desc = Keskin kenarlı volkanik cam. Boynuzlar, dişler ve kuyruk.
wardrobe.item.item_totem_prismarine = Prizmarin Totemi
wardrobe.item.item_totem_prismarine.desc = Prizmarin, deniz fenerleri ve pullar. Bir taç ve ağır bir yaka.
wardrobe.item.item_totem_dragon = Ejderha Totemi
wardrobe.item.item_totem_dragon.desc = Ejderha pulları, boynuzlar ve ateşli bir göz. Sırtında kanatlar açılmış.
wardrobe.item.item_totem_angel = Melek Totemi
wardrobe.item.item_totem_angel.desc = Beyaz tüyler, bir hale ve yumuşak ışık. Sırtında kanatlar açılmış.
wardrobe.item.item_totem_demon = İblis Totemi
wardrobe.item.item_totem_demon.desc = Kara boynuzlar, zarlar ve cehennem sıcağı. Boynuzlar, dişler ve kuyruk.
wardrobe.item.item_totem_ruby = Yakut Totemi
wardrobe.item.item_totem_ruby.desc = Kabaşon kesimli koyu yakut. Bir taç ve ağır bir yaka.
wardrobe.item.item_totem_sapphire = Safir Totemi
wardrobe.item.item_totem_sapphire.desc = Safir yüzeyler ve platinin soğuk parıltısı. Açılmış kollar ve parlayan gözler.
wardrobe.item.item_totem_copper = Bakır Totemi
wardrobe.item.item_totem_copper.desc = Turkuaz patinalı bakır. Açılmış kollar ve parlayan gözler.
wardrobe.item.item_totem_glitch = Arıza Totemi
wardrobe.item.item_totem_glitch.desc = Pikseller bozuk bir dosya gibi kayıp titrer. Kukuleta, cüppe ve koruyucu asa.
wardrobe.item.item_totem_rainbow = Gökkuşağı Totemi
wardrobe.item.item_totem_rainbow.desc = Gökkuşağının tüm renkleri yüzeylerde parlar. Bir taç ve ağır bir yaka.
wardrobe.item.item_anchor_inferno = Cehennem Çapası
wardrobe.item.item_anchor_inferno.desc = Kor çatlaklar ve dans eden alevler. Zincirlere sarılı; yanlarından gözyaşları süzülür.
wardrobe.item.item_anchor_frost = Ayaz Çapası
wardrobe.item.item_anchor_frost.desc = Kırağı, buz dikenleri ve soğuk bir ışıltı. Köşe sütunları ve üstte dört yük.
wardrobe.item.item_anchor_void = Hiçlik Çapası
wardrobe.item.item_anchor_void.desc = Kara taş, çevresinde hiçlik parçaları süzülür. Kapağın üstünde bir güç halkası döner.
wardrobe.item.item_anchor_crown = Taç Çapası
wardrobe.item.item_anchor_crown.desc = Kraliyet altını, yakutlar ve taç dişleri. Köşe sütunları ve üstte dört yük.
wardrobe.item.item_anchor_emerald = Zümrüt Çapası
wardrobe.item.item_anchor_emerald.desc = Gümüş yuvada kesme zümrütler. Atan bir çekirdekli basamaklı monolit.
wardrobe.item.item_anchor_amethyst = Ametist Çapası
