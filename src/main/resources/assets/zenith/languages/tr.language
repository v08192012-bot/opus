quick.chat.desc = İstemcinin genel sohbeti.
quick.description = Açıklamalar
quick.description.desc = Menü satırlarının açıklamalarını üzerine gelince göster.
quick.devlog = Devlog
quick.devlog.desc = İstemci değişikliklerinin yazıldığı kanal.
quick.discord = Discord RPC
quick.discord.desc = Discord'da Zenith ile oynadığını göster.
quick.folder = İstemci klasörü
quick.folder.desc = Ayarların, ekran görüntülerinin ve logların olduğu klasör.
quick.icons = Ayar simgeleri
quick.icons.desc = Her ayarın soluna bir simge çiz.
quick.language = Dil
quick.language.desc = Tüm istemci arayüzünün dili. Modül ve kategori adları olduğu gibi kalır.
quick.menuScale = Menü ölçeği
quick.menuScale.desc = Menünün ne kadar büyük çizileceği. Büyük ekranlarda daha yükseğini seç.
quick.playtime.session = Oturum
quick.playtime.total = Toplam
quick.playtime.week = Hafta
quick.streamer = Yayıncı modu
quick.streamer.desc = Takma adları, koordinatları ve diğer hassas şeyleri ekrandan gizler.
quick.sub.expired = abonelik doldu
quick.sub.renew = Uzat
quick.sub.till = şu tarihe kadar
quick.value.off = kapalı
quick.value.open = aç
quick.webProfile = Web profili
quick.webProfile.desc = Sitedeki hesap sayfan.




