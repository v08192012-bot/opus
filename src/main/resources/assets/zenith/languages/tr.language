wardrobe.item.cape_crystal_shards.desc = Süzülen kristal plakalar bir pelerin oluşturur ve hafifçe salınır.
wardrobe.item.cape_horo = Horo
wardrobe.item.cape_horo.desc = Klan armalı, rüzgârla şişmiş samuray ipek balonu.
wardrobe.item.cape_cloud = Bulut Pelerin
wardrobe.item.cape_cloud.desc = Gün doğumu kenarlı kabarık bulutlar arkanda süzülür.
wardrobe.item.weapon_tomahawk = Tomahavk
wardrobe.item.weapon_tomahawk.desc = Boyalı sap; boncuklar ve tüyler her savuruşta sallanır.
wardrobe.item.weapon_executioner_axe = Cellat Baltası
wardrobe.item.weapon_executioner_axe.desc = Çentikli ağızlı, kara demirden devasa bir hilal.
wardrobe.item.weapon_fire_axe = İtfaiye Baltası
wardrobe.item.weapon_fire_axe.desc = Kazma uçlu, sarı lastik saplı kırmızı balta.
wardrobe.item.weapon_dwarven_axe = Cüce Savaş Baltası
wardrobe.item.weapon_dwarven_axe.desc = Altın rünlü çift ağız, taş topuz ve örgü deri.
wardrobe.item.weapon_crescent_axe = Hilal Ay Baltası
wardrobe.item.weapon_crescent_axe.desc = Yıldız taşlı, parlayan ağızlı gümüş hilal.
wardrobe.item.weapon_bardiche = Bardiş
wardrobe.item.weapon_bardiche.desc = Sapa iki halkayla bağlanmış uzun satır ağzı.
wardrobe.item.weapon_butcher_cleaver = Kasap Satırı
wardrobe.item.weapon_butcher_cleaver.desc = Delikli, perçinli ve aşınmış saplı dev dikdörtgen satır.
wardrobe.item.weapon_shark_tooth_axe = Köpekbalığı Dişi Baltası
wardrobe.item.weapon_shark_tooth_axe.desc = Köpekbalığı dişli, oyma tiki yüzlü Polinezya savaş baltası.
wardrobe.item.weapon_stone_axe = Taş Balta
wardrobe.item.weapon_stone_axe.desc = Ham deriyle eğri bir dala bağlanmış yontma çakmaktaşı.
wardrobe.item.weapon_stormbreaker = Fırtınakıran
wardrobe.item.weapon_stormbreaker.desc = Gök metalinden balta-çekiç; rününde şimşekler koşar.
wardrobe.item.weapon_lumberjack_axe = Oduncu Baltası
wardrobe.item.weapon_lumberjack_axe.desc = Çift ağız ve kırmızı ekose sargılı sap.
wardrobe.item.weapon_jade_dragon_axe = Yeşim Ejder Baltası
wardrobe.item.weapon_jade_dragon_axe.desc = Yeşim ağız; sapa altın bir ejder sarılır.
wardrobe.item.weapon_amethyst_axe = Ametist Balta
wardrobe.item.weapon_amethyst_axe.desc = Gümüş sap üzerinde büyüyen ametist kristallerinden ağız.
wardrobe.item.weapon_soul_reaver = Ruh Biçen
wardrobe.item.weapon_soul_reaver.desc = Kemik sap ve ruhların inlediği hayalet ağız.
wardrobe.item.weapon_epsilon_axe = Epsilon Balta
wardrobe.item.weapon_epsilon_axe.desc = Üç dilli bronz Mısır hilali ve boyalı sap.
wardrobe.item.weapon_plasma_axe = Plazma Balta
wardrobe.item.weapon_plasma_axe.desc = Yayıcı, mavi plazmadan titreşen bir ağız oluşturur.
wardrobe.item.weapon_guitar_axe = Gitar Balta
wardrobe.item.weapon_guitar_axe.desc = Alev desenli elektro gitar. Her vuruş bir akor.
wardrobe.item.weapon_sunforge_axe = Güneş Dövmesi Balta
wardrobe.item.weapon_sunforge_axe.desc = Güneş diskli, kor kenarlı altın ağız.
wardrobe.item.weapon_bat_wing_axe = Yarasa Kanadı Baltası
wardrobe.item.weapon_bat_wing_axe.desc = Mor zarlı ve kızıl gözlü çift kanat ağız.
wardrobe.item.weapon_celtic_axe = Kelt Baltası
wardrobe.item.weapon_celtic_axe.desc = Kelt düğümlü, gümüş halkalı sakallı ağız.
wardrobe.item.weapon_root_axe = Kök Balta
wardrobe.item.weapon_root_axe.desc = Bükülmüş köklerden sap; yosun, çiçekler ve taş ağız.
wardrobe.item.weapon_pumpkin_axe = Balkabağı Baltası
wardrobe.item.weapon_pumpkin_axe.desc = Ağız yerine oyma balkabağı; içinde mum titrer.
wardrobe.item.weapon_masakari = Masakari
wardrobe.item.weapon_masakari.desc = Japon geniş baltası: siyah lake, beyaz ito ve hamon dalgası.
wardrobe.item.weapon_rift_axe = Yarık Baltası
wardrobe.item.weapon_rift_axe.desc = Ağız, boşluğa açılan yırtık bir yarık; etrafında parçalar döner.
wardrobe.item.weapon_ice_axe = Buz Kazması
wardrobe.item.weapon_ice_axe.desc = Kazma, kürek, bilek kayışı ve mavi tırmanıcı sapı.
wardrobe.item.weapon_dory = Dory
wardrobe.item.weapon_dory.desc = Yaprak biçimli uç, dişbudak sap ve bronz dip çivisi.
wardrobe.item.weapon_assegai = Asagay
wardrobe.item.weapon_assegai.desc = Uzun geniş ağızlı, inek derisi sargılı kısa mızrak.
wardrobe.item.weapon_guandao = Guandao
wardrobe.item.weapon_guandao.desc = Altın ejderin ağzından çıkan ağır kavisli ağız ve kızıl püskül.
wardrobe.item.weapon_glaive = Glaive
wardrobe.item.weapon_glaive.desc = Arka kancalı, sap üstünde tek ağızlı kavisli bıçak.
wardrobe.item.weapon_partisan = Partizan
wardrobe.item.weapon_partisan.desc = Kanatçıklı geniş üçgen uç ve mavi püskül.
wardrobe.item.weapon_hades_bident = Hades'in Çatalı
wardrobe.item.weapon_hades_bident.desc = Yeraltının mavi ateşine sarılı kara dişler.
wardrobe.item.weapon_war_scythe = Savaş Tırpanı
wardrobe.item.weapon_war_scythe.desc = Düzleştirilmiş tırpan ağzı, kafatası ve sargılı sap.
wardrobe.item.weapon_jumonji_yari = Jumonji Yari
wardrobe.item.weapon_jumonji_yari.desc = Beyaz ito sargılı lake sap üstünde haç ağızlı Japon mızrağı.
wardrobe.item.weapon_harpoon = Zıpkın
wardrobe.item.weapon_harpoon.desc = Çentikli balina avcısı ucu ve sarkan halat kangalı.
wardrobe.item.weapon_pitchfork = Yaba
wardrobe.item.weapon_pitchfork.desc = Üç diş, tahta sap ve takılı kalmış saman.
wardrobe.item.weapon_gungnir = Gungnir
wardrobe.item.weapon_gungnir.desc = Parlayan rünlü, kuzgun tüyü tılsımlı Odin'in mızrağı.
wardrobe.item.weapon_holy_lance = Kutsal Mızrak
wardrobe.item.weapon_holy_lance.desc = Kanatlı siperli, dönen haleli beyaz-altın mızrak.
wardrobe.item.weapon_glacier_spike = Buzul Çivisi
wardrobe.item.weapon_glacier_spike.desc = Tırtıklı buz çivisi ve kırağı kaplı sap.
wardrobe.item.weapon_plasma_lance = Plazma Mızrak
wardrobe.item.weapon_plasma_lance.desc = Manyetik yayıcı halkasında titreşen plazma uç.
wardrobe.item.weapon_bone_spear = Kemik Mızrak
wardrobe.item.weapon_bone_spear.desc = Sinirle bağlanmış bilenmiş kemik ve bir çift tüy.
wardrobe.item.weapon_serpent_spear = Yılan Mızrağı
wardrobe.item.weapon_serpent_spear.desc = Dalgalı yılan ağız ve gür kızıl yele.
wardrobe.item.weapon_lotus_spear = Lotus Mızrağı
wardrobe.item.weapon_lotus_spear.desc = Yeşim sap ve açmış lotus yapraklarından siper.
wardrobe.item.weapon_feather_spear = Tüylü Mızrak
wardrobe.item.weapon_feather_spear.desc = Çakmaktaşı uç; boncuklar ve rüzgârda dans eden tüyler.
