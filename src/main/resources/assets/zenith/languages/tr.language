wardrobe.item.cape_tattered_wraith.desc = Şeritlere yırtılmış pelerin; her biri kendi başına kıpırdar ve tüter.
wardrobe.item.cape_quetzal = Ketsal Pelerini
wardrobe.item.cape_quetzal.desc = Yanardöner tüy sıraları, uzun kuyruk tüyleri ve yeşim yaka.
wardrobe.item.cape_wolf_pelt = Kurt Postu
wardrobe.item.cape_wolf_pelt.desc = Omuzda kurt başı, göğüste pençeleri olan gri post.
wardrobe.item.cape_hero = Kahraman Pelerini
wardrobe.item.cape_hero.desc = Yüksek yakalı, altın yıldızlı kızıl pelerin. Dünyayı kurtar.
wardrobe.item.cape_matador = Matador Pelerini
wardrobe.item.cape_matador.desc = Sarı astarlı, bir omza atılmış macenta pelerin.
wardrobe.item.cape_opera = Opera Pelerini
wardrobe.item.cape_opera.desc = Kızıl saten üstüne siyah, dik yaka ve gümüş zincir.
wardrobe.item.cape_mino = Hasır Mino
wardrobe.item.cape_mino.desc = Omuz pelerinli, kat kat samandan Japon yağmurluğu.
wardrobe.item.cape_pelisse = Hafif Süvari Pelerini
wardrobe.item.cape_pelisse.desc = Tek omza atılmış: kürk, altın kordonlar ve sarkan kol.
wardrobe.item.cape_stained_glass = Vitray Pelerin
wardrobe.item.cape_stained_glass.desc = Kurşun çerçeveli renkli cam mozaiği, içten ışıldar.
wardrobe.item.cape_waterfall = Şelale Pelerini
wardrobe.item.cape_waterfall.desc = Pelerinden berrak su akar, eteğinden damlar.
wardrobe.item.cape_ghillie = Ghillie Pelerini
wardrobe.item.cape_ghillie.desc = Tüylü kamuflaj şeritleri ve omuzlarda yaprak demetleri.
wardrobe.item.cape_lamellar = Lamel Pelerin
wardrobe.item.cape_lamellar.desc = Kırmızı kordonla bağlı yüzlerce çelik plaka, ağır ağır sallanır.
wardrobe.item.cape_bat = Yarasa Pelerini
wardrobe.item.cape_bat.desc = Parmak kaburgalarda zarlar. Zıplayınca kanat gibi açılır.
wardrobe.item.cape_kasaya = Kasaya
wardrobe.item.cape_kasaya.desc = Tek omuzdan çapraz geçen safran rengi yama keşiş cüppesi.
wardrobe.item.cape_origami = Origami Pelerin
wardrobe.item.cape_origami.desc = Keskin kâğıt kıvrımları ve kanat çırpan turnalar.
wardrobe.item.cape_jellyfish = Denizanası
wardrobe.item.cape_jellyfish.desc = Parlayan saydam şemsiye ve arkadan süzülen uzun dokunaçlar.
wardrobe.item.cape_sail = Yelken Pelerin
wardrobe.item.cape_sail.desc = Dikişli, halkalı yelken bezi ve tahta serende halatlar.
wardrobe.item.cape_jarl_fur = Jarl Kürkü
wardrobe.item.cape_jarl_fur.desc = Omuzlarda ağır kürk, dokuma kenar ve boncuklu bronz broşlar.
wardrobe.item.cape_highwayman = Eşkıya Pelerini
wardrobe.item.cape_highwayman.desc = Üç kat pelerinli, pirinç düğmeli uzun arabacı pelerini.
