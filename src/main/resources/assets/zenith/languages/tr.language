wardrobe.item.char_magical_girl.desc = Pembe çift kuyruk, fırfırlı etek ve yıldız tozu.
wardrobe.item.char_space_hunter = Uzay Avcısı
wardrobe.item.char_space_hunter.desc = Vizörlü zırh ve kıvılcım saçan kol topu.
wardrobe.item.char_necromancer = Nekromant
wardrobe.item.char_necromancer.desc = Kapüşon, kemikler ve gözlerde yeşil ateş.
wardrobe.item.char_cyber_ninja = Siber Ninja
wardrobe.item.char_cyber_ninja.desc = Neon dikişler, sırtta ışın kılıcı, kızıl atkı.
wardrobe.item.char_pirate_captain = Korsan Kaptan
wardrobe.item.char_pirate_captain.desc = Sakal, göz bandı ve el yerine kanca.
wardrobe.item.char_paladin = Paladin
wardrobe.item.char_paladin.desc = Altın zırh, beyaz pelerin ve dönen hale.
wardrobe.item.char_vampire_aristocrat = Aristokrat Vampir
wardrobe.item.char_vampire_aristocrat.desc = Solgun ten, kızıl gözler ve yüksek yakalı pelerin.
