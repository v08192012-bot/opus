wardrobe.item.char_jester_harlequin = Harlekin Soytarı
wardrobe.item.char_jester_harlequin.desc = Çıngıraklı külah, baklava desenleri, fırfırlı yaka ve soytarı asası.
wardrobe.item.char_netrunner = Netrunner
wardrobe.item.char_netrunner.desc = Mor küt saç, siber göz, neon ceket ve holo ekran.
wardrobe.item.char_templar_crusader = Tapınak Şövalyesi
wardrobe.item.char_templar_crusader.desc = Zincir zırh, kırmızı haçlı beyaz cüppe, kalkan ve belde büyük miğfer.
wardrobe.item.char_jaguar_warrior = Jaguar Savaşçısı
wardrobe.item.char_jaguar_warrior.desc = Jaguar ağzı miğfer, ketzal tüyleri, macuahuitl ve kalkan.
wardrobe.item.char_ghost_bride = Hayalet Gelin
wardrobe.item.char_ghost_bride.desc = Tül duvak, solmuş buket, kopuk zincir ve etrafta ruhlar.
wardrobe.item.char_lava_golem = Lav Golemi
wardrobe.item.char_lava_golem.desc = Magma çatlaklı ve nabız gibi atan erimiş çekirdekli taş dev.
wardrobe.item.char_beekeeper = Arıcı
wardrobe.item.char_beekeeper.desc = Tüllü şapka, körük, bir kavanoz bal ve etrafta arılar.
wardrobe.item.char_fallen_angel = Düşmüş Melek
wardrobe.item.char_fallen_angel.desc = Siyah kanatlar, kırık hale ve etrafa düşen kül.
wardrobe.item.char_idol_singer = İdol Şarkıcı
wardrobe.item.char_idol_singer.desc = Nane topuzlar, mikrofonlu kulaklık, sahne üniforması ve mikrofon.
wardrobe.item.char_firefighter = İtfaiyeci
wardrobe.item.char_firefighter.desc = Rozetli kask, reflektörlü itfaiye kıyafeti, hava tüpü ve balta.
wardrobe.item.weapon_crossguard_saber = Çapraz Işın Kılıcı
wardrobe.item.weapon_crossguard_saber.desc = İki plazma siperli ve çıtırdayan kenarlı dengesiz kızıl ışın.
wardrobe.item.weapon_obsidian_greatsword = Obsidyen Büyük Kılıç
wardrobe.item.weapon_obsidian_greatsword.desc = Lav damarlı, boynuzlu siperli ve yanan gözlü iblis kılıcı.
wardrobe.item.weapon_sakura_wakizashi = Sakura Wakizashi
wardrobe.item.weapon_sakura_wakizashi.desc = Çiçek tsubalı kısa kılıç. Çeliğin etrafında yapraklar süzülür.
wardrobe.item.weapon_labrys = Labrys
wardrobe.item.weapon_labrys.desc = Menderes desenli, lapis taşlı ve kızıl kurdeleli bronz çift balta.
wardrobe.item.weapon_glacier_axe = Buzul Baltası
wardrobe.item.weapon_glacier_axe.desc = Parlayan çekirdekli buz parçası ağız; etrafında kristaller döner.
wardrobe.item.weapon_chainsaw_axe = Testere Balta
wardrobe.item.weapon_chainsaw_axe.desc = Zincir kılavuzda koşar, motor titrer, egzoz kızarır.
wardrobe.item.weapon_bone_bow = Kemik Yay
wardrobe.item.weapon_bone_bow.desc = Omur kollar, pençe uçlar ve için için yanan gözlü kafatasları.
wardrobe.item.weapon_solar_bow = Güneş Kanatlı Yay
wardrobe.item.weapon_solar_bow.desc = Altın kanatlı kollar ve dönen güneş ışını tacı.
wardrobe.item.weapon_compound_bow = Makaralı Yay
wardrobe.item.weapon_compound_bow.desc = Gerdikçe makaralar döner; nişangahta parlayan pimler var.
wardrobe.item.weapon_meteor_flail = Göktaşı Gürzü
wardrobe.item.weapon_meteor_flail.desc = Zincire bağlı kızgın göktaşı; etrafında korlar döner.
wardrobe.item.weapon_rune_warhammer = Rünlü Savaş Çekici
wardrobe.item.weapon_rune_warhammer.desc = Kuzey savaş çekici; başındaki rünler ışıkla atar.
wardrobe.item.weapon_jester_mace = Soytarı Topuzu
wardrobe.item.weapon_jester_mace.desc = Çıngıraklı külahın altında gülen ve ağlayan maske.
wardrobe.item.weapon_naginata = Naginata
wardrobe.item.weapon_naginata.desc = Kızıl püsküllü cilalı sapta kavisli bıçak.
wardrobe.item.weapon_lightning_javelin = Yıldırım Ciridi
wardrobe.item.weapon_lightning_javelin.desc = Çevresinde deşarjlar dönen yıldırım uçlu cirit.
wardrobe.item.weapon_bamboo_spear = Bambu Mızrak
wardrobe.item.weapon_bamboo_spear.desc = Yapraklı canlı bambu, kırmızı kurdele ve yeşim boncuk.
wardrobe.item.head_bogatyr_shelom = Bogatır Miğferi
wardrobe.item.head_bogatyr_shelom.desc = Yaldızlı alın plakalı, zincir ense örtülü ve kırmızı flamalı sivri miğfer.
wardrobe.item.body_bogatyr_kolchuga = Aynalı Zincir Zırh
wardrobe.item.body_bogatyr_kolchuga.desc = Perçinli zincir zırh, göğüste parlak ayna plaka ve altında kırmızı kaftan.
wardrobe.item.legs_bogatyr_sapogi = Şalvar ve Çizme
wardrobe.item.legs_bogatyr_sapogi.desc = Mavi şalvar, kırmızı kuşak ve burnu kalkık kırmızı çizmeler.
wardrobe.item.head_pharaoh_nemes = Firavun Nemesi
wardrobe.item.head_pharaoh_nemes.desc = Çizgili nemes, yakut gözlü altın ureus ve örgülü sakal.
wardrobe.item.body_pharaoh_usekh = Usekh Gerdanlığı
wardrobe.item.body_pharaoh_usekh.desc = İnce keten üstünde altın, lapis ve akik boncuklu geniş gerdanlık.
wardrobe.item.legs_pharaoh_shendyt = Şendit ve Sandalet
wardrobe.item.legs_pharaoh_shendyt.desc = Hiyeroglifli altın önlüklü pileli şendit ve altın sandaletler.
wardrobe.item.head_steam_aviator = Havacı Pilot Başlığı
wardrobe.item.head_steam_aviator.desc = Koyun postu astarlı deri başlık, açılır lensli pirinç gözlük ve dönen dişliler.
wardrobe.item.body_steam_greatcoat = Havacı Kaputu
wardrobe.item.body_steam_greatcoat.desc = Öküz kanı deri, titreyen manometreli çapraz kayış ve omuzda bakır boru.
wardrobe.item.legs_steam_boots = Binici Pantolonu ve Perçinli Çizme
wardrobe.item.legs_steam_boots.desc = Haki binici pantolonu, perçinli uzun çizmeler, dişli tokalar ve bakır dizlikler.
wardrobe.item.back_steam_boiler = Buhar Kazanı Sırt Çantası
wardrobe.item.back_steam_boiler.desc = Canlı ocaklı, tüten bacalı bakır kazan. Pervanesi uçarken hızlanır.
wardrobe.item.head_plague_beak = Veba Doktoru Maskesi
wardrobe.item.head_plague_beak.desc = Geniş kenarlı şapka, dikişli deri gaga ve soluk yeşil parlayan camlar.
wardrobe.item.body_plague_coat = Mumlu Hekim Pardösüsü
wardrobe.item.body_plague_coat.desc = Uzun mumlu pardösü, yüksek yaka ve parlayan tentür şişeli palaska.
wardrobe.item.legs_plague_boots = Hekim Pantolonu ve Çizmeleri
wardrobe.item.legs_plague_boots.desc = Koyu pantolon ve bir sıra tokayla sıkılmış kıvrık konçlu uzun çizmeler.
wardrobe.item.back_plague_satchel = Aktar Çantası
wardrobe.item.back_plague_satchel.desc = Kuruyan ot demetleri, tarif parşömeni ve yürürken sallanan yeşil ışıklı fener.
wardrobe.item.head_hoplite_corinthian = Korint Miğferi
wardrobe.item.head_hoplite_corinthian.desc = Göz yarıklı bronz ve yürürken yaylanan kızıl at kılı sorguç.
wardrobe.item.body_hoplite_cuirass = Kaslı Zırh
wardrobe.item.body_hoplite_cuirass.desc = Gorgoneionlu bronz gövde, deri pteruges ve omuzda kızıl klamis.
wardrobe.item.legs_hoplite_greaves = Tozluk ve Krepis
wardrobe.item.legs_hoplite_greaves.desc = Kabartmalı bronz tozluklar, menderes kenarlı kızıl kiton ve bağcıklı sandaletler.
wardrobe.item.back_hoplite_aspis = Aspis ve Dory
wardrobe.item.back_hoplite_aspis.desc = Bronz lambdalı yuvarlak kalkan ve sırtta mızrak — falanks dağılmaz.
wardrobe.item.head_tuareg_tagelmust = Tagelmust
wardrobe.item.head_tuareg_tagelmust.desc = Peçeli çivit türban, gümüş muska ve rüzgârda savrulan kumaş ucu.
wardrobe.item.body_tuareg_robe = Göçebe Cüppesi
wardrobe.item.body_tuareg_robe.desc = Kum üstüne çivit, Agadez haçı, geniş yenler ve kemerde hançer.
wardrobe.item.legs_tuareg_sirwal = Şalvar ve Sandalet
wardrobe.item.legs_tuareg_sirwal.desc = Dokuma şeritli bol kum rengi şalvar ve kırmızı kayışlı sandaletler.
wardrobe.item.head_racer_helmet = Formül Pilot Kaskı
wardrobe.item.head_racer_helmet.desc = Kırmızı-beyaz boya, koparmalı füme vizör ve tepede spoyler.
wardrobe.item.body_racer_suit = Yanmaz Yarış Tulumu
wardrobe.item.body_racer_suit.desc = Sponsor armaları, HANS yakalık, çekme apoletleri ve kaymaz avuçlu eldivenler.
wardrobe.item.legs_racer_boots = Yarış Pantolonu ve Botları
wardrobe.item.legs_racer_boots.desc = Bileğe inen şeritler ve her pedalı hissettiren ince cırtlı botlar.
wardrobe.item.head_mecha_helm = Meka Pilot Miğferi
wardrobe.item.head_mecha_helm.desc = Köşeli zırh, HUD'lu parlayan vizör yarığı ve geriye yatık anten kanatçıkları.
wardrobe.item.body_mecha_chest = Reaktörlü Güç Zırhı
wardrobe.item.body_mecha_chest.desc = Nabız gibi atan reaktör çekirdeği, dev omuzluklar ve ışık çizgili kolluklar.
wardrobe.item.legs_mecha_legs = Zırhlı Bacaklar ve Manyetik Botlar
wardrobe.item.legs_mecha_legs.desc = Hidrolik pistonlar her adımda çalışır, tabanlar mavi parlar.
wardrobe.item.back_mecha_thrusters = İkiz İtici Motorlar
wardrobe.item.back_mecha_thrusters.desc = Omurgadaki iki itici: havada kanatçıklarını açar ve alev püskürtür.
wardrobe.item.head_diver_helmet = Dalgıç Kaskı
wardrobe.item.head_diver_helmet.desc = Parlatılmış pirinç, üç lombar ve ön camda koruyucu ızgara.
wardrobe.item.body_diver_suit = Dalgıç Giysisi
wardrobe.item.body_diver_suit.desc = Branda, cıvatalı pirinç göğüslük, göğüste ve sırtta kurşun ağırlıklar.
wardrobe.item.legs_diver_boots = Kurşun Dalgıç Botları
wardrobe.item.legs_diver_boots.desc = Pirinç burunlu, deri kayışlı, kurşun tabanlı devasa botlar.
wardrobe.item.back_diver_tanks = Hava Tüpleri
wardrobe.item.back_diver_tanks.desc = Bakır tüpler, manometre ve kaska giden körüklü hortum. Ara sıra fokurdar.
wardrobe.item.body_hawaiian_shirt = Havai Gömleği
wardrobe.item.body_hawaiian_shirt.desc = Beyaz tişört üstüne açık, hibiskuslu ve palmiyeli gömlek.
wardrobe.item.body_bard_doublet = Ozan Yeleği
wardrobe.item.body_bard_doublet.desc = İpek yırtmaçlı kabarık kollar, bağcıklı ön ve ud kayışı.
wardrobe.item.body_yellow_raincoat = Sarı Yağmurluk
wardrobe.item.body_yellow_raincoat.desc = Reflektör bantlı, çomak düğmeli parlak yağmurluk. Hâlâ damlıyor.
wardrobe.item.body_lab_coat = Laboratuvar Önlüğü
wardrobe.item.body_lab_coat.desc = Yaka kartı, cepte kalemler ve yanda parlayan deney tüpleri.
wardrobe.item.legs_muay_thai = Muay Thai Şortu
wardrobe.item.legs_muay_thai.desc = Belinde Tay yazısı olan saten şort, kaval sargıları ve bilek destekleri.
wardrobe.item.legs_goth_platforms = Bondaj ve Creeper
wardrobe.item.legs_goth_platforms.desc = Kayışlar, D halkaları, zincir ve kalın tabanlı creeper botların üstünde ekose kapak.
wardrobe.item.legs_ballet_tutu = Balerin Tütüsü
wardrobe.item.legs_ballet_tutu.desc = Şeffaf tül katmanları, pembe tayt ve bileğe dolanan kurdeleli puant ayakkabılar.
wardrobe.item.legs_rocket_boots = Roket Botlar
wardrobe.item.legs_rocket_boots.desc = Topuklardaki krom nozullar yerden kesildiğin an alev püskürtür.
wardrobe.item.legs_roller_skates = Paten Diskosu
wardrobe.item.legs_roller_skates.desc = Saçaklı kot şort, çizgili diz çorapları ve tekerlekleri dönen quad patenler.
wardrobe.item.back_sashimono_banner = Sashimono Sancağı
wardrobe.item.back_sashimono_banner.desc = Sırttaki direkte mon armalı kızıl samuray bayrağı, rüzgârda dalgalanır.
wardrobe.item.back_lantern_yoke = Fenerli Omuz Sırığı
wardrobe.item.back_lantern_yoke.desc = Parlayan ve sallanan iki kırmızı kâğıt fenerli bambu sırık.
wardrobe.item.back_coffin = Zincirli Tabut
wardrobe.item.back_coffin.desc = Demir haçlı ve köşeli karanlık tabut, yürürken zincirleri sallanır.
wardrobe.item.back_holo_halo = Holo Hale
wardrobe.item.back_holo_halo.desc = Glifli hologram halkası sırtında süzülür, döner ve kıvılcım saçar.
wardrobe.item.back_sapling_pot = Saksıda Fidan
wardrobe.item.back_sapling_pot.desc = Sırtta kil saksı, canlı küçük bir ağaç ve yuvasında bir kuş.
wardrobe.item.back_scroll_case = Parşömen Kutusu
wardrobe.item.back_scroll_case.desc = Seigaiha dalgalı cilalı tüp, rulo parşömenler ve bağlı bir fırça.
wardrobe.item.back_balloon_bundle = Balon Demeti
wardrobe.item.back_balloon_bundle.desc = Karabinalı küçük sırt çantası ve başının üstünde sallanan balonlar.
wardrobe.item.back_void_tendrils = Boşluk Dokunaçları
wardrobe.item.back_void_tendrils.desc = Sırtındaki yarıktan uçları parlayan gölge dokunaçlar kıvrılır.
wardrobe.item.back_boombox = Müzik Kutusu
wardrobe.item.back_boombox.desc = Askılı retro teyp: hoparlörler pompalar, kaset döner.
wardrobe.item.weapon_gladius = Gladius
wardrobe.item.weapon_gladius.desc = Yaprak uçlu kısa Roma kılıcı; oluklu kemik kabza ve pirinç siper.
wardrobe.item.weapon_zweihander = Zweihänder
wardrobe.item.weapon_zweihander.desc = Deri sarılı rikasso, savuşturma kancaları ve geniş siperli dev iki elli kılıç.
wardrobe.item.weapon_sultan_scimitar = Sultan Palası
wardrobe.item.weapon_sultan_scimitar.desc = Altın işlemeli kavisli namlu, yakut kabza başı ve genişleyen uç.
wardrobe.item.weapon_musketeer_rapier = Silahşor Meçi
wardrobe.item.weapon_musketeer_rapier.desc = İnce namlu, kıvrımlı çubuklu sepet kabza, istiridye siper ve mavi kurdele.
wardrobe.item.weapon_highland_claymore = Dağlı Claymore
wardrobe.item.weapon_highland_claymore.desc = Dört yapraklı uçlarla biten öne eğik siper, çark kabza başı ve ekose kuşak.
wardrobe.item.weapon_khopesh = Hopeş
wardrobe.item.weapon_khopesh.desc = Altın kakmalı, lapis kabzalı bronz Mısır orak kılıcı.
wardrobe.item.weapon_flamberge = Flamberg
wardrobe.item.weapon_flamberge.desc = Kızgın kenarından kıvılcımlar saçan dalgalı alev namlu.
wardrobe.item.weapon_void_runeblade = Hiçlik Rün Kılıcı
wardrobe.item.weapon_void_runeblade.desc = Parlayan mor rünlü kara namlu; çevresinde rün parçaları döner.
wardrobe.item.weapon_buster_sword = Ezici Kılıç
wardrobe.item.weapon_buster_sword.desc = Siperin yanında iki delikli, sargılı kabzalı devasa çelik levha.
wardrobe.item.weapon_leaf_blade = Elf Yaprak Kılıcı
wardrobe.item.weapon_leaf_blade.desc = Yaprak biçimli namlu, sarmaşık sarılı kabza ve parlayan zümrüt.
wardrobe.item.weapon_bone_sword = Kemik Kılıç
wardrobe.item.weapon_bone_sword.desc = Dev bir kemikten kaba oyulmuş; kenarında dişler, deri sarılı kabza.
wardrobe.item.weapon_jade_dao = Yeşim Dao
wardrobe.item.weapon_jade_dao.desc = Pirinç donanımlı, yeşim kabza başlı ve kırmızı püsküllü Çin palası.
wardrobe.item.weapon_holy_avenger = Kutsal İntikamcı
wardrobe.item.weapon_holy_avenger.desc = Altın kanatlı, parlayan yazıtlı ve haleli ışıltılı paladin kılıcı.
wardrobe.item.weapon_prism_sword = Prizma Kılıcı
wardrobe.item.weapon_prism_sword.desc = Kristal prizma ağız, ışığı kenarı boyunca gökkuşağına ayırır.
wardrobe.item.weapon_shotel = Şotel
wardrobe.item.weapon_shotel.desc = Neredeyse yarım ay gibi kıvrık, ahşap kabzalı Etiyopya orak kılıcı.
wardrobe.item.weapon_gunblade = Silahlı Kılıç
wardrobe.item.weapon_gunblade.desc = Revolver gövdeli kılıç: tetik, namlu ve kendi kendine dönen bir silindir.
wardrobe.item.weapon_candy_cane_sword = Şeker Baston Kılıç
wardrobe.item.weapon_candy_cane_sword.desc = Çizgili şeker baston ağız, zencefilli kurabiye siper ve yeşil kurdele.
wardrobe.item.weapon_coral_blade = Mercan Kılıç
wardrobe.item.weapon_coral_blade.desc = Deniz kabuklu, midyeli pembe mercan; inci topuz ve yükselen kabarcıklar.
wardrobe.item.weapon_thunder_nodachi = Gök Gürültüsü Nodachi
wardrobe.item.weapon_thunder_nodachi.desc = Mavi parlayan yıldırım hamonlu dev nodachi; ağız boyunca kıvılcımlar koşar.
wardrobe.item.weapon_bokken = Bokken
wardrobe.item.weapon_bokken.desc = Meşe damarları belirgin, plastik tsubalı tahta antrenman kılıcı.
wardrobe.item.weapon_serpent_kris = Yılan Kris
wardrobe.item.weapon_serpent_kris.desc = Pamor desenli dalgalı kris; naga kabzası dilini çıkarıp sokar.
wardrobe.item.weapon_moonlight_greatsword = Ay Işığı Büyük Kılıcı
wardrobe.item.weapon_moonlight_greatsword.desc = Hilal siperli, soluk ay ışığından yarı saydam kılıç.
wardrobe.item.weapon_bloodthirster = Kan Emici
wardrobe.item.weapon_bloodthirster.desc = Damarlı kızıl ağız; siperde bir kalp atar, bıçaktan kan damlar.
wardrobe.item.weapon_pixel_sword = Piksel Kılıç
wardrobe.item.weapon_pixel_sword.desc = Basamaklı bloklardan 8-bit kılıç; ağız boyunca piksel parıltı koşar.
wardrobe.item.weapon_clockwork_blade = Kurmalı Kılıç
wardrobe.item.weapon_clockwork_blade.desc = Pirinç ve çelik; siperde dişliler döner, topuz bir kurma anahtarıdır.
wardrobe.item.weapon_yumi = Yumi
wardrobe.item.weapon_yumi.desc = Rattan sargılı, beyaz kirişli, siyah lake uzun asimetrik yay.
wardrobe.item.weapon_mongol_bow = Moğol Yayı
wardrobe.item.weapon_mongol_bow.desc = Kısa kompozit yay: boynuz kulaklar, boyalı huş kabuğu ve mavi hadak kurdelesi.
wardrobe.item.weapon_yew_longbow = Porsuk Uzun Yayı
wardrobe.item.weapon_yew_longbow.desc = İngiliz porsuk yayı: açık diri odun, koyu öz odun ve boynuz uçlar.
wardrobe.item.weapon_vine_bow = Canlı Sarmaşık Yay
wardrobe.item.weapon_vine_bow.desc = Yapraklı örgü sarmaşık; kolları üzerinde çiçekler açar.
wardrobe.item.weapon_shadow_bow = Gölge Yayı
wardrobe.item.weapon_shadow_bow.desc = Mor kenarlı kara bıçak kollar; üzerlerinden duman süzülür.
wardrobe.item.weapon_storm_bow = Fırtına Yayı
wardrobe.item.weapon_storm_bow.desc = Kirişi çıtırdayan bir yıldırım; kabzada fırtına bulutu döner.
wardrobe.item.weapon_cupid_bow = Aşk Tanrısı Yayı
wardrobe.item.weapon_cupid_bow.desc = Kalp kabzalı, minik kanatlı pembe-altın yay.
wardrobe.item.weapon_tidal_bow = Gelgit Yayı
wardrobe.item.weapon_tidal_bow.desc = Köpük tepeli, incili saydam dalga; uçlarından su damlar.
wardrobe.item.weapon_ember_bow = Kor Yayı
wardrobe.item.weapon_ember_bow.desc = Kor çatlaklı kömürleşmiş ahşap; uçlarında alevler dans eder.
wardrobe.item.weapon_scythian_bow = İskit Yayı
wardrobe.item.weapon_scythian_bow.desc = Hayvan üslubu altın levhalı, grifon başlı çift kavisli yay.
wardrobe.item.weapon_steampunk_bow = Buharpunk Yay
wardrobe.item.weapon_steampunk_bow.desc = Pirinç ve ceviz: kabzada dişliler döner, üstte dürbün, vanadan buhar çıkar.
wardrobe.item.weapon_void_bow = Hiçlik Yayı
wardrobe.item.weapon_void_bow.desc = Hiçlik kristali: kolların çevresinde parçalar süzülür, kabzada kara küre döner.
wardrobe.item.weapon_moon_bow = Ay Yayı
wardrobe.item.weapon_moon_bow.desc = Gümüş hilal; kirişinde yıldız boncukları parıldar.
wardrobe.item.weapon_bamboo_bow = Bambu Yay
wardrobe.item.weapon_bamboo_bow.desc = Sicimle sarılı boğumlu bambu, yapraklı dal ve saman püskül.
wardrobe.item.weapon_antler_bow = Boynuz Yay
wardrobe.item.weapon_antler_bow.desc = Çatallı iki geyik boynuzu, bağcıklı deri kabzayla birleşmiş.
wardrobe.item.weapon_serpent_bow = Yılan Yay
wardrobe.item.weapon_serpent_bow.desc = Kollar zümrüt gözlü iki yılandır, kuyrukları kabzada dolanır.
wardrobe.item.weapon_rainbow_bow = Gökkuşağı Yay
wardrobe.item.weapon_rainbow_bow.desc = Uçlarında bulutlar, kabzasında prizma olan yedi renkli gökkuşağı yayı.
wardrobe.item.weapon_royal_bow = Kraliyet Yayı
wardrobe.item.weapon_royal_bow.desc = Telkari işlemeli, safirli, kadife kabzasında taç olan yaldızlı yay.
wardrobe.item.weapon_spider_bow = Örümcek Yay
wardrobe.item.weapon_spider_bow.desc = Siyah kitin, uçlarda örümcek bacakları ve ağdan kiriş.
wardrobe.item.weapon_sakura_bow = Sakura Yayı
wardrobe.item.weapon_sakura_bow.desc = Çiçek açmış kiraz ağacı: tomurcuklu dallar ve süzülen yapraklar.
wardrobe.item.weapon_demon_bow = İblis Yayı
wardrobe.item.weapon_demon_bow.desc = Erimiş çatlaklı boynuzlar ve kabzada kırpışan yanan bir göz.
wardrobe.item.weapon_constellation_bow = Takımyıldız Yayı
wardrobe.item.weapon_constellation_bow.desc = Yarı saydam gece, parıldayan yıldızlar ve ışıldayan takımyıldız çizgileri.
wardrobe.item.weapon_wind_bow = Rüzgâr Yayı
wardrobe.item.weapon_wind_bow.desc = Açık renk ahşap; uçlarında rüzgârda dalgalanan uzun tüyler.
wardrobe.item.weapon_obsidian_bow = Obsidyen Yay
wardrobe.item.weapon_obsidian_bow.desc = Üzerinden mor gözyaşları süzülen camsı siyah kırıklar.
wardrobe.item.weapon_harp_bow = Arp Yay
wardrobe.item.weapon_harp_bow.desc = Teli titreyip tınlayan, ses kutulu altın bir lir.
wardrobe.item.weapon_shestoper = Altı Kanatlı Topuz
wardrobe.item.weapon_shestoper.desc = Altı çelik kanatlı ve yuvarlak tepeli Rus topuzu.
wardrobe.item.weapon_hetman_bulava = Hetman Topuzu
wardrobe.item.weapon_hetman_bulava.desc = Turkuaz taşlı yaldızlı armut baş ve kızıl püskül.
wardrobe.item.weapon_kanabo = Kanabo
wardrobe.item.weapon_kanabo.desc = Demir çivilerle donatılmış uzun, sekizgen siyah lake sopa.
wardrobe.item.weapon_macuahuitl = Makuahuitl
wardrobe.item.weapon_macuahuitl.desc = Obsidyen ağızlı, boyalı sembollü ve ketzal tüylü Aztek sopası.
wardrobe.item.weapon_caveman_club = Mağara Adamı Sopası
wardrobe.item.weapon_caveman_club.desc = Çakmaktaşı dikenli, kulpu postla sarılı budaklı kütük.
wardrobe.item.weapon_judge_gavel = Hakim Tokmağı
wardrobe.item.weapon_judge_gavel.desc = Pirinç bantlı dev cilalı tokmak. Karar kesindir.
wardrobe.item.weapon_sledgehammer = Balyoz
wardrobe.item.weapon_sledgehammer.desc = Sarı-siyah fiberglas sapta ağır çelik baş.
wardrobe.item.weapon_forge_hammer = Demirci Çekici
wardrobe.item.weapon_forge_hammer.desc = Başı ocaktan yeni çıkmış gibi kor halinde, kıvılcım saçar.
wardrobe.item.weapon_holy_censer = Kutsal Buhurdan
wardrobe.item.weapon_holy_censer.desc = Zincirli altın buhurdan: deliklerinden korlar parlar, tütsü süzülür.
wardrobe.item.weapon_solar_mace = Güneş Topuzu
wardrobe.item.weapon_solar_mace.desc = Altın sapta alev alev güneş; çevresinde taç ışınları döner.
wardrobe.item.weapon_lollipop_mace = Lolipop Topuz
wardrobe.item.weapon_lollipop_mace.desc = Pembe fiyonklu, çubukta dev sarmal lolipop.
wardrobe.item.weapon_anchor_mace = Çapa Topuz
wardrobe.item.weapon_anchor_mace.desc = Zincire sarılı, midye kaplı gemi çapası; tırnağında yosun sallanır.
wardrobe.item.weapon_bell_mace = Çan Topuz
wardrobe.item.weapon_bell_mace.desc = Baş yerine bronz çan: tokmağı sallanır, her darbe nota çalar.
wardrobe.item.weapon_geode_mace = Jeot Topuzu
wardrobe.item.weapon_geode_mace.desc = Çatlak taş kabuğun içinde ışıldayan ametist kümesi.
wardrobe.item.weapon_gravity_hammer = Yerçekimi Çekici
wardrobe.item.weapon_gravity_hammer.desc = Başlıklar arasında dönen halkalarla çevrili bir yerçekimi çekirdeği süzülür.
wardrobe.item.weapon_triple_flail = Üçlü Gürz
wardrobe.item.weapon_triple_flail.desc = Zincirlerde üç dikenli gülle, her biri ayrı sallanır.
wardrobe.item.weapon_tiki_club = Tiki Sopası
wardrobe.item.weapon_tiki_club.desc = Parlak gözlü, dişlek sırıtışlı, palmiye yapraklı oyma idol.
wardrobe.item.weapon_void_scepter = Boşluk Asası
wardrobe.item.weapon_void_scepter.desc = Kafeste bir boşluk küresi atar; etrafında karanlık parçalar döner.
wardrobe.item.weapon_dragon_skull_maul = Ejder Kafatası Gürzü
wardrobe.item.weapon_dragon_skull_maul.desc = Boynuzlu ejder kafatası; göz çukurlarında ateş için için yanar.
wardrobe.item.weapon_bone_club = Kemik Sopa
wardrobe.item.weapon_bone_club.desc = Deri sargılı bir devin uyluk kemiği.
wardrobe.item.weapon_royal_scepter = Kraliyet Asası
wardrobe.item.weapon_royal_scepter.desc = Altın, haçlı küre, inciler, yakutlar ve safirler.
wardrobe.item.weapon_urchin_mace = Deniz Kestanesi Topuzu
wardrobe.item.weapon_urchin_mace.desc = Dalgalanan yosunlu, dal parçası üstünde dikenli mor kestane.
wardrobe.item.weapon_clock_hammer = Saat Çekici
wardrobe.item.weapon_clock_hammer.desc = Başlıkta saat kadranı tıklar, arkada dişli döner.
wardrobe.item.weapon_mushroom_mace = Mantar Topuzu
wardrobe.item.weapon_mushroom_mace.desc = Sapında dev sinek mantarı. Esner ve spor saçar.
wardrobe.item.weapon_brazier_mace = Mangal Topuzu
wardrobe.item.weapon_brazier_mace.desc = İçinde canlı ateş kükreyen demir kafes.
wardrobe.item.head_artist_beret = Ressam Beresi
wardrobe.item.head_artist_beret.desc = Boya lekeli bordo bere ve kulak arkasında fırça.
wardrobe.item.head_chef_toque = Aşçı Şapkası
wardrobe.item.head_chef_toque.desc = Kabarık tepeli, işlemeli armalı uzun pileli aşçı şapkası.
wardrobe.item.head_firefighter_helmet = İtfaiyeci Kaskı
wardrobe.item.head_firefighter_helmet.desc = Uzun arka siperlik, pirinç kartal, numaralı kalkan ve reflektör şeritler.
wardrobe.item.head_jester_cap = Soytarı Külahı
wardrobe.item.head_jester_cap.desc = Baklava desenli üç sarkık uç, her birinde çıngırak.
wardrobe.item.head_pumpkin_lantern = Balkabağı Feneri
wardrobe.item.head_pumpkin_lantern.desc = Kafa yerine oyma balkabağı; içinde mum titrer.
wardrobe.item.head_frog_hat = Kurbağa Bere
wardrobe.item.head_frog_hat.desc = Pörtlek gözlü, pembe yanaklı, ponponlu örgü bere.
wardrobe.item.head_mariachi_sombrero = Mariachi Sombrero
wardrobe.item.head_mariachi_sombrero.desc = Gümüş işlemeli, kenarı ponponlu geniş siyah sombrero.
wardrobe.item.head_ice_tiara = Buz Tacı
wardrobe.item.head_ice_tiara.desc = Buz dikenli gümüş taç; üstünde kristaller süzülür.
wardrobe.item.head_seraph_halo = Serafim Halesi
wardrobe.item.head_seraph_halo.desc = İki altın halka ters döner, şakaklarda küçük kanatlar çırpar.
wardrobe.item.head_deerstalker = Dedektif Şapkası
wardrobe.item.head_deerstalker.desc = Çift siperli tüvit şapka, fiyonklu kulaklıklar ve ağızda pipo.
wardrobe.item.head_kitsune_mask = Kitsune Maskesi
wardrobe.item.head_kitsune_mask.desc = Kırmızı desenli beyaz tilki maskesi yana kaymış, püsküller sallanır.
wardrobe.item.head_maharaja_turban = Mihrace Sarığı
wardrobe.item.head_maharaja_turban.desc = Safran sarık, zümrüt broş, inci dizileri ve beyaz sorguç.
wardrobe.item.head_amanita_cap = Sinek Mantarı Şapkası
wardrobe.item.head_amanita_cap.desc = Beyaz benekli dev kırmızı şapka, altında lameller ve uçuşan sporlar.
wardrobe.item.head_graduation_cap = Mezuniyet Kepi
wardrobe.item.head_graduation_cap.desc = Yürürken sallanan altın püsküllü siyah kep.
wardrobe.item.head_propeller_beanie = Pervaneli Bere
wardrobe.item.head_propeller_beanie.desc = Gökkuşağı bere; koşunca ya da uçunca pervane hızlanır.
wardrobe.item.back_monarch_wings = Monark Kanatları
wardrobe.item.back_monarch_wings.desc = Siyah damarlı turuncu kelebek kanatları, uçarken daha hızlı çırpar.
wardrobe.item.back_teddy_backpack = Ayıcık Sırt Çantası
wardrobe.item.back_teddy_backpack.desc = Omuzlarından patileriyle sarılan pelüş ayıcık.
wardrobe.item.back_turtle_shell = Kaplumbağa Kabuğu
wardrobe.item.back_turtle_shell.desc = Deri kayışlı, pullardan oluşan kubbeli kabuk.
wardrobe.item.back_skateboard = Kaykay
wardrobe.item.back_skateboard.desc = Sırtta çapraz baskılı kaykay; yürürken tekerlekler döner.
wardrobe.item.back_surfboard = Sörf Tahtası
wardrobe.item.back_surfboard.desc = Şeritli, yüzgeçli ve sarkan ipli uzun tahta.
wardrobe.item.back_greatsword_sheath = Sırt Kılıcı
wardrobe.item.back_greatsword_sheath.desc = Demir bağlı kınında dev kılıç; kabzası omzun üstünden çıkar.
wardrobe.item.back_clockwork_key = Kurma Anahtarı
wardrobe.item.back_clockwork_key.desc = Sırtındaki büyük pirinç anahtar, kurulmuşsun gibi döner.
wardrobe.item.back_phoenix_wings = Anka Kanatları
wardrobe.item.back_phoenix_wings.desc = Altından kızıla yanan tüyler; uçarken alev saçar.
wardrobe.item.back_ice_crystal_wings = Buz Kristal Kanatlar
wardrobe.item.back_ice_crystal_wings.desc = Şeffaf buz parçalarından kanatlar; etrafında kar döner.
wardrobe.item.back_flower_basket = Çiçek Sepeti
wardrobe.item.back_flower_basket.desc = Buketli hasır sepet; etrafında küçük bir arı döner.
wardrobe.item.cape_capelet = Viktorya Pelerini
wardrobe.item.cape_capelet.desc = Kat kat fırfırlı, kamealı tokası olan kısa pelerin.
wardrobe.item.cape_journey_scarf = Yolcu Atkısı
wardrobe.item.cape_journey_scarf.desc = Altın glifli, arkanda uzanan sonsuz uzun atkı.
wardrobe.item.cape_ranger_hood = İzci Pelerini
wardrobe.item.cape_ranger_hood.desc = İndirilmiş kapüşonlu, yaprak tokalı, saçaklı etekli orman pelerini.
