wardrobe.item.char_steampunk_mechanic.desc = Gözlük, önlük ve dişlili pirinç protez kol.
wardrobe.item.char_forest_elf = Orman Elfi
wardrobe.item.char_forest_elf.desc = Sivri kulaklar, uzun saç ve yapraklı pelerin.
wardrobe.item.char_demon_berserker = İblis Berserker
wardrobe.item.char_demon_berserker.desc = Boynuzlar, kürk ve parlayan magma çatlakları.
wardrobe.item.char_elemental_lord = Elementlerin Efendisi
wardrobe.item.char_elemental_lord.desc = Ateş, su, toprak ve hava küreleri etrafında döner.
wardrobe.item.char_suit_agent = Takım Elbiseli Ajan
wardrobe.item.char_suit_agent.desc = Siyah takım, güneş gözlüğü ve kulaklık.
wardrobe.item.char_rock_star = Rock Yıldızı
wardrobe.item.char_rock_star.desc = Mohikan, zımbalı ceket ve sırtta gitar.
wardrobe.item.char_mech_pilot = Robot Pilotu
wardrobe.item.char_mech_pilot.desc = Uçuş tulumu, vizörlü kask ve çanta.
wardrobe.item.char_ice_witch = Buz Cadısı
wardrobe.item.char_ice_witch.desc = Buz taç, uzun elbise ve etrafta tipi.
wardrobe.item.char_desert_nomad = Çöl Göçebesi
wardrobe.item.char_desert_nomad.desc = Türban, örtülü yüz ve belde hançer.
wardrobe.item.char_deep_sea_diver = Derin Deniz Dalgıcı
wardrobe.item.char_deep_sea_diver.desc = Lomboz pencereli pirinç kask ve hava kabarcıkları.
wardrobe.item.char_plague_doctor = Veba Doktoru
wardrobe.item.char_plague_doctor.desc = Gagalı maske, şapka ve uğursuz sporlar.
wardrobe.item.char_astronaut = Astronot
wardrobe.item.char_astronaut.desc = Altın vizörlü, yanıp sönen panelli uzay giysisi.
wardrobe.item.char_gladiator = Gladyatör
wardrobe.item.char_gladiator.desc = Sorguçlu bronz miğfer ve deri zırh.
wardrobe.item.char_druid = Druid
wardrobe.item.char_druid.desc = Boynuzlar, ağaç kabuğu ve yosun; etrafta ateşböcekleri.
wardrobe.item.char_clockwork_android = Kurmalı Android
wardrobe.item.char_clockwork_android.desc = Çelik, pirinç ve atan parlak bir kalp.
wardrobe.item.char_abyss_knight = Uçurum Şövalyesi
wardrobe.item.char_abyss_knight.desc = Mor rünlü dikenli zırh ve portal aurası.
wardrobe.item.char_shaolin_monk = Shaolin Rahibi
wardrobe.item.char_shaolin_monk.desc = Turuncu cübbe, tespih ve meditasyon duruşu.
wardrobe.item.weapon_knight_longsword = Haçlı Uzun Kılıcı
wardrobe.item.weapon_knight_longsword.desc = Oluklu, altın siperli uzun kılıç. Şövalye setiyle uyumlu.
wardrobe.item.weapon_cyber_blade = Plazma Kılıç
wardrobe.item.weapon_cyber_blade.desc = Titrek plazma ışını. Siberpunk seti ve Siber Ninja ile uyumlu.
wardrobe.item.weapon_pirate_cutlass = Borda Palası
wardrobe.item.weapon_pirate_cutlass.desc = Pirinç korumalı geniş kavisli bıçak.
wardrobe.item.weapon_frost_brand = Ayaz Kılıcı
wardrobe.item.weapon_frost_brand.desc = Kar taneleri döken kristal kılıç. Buz Cadısı ile uyumlu.
wardrobe.item.weapon_viking_axe = Sakallı Balta
wardrobe.item.weapon_viking_axe.desc = Perçinli kafalı kuzey baltası.
wardrobe.item.weapon_berserker_axe = Berserker Baltası
wardrobe.item.weapon_berserker_axe.desc = Kızgın kenarlı çift ağız. İblis Berserker ile uyumlu.
wardrobe.item.weapon_gear_axe = Dişli Balta
wardrobe.item.weapon_gear_axe.desc = Parlayan çekirdekli pirinç balta.
wardrobe.item.weapon_elven_hatchet = Elf Nacağı
wardrobe.item.weapon_elven_hatchet.desc = Yaprak biçimli hafif nacak.
wardrobe.item.weapon_magma_axe = Magma Baltası
wardrobe.item.weapon_magma_axe.desc = Ateşli kenarlı soğuyan lav; kor bırakır.
wardrobe.item.weapon_elven_longbow = Elf Uzun Yayı
wardrobe.item.weapon_elven_longbow.desc = Açık ağaç ve parlayan kiriş.
wardrobe.item.weapon_hunter_recurve = Avcı Yayı
wardrobe.item.weapon_hunter_recurve.desc = Kıvrık kollu sağlam yay.
wardrobe.item.weapon_crystal_bow = Kristal Yay
wardrobe.item.weapon_crystal_bow.desc = Şeffaf kollar ve yıldızlı ok izi.
wardrobe.item.weapon_dragon_bow = Ejderha Yayı
wardrobe.item.weapon_dragon_bow.desc = Ejderha dikenli yay; oklar alev bırakır.
wardrobe.item.weapon_cyber_bow = Neon Yay
wardrobe.item.weapon_cyber_bow.desc = Neon kirişli kompozit yay.
wardrobe.item.weapon_paladin_hammer = Paladin Çekici
wardrobe.item.weapon_paladin_hammer.desc = Kutsanmış savaş çekici. Paladin ile uyumlu.
wardrobe.item.weapon_morning_star = Sabah Yıldızı
wardrobe.item.weapon_morning_star.desc = Meşe sapta dikenli baş.
wardrobe.item.weapon_crystal_scepter = Kristal Asa
wardrobe.item.weapon_crystal_scepter.desc = Ametist yüzlü gümüş asa.
wardrobe.item.weapon_skull_mace = Kafatası Topuz
