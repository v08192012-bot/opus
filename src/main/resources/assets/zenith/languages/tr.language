wardrobe.item.weapon_wanderer_katana.desc = Parlak kenarlı kavisli bir bıçak. Darbeler yaprak girdabı bırakır.
wardrobe.item.pet_mini_dragon = Mini Ejderha
wardrobe.item.pet_mini_dragon.desc = Omzunun yanında süzülür, duman halkaları üfler.
wardrobe.item.pet_firefly_spirit = Ateşböceği Ruhu
wardrobe.item.pet_firefly_spirit.desc = Karanlıkta parlar, küçük ışıklarla dans eder.
wardrobe.item.pet_robot_ball = Robot Top
wardrobe.item.pet_robot_ball.desc = Peşinden zıplar, kıvılcımlı ışınla etrafı tarar.
wardrobe.item.pet_ghost_cat = Hayalet Kedi
wardrobe.item.pet_ghost_cat.desc = Yarı saydam, mırlar ve bazen havada kaybolur.
wardrobe.item.pet_crystal_turtle = Kristal Kaplumbağa
wardrobe.item.pet_crystal_turtle.desc = Tehlike yakınken parlayan kabuğuna saklanır.
wardrobe.item.pet_cloud_sheep = Bulut Kuzu
wardrobe.item.pet_cloud_sheep.desc = Havada süzülür, bazen minik bir yağmur yağdırır.
wardrobe.item.pet_mushroom_buddy = Mantar Dostu
wardrobe.item.pet_mushroom_buddy.desc = Yanında tıpışlar, eğilip sporlar saçar.
wardrobe.item.pet_mech_owl = Mekanik Baykuş
wardrobe.item.pet_mech_owl.desc = Mercek gözlü pirinç baykuş, başını tam tur çevirir.
wardrobe.item.pet_slime = Balçıkçık
wardrobe.item.pet_slime.desc = Zıp zıp bir top; bazen çok yükseğe sıçrar.
wardrobe.item.pet_shadow_raven = Gölge Kuzgun
wardrobe.item.pet_shadow_raven.desc = Geride kalır, sonra gölge bulutunda yanında belirir.
wardrobe.item.pet_sea_octopus = Deniz Ahtapotu
wardrobe.item.pet_sea_octopus.desc = Kabarcık üfler, sen yaralanınca mürekkep püskürtür.
wardrobe.item.pet_star_bunny = Yıldız Tavşan
wardrobe.item.pet_star_bunny.desc = Kayan yıldızları yakalar, parlak iz bırakır.
wardrobe.item.pet_golem_pup = Yavru Golem
wardrobe.item.pet_golem_pup.desc = Rünlü küçük golem; bazen sana çiçek uzatır.
wardrobe.item.pet_pumpkin_lantern = Balkabağı Feneri
wardrobe.item.pet_pumpkin_lantern.desc = Zıplayarak gelir, içten parlar, ürkütücü sırıtır.
