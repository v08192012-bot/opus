module.crystalaura.description = Kristalleri ve doğma çapalarını koyar ve patlatır: zırh, büyüler ve zorlukla vanilla ile aynı hasar hesabı, hedef hareket tahmini, ön ayardaki antihileye göre zamanlama
module.crystalAura.preset = Ön ayar
module.crystalAura.preset.desc = Sunucunun antihilesine hazır ayarlar, Özel tüm parametreleri açar
module.crystalAura.presetCustom = Özel
module.crystalAura.presetNone = Antihile yok
