module.crystalAura.maxSelfDamage = Maks. kendine hasar
module.crystalAura.maxSelfDamage.desc = Öldürmediği sürece bundan fazla kendine hasara izin verilmez
module.crystalAura.faceplace = Bitirme
module.crystalAura.faceplace.desc = Hedefin canı bu değerdeyken minimum hasar 2'ye düşer
module.crystalAura.predictTicks = Tahmin tikleri
module.crystalAura.predictTicks.desc = Hedef hareketinin kaç tik ileri tahmin edileceği, ping otomatik eklenir
